---
import HeroMedia from './HeroMedia.astro'
import ScrollHint from './ScrollHint.astro'

interface Props {
  groom: string
  bride: string
  date: string
  city?: string
  heroPhoto?: string
  heroVideo?: string
}
const { groom, bride, date, city, heroPhoto, heroVideo } = Astro.props

// звёзды раскиданы псевдослучайно, но с фиксированным зерном — одинаково при каждой сборке
let seed = 7
const rand = () => (seed = (seed * 16807) % 2147483647) / 2147483647
const stars = Array.from({ length: 46 }, () => ({
  x: (rand() * 100).toFixed(1),
  y: (rand() * 62).toFixed(1),
  s: (1 + rand() * 2.2).toFixed(1),
  d: (rand() * 4).toFixed(2),
}))
const bursts = [
  { x: 14, y: 62, c: '#f0c76e', delay: 0.4, size: 1 },
  { x: 86, y: 56, c: '#f5b9cf', delay: 1.6, size: 1.1 },
  { x: 72, y: 74, c: '#bcd4ff', delay: 2.8, size: 0.8 },
  { x: 26, y: 78, c: '#f5b9cf', delay: 3.9, size: 0.75 },
]
const windows = [
  [195, 128],
[201, 128],
[195, 160],
[201, 160],
[140, 168],
[254, 168],
[97, 186],
[299, 186],
[176, 200],
[220, 200],
]
---

<header class="hero-ft">
  <div class="ft-sky" aria-hidden="true">
    {stars.map(s => <i style={`--x:${s.x}%;--y:${s.y}%;--s:${s.s}px;--d:${s.d}s`} />)}
    <span class="ft-moon"></span>
    <span class="ft-comet"></span>
    {bursts.map(b => (
      <span class="ft-burst" style={`--x:${b.x}%;--y:${b.y}%;--c:${b.c};--delay:${b.delay}s;--k:${b.size}`}>
        {Array.from({ length: 12 }, (_, i) => <i style={`--r:${i * 30}deg`} />)}
      </span>
    ))}
  </div>

  {/* замок нарисован с нуля: силуэт башен, флажки, тёплые окна */}
  <svg class="ft-castle" viewBox="0 0 400 260" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
    <defs>
      <linearGradient id="ft-stone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#2a2d66" />
        <stop offset="1" stop-color="#0d0f2b" />
      </linearGradient>
      <linearGradient id="ft-roof" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3a3478" />
        <stop offset="1" stop-color="#1c1b4a" />
      </linearGradient>
    </defs>
    <g class="ft-flags" fill="#f0c76e">
      <path d="M200 12v20M200 12l14 4-14 4" stroke="#f0c76e" stroke-width="1.2" fill-opacity="0.9" />
      <path d="M143 64v16M143 64l10 3-10 3" stroke="#f0c76e" stroke-width="1" />
      <path d="M257 64v16M257 64l10 3-10 3" stroke="#f0c76e" stroke-width="1" />
    </g>
    <g fill="url(#ft-roof)">
      <path d="M200 30 236 112H164Z" />
      <path d="M143 80 165 142H121Z" />
      <path d="M257 80 279 142H235Z" />
      <path d="M100 124 118 168H82Z" />
      <path d="M300 124 318 168H282Z" />
      <path d="M176 92 186 116H166ZM224 92 234 116H214Z" />
    </g>
    <g fill="url(#ft-stone)">
      <rect x="170" y="110" width="60" height="120" />
      <rect x="166" y="114" width="20" height="40" />
      <rect x="214" y="114" width="20" height="40" />
      <rect x="128" y="140" width="30" height="90" />
      <rect x="242" y="140" width="30" height="90" />
      <rect x="87" y="166" width="26" height="64" />
      <rect x="287" y="166" width="26" height="64" />
      <path d="M100 186h200v44H100Z" />
      <path d="M100 186v-8h10v8h10v-8h10v8h10v-8h10v8h10v-8h10v8m60 0v-8h10v8h10v-8h10v8h10v-8h10v8h10v-8h10v8" />
    </g>
    <path class="ft-gate" d="M188 230v-22a12 12 0 0 1 24 0v22Z" fill="#f0c76e" fill-opacity="0.22" />
    <g class="ft-windows" fill="#ffd98a">
      {windows.map(([x, y], i) => <path d={`M${x} ${y + 9}v-6a2.5 2.5 0 0 1 5 0v6Z`} style={`--w:${i}`} />)}
    </g>
  </svg>

  <div class="ft-ground" aria-hidden="true"></div>

  <div class="ft-content">
    <p class="ft-once">Жили-были</p>
    <h1>
      <span class="ft-name">{groom}</span>
      <span class="ft-amp">и</span>
      <span class="ft-name">{bride}</span>
    </h1>
    {(heroPhoto || heroVideo) && (
      <div class="ft-mirror">
        <HeroMedia photo={heroPhoto} video={heroVideo} />
      </div>
    )}
    <p class="ft-tale">…и решили жить долго и счастливо</p>
    <p class="ft-date">{date}{city && ` · ${city}`}</p>
    <ScrollHint />
  </div>
</header>

<style>
  .hero-ft {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: start;
    justify-items: center;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(52px, 8svh, 84px) 24px clamp(140px, 24svh, 260px);
    text-align: center;
    color: var(--text);
    background:
      radial-gradient(90% 45% at 50% 100%, rgba(245, 185, 207, 0.28), transparent 70%),
      radial-gradient(70% 40% at 15% 10%, rgba(120, 110, 220, 0.25), transparent 70%),
      linear-gradient(to bottom, #0b0e2a, #171a46 55%, #2c2462);
  }

  .ft-sky { position: absolute; inset: 0; z-index: -2; pointer-events: none; }
  .ft-sky > i {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: #fff8e6;
    box-shadow: 0 0 6px rgba(255, 240, 200, 0.8);
    animation: ft-twinkle 3.4s ease-in-out var(--d) infinite alternate;
  }
  @keyframes ft-twinkle {
    from { opacity: 0.25; transform: scale(0.7); }
    to { opacity: 1; transform: scale(1); }
  }

  .ft-moon {
    position: absolute;
    top: clamp(28px, 6vh, 56px);
    right: clamp(24px, 9vw, 120px);
    width: 54px;
    height: 54px;
    border-radius: 50%;
    /* полумесяц: тень того же цвета, что небо, срезает диск */
    box-shadow: inset -14px 6px 0 0 #f6e3b0;
    filter: drop-shadow(0 0 16px rgba(246, 227, 176, 0.55));
    transform: rotate(-18deg);
  }

  .ft-comet {
    position: absolute;
    top: 14%;
    left: 70%;
    width: 120px;
    height: 1.5px;
    background: linear-gradient(to left, #fff8e6, transparent);
    border-radius: 2px;
    opacity: 0;
    transform: rotate(-24deg);
    animation: ft-comet 9s ease-in 2.5s infinite;
  }
  @keyframes ft-comet {
    0% { opacity: 0; translate: 0 0; }
    3% { opacity: 1; }
    10% { opacity: 0; translate: -260px 116px; }
    100% { opacity: 0; translate: -260px 116px; }
  }

  /* салют: двенадцать лучей разлетаются из точки и гаснут */
  .ft-burst {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
    scale: var(--k);
  }
  .ft-burst i {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 30px;
    border-radius: 2px;
    background: linear-gradient(to top, var(--c), transparent);
    transform-origin: 50% 0;
    rotate: var(--r);
    opacity: 0;
    animation: ft-ray 5s var(--ease-out) var(--delay) infinite;
  }
  @keyframes ft-ray {
    0% { opacity: 0; transform: translateY(0) scaleY(0.2); }
    4% { opacity: 1; }
    22% { opacity: 0; transform: translateY(64px) scaleY(1); }
    100% { opacity: 0; transform: translateY(64px) scaleY(1); }
  }

  .ft-castle {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: -1;
    width: min(150vw, 960px);
    height: 32svh;
    translate: -50% 0;
    filter: drop-shadow(0 -6px 30px rgba(245, 185, 207, 0.18));
  }
  /* холм — отдельным слоем: тянется на всю ширину, даже когда замок вписан по высоте */
  .ft-ground {
    position: absolute;
    left: -15%;
    right: -15%;
    bottom: 0;
    z-index: -1;
    height: 6.5svh;
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    background: linear-gradient(to bottom, #1a1c4e, #0d0f2b);
  }
  .ft-windows path { animation: ft-window 4s ease-in-out calc(var(--w) * -0.7s) infinite alternate; }
  @keyframes ft-window {
    from { opacity: 0.55; }
    to { opacity: 1; }
  }
  .ft-flags path { transform-box: fill-box; transform-origin: left center; animation: ft-flag 2.4s ease-in-out infinite alternate; }
  @keyframes ft-flag {
    from { transform: skewY(0deg); }
    to { transform: skewY(-8deg); }
  }

  .ft-content { position: relative; display: grid; justify-items: center; gap: 12px; }
  .ft-content > * { animation: ft-rise 1.2s var(--ease-out) both; }
  .ft-content > :nth-child(1) { animation-delay: 0.2s; }
  .ft-content > :nth-child(2) { animation-delay: 0.45s; }
  .ft-content > :nth-child(3) { animation-delay: 0.7s; }
  .ft-content > :nth-child(4) { animation-delay: 0.9s; }
  .ft-content > :nth-child(5) { animation-delay: 1.1s; }
  @keyframes ft-rise {
    from { opacity: 0; transform: translateY(18px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  .ft-once {
    font-family: var(--font-accent);
    font-size: clamp(1.6rem, 6.4vw, 2.3rem);
    color: var(--accent);
    text-shadow: 0 0 18px rgba(240, 199, 110, 0.45);
  }
  h1 {
    display: grid;
    justify-items: center;
    font-size: min(clamp(2.4rem, 10.5vw, 4.4rem), 8svh);
    line-height: 1.04;
    letter-spacing: 0.01em;
    text-shadow: 0 2px 24px rgba(10, 8, 40, 0.6);
  }
  .ft-amp {
    font-family: var(--font-accent);
    font-size: 0.55em;
    line-height: 1.2;
    color: var(--accent-2);
  }

  /* волшебное зеркальце: овал в золотой оправе */
  .ft-mirror {
    width: min(30vw, 15svh, 150px);
    aspect-ratio: 4 / 5;
    padding: 4px;
    border-radius: 50%;
    background: linear-gradient(160deg, #fbe3a1, #b98d3c 45%, #f6d58c 70%, #9c7432);
    box-shadow: 0 0 0 1px rgba(240, 199, 110, 0.35), 0 0 40px rgba(240, 199, 110, 0.3);
  }
  .ft-mirror :global(img),
  .ft-mirror :global(video) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .ft-tale {
    font-family: var(--font-display);
    font-size: clamp(1rem, 3.8vw, 1.2rem);
    color: var(--text-2);
  }
  .ft-date {
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
  }

  /* низкий экран: без подсказки и присказки, иначе замок уходит за край */
  @media (max-height: 800px) {
    .ft-tale { display: none; }
    .ft-content :global(.scroll-hint) { display: none; }
  }
  /* телефон лёжа: текст слева, замок справа */
  @media (orientation: landscape) and (max-height: 500px) {
    .hero-ft { align-items: center; justify-items: start; padding: 24px max(32px, env(safe-area-inset-left)); }
    .ft-content { width: 54vw; gap: 8px; }
    .ft-mirror { display: none; }
    .ft-tale { display: block; }
    h1 { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; column-gap: 0.25em; font-size: clamp(2rem, 13svh, 3rem); }
    .ft-castle { left: auto; right: -2%; translate: none; width: 46vw; height: 74svh; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ft-content > *, .ft-sky > i, .ft-windows path, .ft-flags path { animation: none; }
    .ft-comet, .ft-burst { display: none; }
  }
</style>
