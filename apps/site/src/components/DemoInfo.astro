---
import { orderUrl, prices, rub } from '../site';

// поп-ап демо: что меняется в шаблоне и сколько стоит; оформляется токенами текущей темы
interface Props {
  slug: string;
  theme: string;
  themeName: string;
}
const { slug, theme, themeName } = Astro.props;

const editable = [
  'Все фото и тексты, видео и музыку',
  'Программу дня',
  'Площадку и карту',
  'Цвета дресс-кода и образы',
  'Детали и пожелания',
  'Вопросы в анкете гостя — добавить или убрать',
];
---

<dialog class="demo-info" data-slug={slug} aria-labelledby="demo-info-title">
  <div class="plate">
    <div class="plate-inner demo-info-body" tabindex="-1" autofocus>
      <button type="button" class="demo-info-close" data-close-demo-info aria-label="Закрыть">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
      </button>

      <p class="demo-info-kicker">Демо «{themeName}»</p>
      <h2 id="demo-info-title">Частые вопросы</h2>

      <h3>Что можно изменить?</h3>
      <ul class="demo-info-list">
        {editable.map((item) => <li>{item}</li>)}
      </ul>
      <p class="demo-info-warn">Шрифты в шаблоне не меняются — они часть дизайна</p>

      <dl class="demo-info-prices">
        <div><dt>Шаблон</dt><dd>{rub(prices.template)}</dd></div>
        <div><dt>Именные ссылки</dt><dd>{rub(prices.named)}<small>/гость</small></dd></div>
      </dl>

      <p class="demo-info-more">
        <strong>Что можно ещё добавить?</strong>
        Смотрите в разделе <a href="/#faq">Вопросы и ответы</a>
      </p>

      <div class="demo-info-actions">
        <button type="button" class="btn btn--block" data-close-demo-info>
          Смотреть демо
          <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
        </button>
        <a class="demo-info-order" href={orderUrl(themeName)} target="_blank" rel="noopener" data-lead data-lead-source="demo-popup" data-lead-product="template" data-lead-theme={theme}>Заказать этот дизайн →</a>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.demo-info');
  if (dialog) {
    const seenKey = `demo-info:${dialog.dataset.slug}`;
    // Stories ставит автопролистывание на паузу, пока открыт любой диалог
    const announce = () => document.dispatchEvent(new CustomEvent('overlay'));
    const open = () => {
      if (dialog.open) return;
      dialog.showModal();
      announce();
    };

    dialog.querySelectorAll('[data-close-demo-info]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => announce());
    document.querySelectorAll('[data-open-demo-info]').forEach((b) => b.addEventListener('click', open));

    // сам открывается при первом заходе в демо за сессию; по личной ссылке ?g= сначала показываем имя гостя
    let seen = false;
    try {
      seen = sessionStorage.getItem(seenKey) === '1';
      sessionStorage.setItem(seenKey, '1');
    } catch {}
    if (!seen && !new URLSearchParams(location.search).has('g')) setTimeout(open, 900);
  }
</script>

<style>
  .demo-info {
    width: min(100% - 32px, 440px);
    max-height: calc(100dvh - 32px);
    padding: 0;
    margin: auto;
    border: 0;
    background: transparent;
    color: var(--text);
    overflow: visible;
    opacity: 0;
    transform: translateY(16px) scale(0.97);
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease),
      overlay 0.6s allow-discrete,
      display 0.6s allow-discrete;
  }
  .demo-info[open] { opacity: 1; transform: none; }
  @starting-style {
    .demo-info[open] { opacity: 0; transform: translateY(16px) scale(0.97); }
  }
  .demo-info::backdrop {
    background: color-mix(in srgb, #0d0b09 55%, transparent);
    opacity: 0;
    transition: opacity 0.45s var(--ease), overlay 0.45s allow-discrete, display 0.45s allow-discrete;
  }
  .demo-info[open]::backdrop { opacity: 1; }
  @starting-style {
    .demo-info[open]::backdrop { opacity: 0; }
  }

  .demo-info-body {
    position: relative;
    max-height: calc(100dvh - 46px);
    overflow-y: auto;
    overscroll-behavior: contain;
    display: grid;
    gap: 0;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.55;
  }
  .demo-info-body:focus { outline: none; }

  .demo-info-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .demo-info-close:hover { background: color-mix(in srgb, var(--text) 6%, transparent); transform: rotate(90deg); }
  .demo-info-close svg { width: 14px; height: 14px; }

  .demo-info-kicker {
    margin: 0 48px 6px 0;
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .demo-info h2 {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 8vw, 2.4rem);
    line-height: 1.05;
    color: var(--accent);
  }
  .demo-info h3 {
    margin: 0 0 10px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1rem;
    color: var(--text);
  }

  .demo-info-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; color: var(--text-2); }
  .demo-info-list li { position: relative; padding-left: 22px; }
  .demo-info-list li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.75;
  }
  .demo-info-warn {
    margin: 12px 0 0;
    padding: 10px 14px;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--text);
    font-size: 0.88rem;
  }

  .demo-info-prices {
    margin: 22px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .demo-info-prices div { padding: 14px 0; display: grid; gap: 2px; }
  .demo-info-prices div + div { padding-left: 18px; border-left: 1px solid var(--line); }
  .demo-info-prices dt {
    font-family: var(--font-label);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .demo-info-prices dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.55rem;
    line-height: 1.2;
    color: var(--text);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .demo-info-prices small { font-family: var(--font-body); font-size: 0.8rem; color: var(--muted); margin-left: 2px; }

  .demo-info-more { margin: 18px 0 0; display: grid; gap: 2px; color: var(--text-2); font-size: 0.95rem; }
  .demo-info-more strong { color: var(--text); }
  .demo-info-more a { color: var(--accent); text-underline-offset: 3px; }

  .demo-info-actions { margin-top: 24px; display: grid; gap: 6px; justify-items: center; }
  .demo-info-order {
    padding: 10px 4px;
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    text-decoration: none;
    transition: color 0.3s;
  }
  .demo-info-order:hover { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .demo-info, .demo-info[open] { transform: none; }
  }
</style>
