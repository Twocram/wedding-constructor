---
// порядок импортов = порядок CSS в сборке: базовые стили раньше компонентов и тем
/* eslint-disable perfectionist/sort-imports */
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
import LeadForm from '../components/LeadForm.astro'
import { leadFormEnabled, messageUrl, orderUrl, prices, rub, themes } from '../site'

const order = Object.keys(themes)
const invitations = (await getCollection('invitations')).filter(inv => inv.data.demo).sort(
  (a, b) => order.indexOf(a.data.theme) - order.indexOf(b.data.theme),
)

const features = [
  { title: 'Личное обращение', text: 'У каждого гостя своя ссылка — он увидит в приглашении своё имя', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0' },
  { title: 'Анкета гостя', text: 'Ответы «приду / не приду» сразу прилетают вам в Telegram', icon: 'M4 5h16v11H8l-4 4zM8 10h8M8 13h5' },
  { title: 'Карта и маршрут', text: 'Яндекс.Карта площадки и кнопка «Построить маршрут»', icon: 'M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z' },
  { title: 'Таймер и календарь', text: 'Обратный отсчёт и «Добавить в календарь» с напоминанием за день', icon: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4' },
  { title: 'Программа и дресс-код', text: 'Тайминг дня и палитра оттенков, чтобы гости выглядели как на одной фотографии', icon: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z' },
  { title: 'Музыка и фото', text: 'Ваша песня по кнопке и галерея истории пары', icon: 'M9 18V5l11-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM20 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z' },
]

const namedPoints = [
  'Обращение по имени прямо на первом экране',
  'Имя гостя уже вписано в анкету — вы точно знаете, кто ответил',
  'Пары и семьи — одной ссылкой: «Анна и Дмитрий»',
  'Рассылка в один клик: Telegram или WhatsApp',
]
const namedDefault = 'Анна и Дмитрий'

const customPoints = ['Свои шрифты и палитра', 'Структура и разделы под вашу идею', 'Иллюстрации и анимации']
const occasions = ['День рождения', 'Юбилей', 'Корпоратив', 'Детский праздник', 'Выпускной', 'Новоселье', 'Девичник', 'Крестины']
const customUrl = messageUrl('Здравствуйте! Хочу приглашение с индивидуальным дизайном')

const plans = [
  {
    name: 'Шаблон',
    price: prices.template,
    lead: 'Любой дизайн из каталога, собранный под вашу пару',
    points: ['Ваши тексты, фото, видео и музыка', 'Программа дня, карта и дресс-код', 'Анкета гостя с ответами в Telegram', 'Таймер и «Добавить в календарь»', 'Готово за 1–2 дня'],
    cta: 'Выбрать дизайн',
    href: '#themes',
  },
  {
    name: 'Индивидуальный дизайн',
    price: prices.custom,
    lead: 'Уникальное приглашение с нуля — свадьба или любой праздник',
    points: ['Всё, что входит в шаблон', 'Дизайн под вашу идею и стиль', 'Любые шрифты, цвета и структура', 'День рождения, юбилей, корпоратив — любое событие'],
    cta: 'Обсудить идею',
    href: customUrl,
    leadAttrs: { 'data-lead': '', 'data-lead-source': 'prices', 'data-lead-product': 'custom' },
    featured: true,
  },
]
const namedCount = 20

const faq = [
  {
    q: 'Что можно изменить в шаблоне?',
    a: ['Все фото и тексты, видео и музыку, программу дня, площадку и карту, цвета дресс-кода и образы, детали и вопросы в анкете гостя — это входит в стоимость.', 'Шрифты в шаблоне не меняются — они часть дизайна. В индивидуальном дизайне подберём любые.'],
  },
  {
    q: 'Что можно добавить?',
    a: ['Музыку по кнопке, видео на первом экране, галерею ваших фото, подборку образов к дресс-коду, вопросы в анкете — напитки, «приду с парой», аллергии. А ещё чат гостей в Telegram, трансфер, контакты организатора и пожелания по цветам и подаркам.', 'Не нашли нужного раздела — напишите, обсудим.'],
  },
  {
    q: 'Что такое именные ссылки?',
    a: [`Для каждого гостя делаем свою ссылку: он откроет приглашение и увидит обращение по имени, а в анкете его имя уже будет вписано. Стоимость — ${rub(prices.named)} за ссылку, пару или семью можно пригласить одной.`],
  },
  {
    q: 'Как гости отвечают на анкету?',
    a: ['Гость отмечает «приду / не смогу», пишет пожелания — и ответ сразу приходит вам в Telegram. Гостям не нужно ничего устанавливать или регистрироваться.'],
  },
  {
    q: 'Сколько времени занимает?',
    a: ['Приглашение по шаблону готово за 1–2 дня после того, как вы пришлёте данные. Срок индивидуального дизайна зависит от задачи — назовём его до начала работы.'],
  },
  {
    q: 'Делаете приглашения не на свадьбу?',
    a: ['Да. Под индивидуальный заказ делаем приглашения на день рождения, юбилей, корпоратив, детский праздник, выпускной и любое другое событие.'],
  },
]

const steps = [
  { title: 'Выберите дизайн', text: 'Откройте демо с телефона — так его увидят гости.' },
  { title: 'Пришлите данные', text: 'Имена, дату, площадку, программу и пару фотографий.' },
  { title: 'Получите ссылку', text: 'Готовое приглашение за 1–2 дня. Рассылаете гостям в мессенджерах.' },
];
---

<Base title="Wedding Constructor — онлайн-приглашения на свадьбу" description="Онлайн-приглашения на свадьбу: семь дизайнов, анкета гостя с ответами в Telegram, карта, программа дня и дресс-код. Готово за 1–2 дня.">
  <main class="shop">
    <header class="shop-hero">
      <div class="wrap">
        <p class="eyebrow fade-up">Wedding Constructor</p>
        <h1 class="fade-up" style="--i:1">Приглашение на свадьбу, которое <em>хочется открыть</em></h1>
        <p class="shop-sub fade-up" style="--i:2">Одна ссылка вместо бумажных открыток: дата, место, программа, дресс-код и анкета гостя. Красиво на любом телефоне.</p>
        <div class="shop-ctas fade-up" style="--i:3">
          <a class="btn" href="#themes">Выбрать дизайн <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M8 3v10M4 9l4 4 4-4" /></svg></span></a>
          <a class="btn btn--ghost" href={orderUrl()} target="_blank" rel="noopener" data-lead data-lead-source="hero">Написать нам <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 12 12 4M6 4h6v6" /></svg></span></a>
        </div>
        <ul class="shop-proof fade-up" style="--i:4">
          <li>Готово за 1–2 дня</li>
          <li>Ответы гостей в Telegram</li>
          <li>Без приложений и регистрации</li>
          <li>Таймер до свадьбы — уже внутри, а не за +500 ₽</li>
          <li>Шаблон — {rub(prices.template)}</li>
        </ul>
      </div>
    </header>

    <section class="shop-block" id="themes" aria-labelledby="themes-title">
      <div class="shop-wide">
        <div class="shop-head">
          <p class="eyebrow">Каталог</p>
          <h2 id="themes-title">Выберите свой стиль</h2>
          <p>Нажмите на карточку — откроется живое демо с примером пары.</p>
          <p class="shop-note">Любые тексты, фото и цвета дресс-кода меняем под вашу пару — это входит в стоимость. Живой таймер обратного отсчёта до свадьбы вы тоже получаете вместе с приглашением — без доплат</p>
        </div>
        <ul class="themes">
          {invitations.map((inv, i) => {
            const t = themes[inv.data.theme]
            return (
              <li class="theme fade-up" style={`--i:${i % 3}`}>
                <a class="theme-phone" href={`/${inv.id}`} aria-label={`Демо ${t.name}: ${inv.data.groom} и ${inv.data.bride}`}>
                  {t.isNew && <span class="theme-new">New</span>}
                  <img src={`/previews/${inv.id}.webp`} alt="" width="600" height="1298" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                </a>
                <div class="theme-info">
                  <div class="theme-tags">{t.tags.map(tag => <span>{tag}</span>)}</div>
                  <h3>{t.name}</h3>
                  <p>{t.tagline}</p>
                  <div class="theme-actions">
                    <a class="theme-link" href={`/${inv.id}`}>Смотреть демо</a>
                    <a class="theme-link theme-link--accent" href={orderUrl(t.name)} target="_blank" rel="noopener" data-lead data-lead-source="catalog-card" data-lead-product="template" data-lead-theme={inv.data.theme}>Заказать →</a>
                  </div>
                </div>
              </li>
            )
          })}
        </ul>
      </div>
    </section>

    <section class="shop-block shop-block--surface" aria-labelledby="features-title">
      <div class="shop-wide">
        <div class="shop-head">
          <p class="eyebrow">Во всех дизайнах</p>
          <h2 id="features-title">Всё, что нужно гостям</h2>
        </div>
        <ul class="features">
          {features.map((f, i) => (
            <li class="fade-up" style={`--i:${i % 3}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={f.icon} /></svg>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="shop-block" id="named" aria-labelledby="named-title">
      <div class="shop-wide named">
        <div class="named-copy">
          <p class="eyebrow">Именные ссылки</p>
          <h2 id="named-title">Каждый гость — <em>по&nbsp;имени</em></h2>
          <p class="named-lead">Для каждого гостя — своя ссылка. Открыв её, он увидит приглашение, обращённое лично к нему.</p>
          <ul class="named-points">
            {namedPoints.map(p => <li>{p}</li>)}
          </ul>
          <p class="named-price"><b>+{rub(prices.named)}</b> за гостя</p>
        </div>

        <div class="named-try fade-up" data-named-try>
          <div class="named-card" aria-hidden="true">
            <img src="/photos/forest.jpg" alt="" loading="lazy" decoding="async" />
            <div class="named-card-in">
              <p class="named-card-label"><span data-named-preview>{namedDefault}</span>, приглашение для вас</p>
              <p class="named-card-names">Сергей <i>&</i> Олеся</p>
              <span class="named-card-seal">С<i>&</i>О</span>
            </div>
          </div>
          <form class="named-form" action="/demo" target="_blank">
            <label class="field">
              <span>Впишите имя гостя</span>
              <input name="g" type="text" value={namedDefault} maxlength="60" autocomplete="off" required />
            </label>
            <button type="submit" class="btn btn--block">
              Открыть как гость
              <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 12 12 4M6 4h6v6" /></svg></span>
            </button>
          </form>
          <a class="named-guests" href="/demo/guests" target="_blank" rel="noopener">Как пара получает список ссылок →</a>
        </div>
      </div>
    </section>

    <section class="shop-custom" id="custom" aria-labelledby="custom-title">
      <div class="shop-wide custom">
        <div class="custom-main">
          <p class="eyebrow">Индивидуальный дизайн</p>
          <h2 id="custom-title" class="fade-up">Приглашение, которого <em>нет в&nbsp;каталоге</em></h2>
          <p class="fade-up" style="--i:1">Создадим дизайн с нуля под вашу идею — когда хочется полностью уникальное приглашение или стиль праздника уже продуман до мелочей.</p>
          <ul class="custom-points fade-up" style="--i:2">
            {customPoints.map(p => <li>{p}</li>)}
          </ul>
        </div>
        <div class="custom-side fade-up" style="--i:1">
          <h3>Не только свадьбы</h3>
          <p>Под индивидуальный заказ делаем приглашения на любые события:</p>
          <ul class="occasions">
            {occasions.map(o => <li>{o}</li>)}
            <li class="occasions-more">и ваш праздник</li>
          </ul>
          <a class="btn" href={customUrl} target="_blank" rel="noopener" data-lead data-lead-source="custom-block" data-lead-product="custom">Обсудить идею <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 12 12 4M6 4h6v6" /></svg></span></a>
        </div>
      </div>
    </section>

    <section class="shop-block" id="prices" aria-labelledby="prices-title">
      <div class="shop-wide">
        <div class="shop-head">
          <p class="eyebrow">Цены</p>
          <h2 id="prices-title">Честно и без доплат</h2>
          <p>Правки текстов, фото и цветов дресс-кода, таймер и анкета уже входят в стоимость.</p>
        </div>
        <ul class="plans">
          {plans.map((plan, i) => (
            <li class:list={['plan fade-up', { 'plan--featured': plan.featured }]} style={`--i:${i}`}>
              <h3>{plan.name}</h3>
              <p class="plan-price">{rub(plan.price)}</p>
              <p class="plan-lead">{plan.lead}</p>
              <ul class="plan-points">
                {plan.points.map(p => <li>{p}</li>)}
              </ul>
              <a
                class:list={['btn btn--block', { 'btn--ghost': !plan.featured }]}
                href={plan.href}
                {...plan.leadAttrs}
                {...(plan.href.startsWith('#') ? {} : { target: '_blank', rel: 'noopener' })}
              >
                {plan.cta}
                <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
              </a>
            </li>
          ))}
        </ul>

        <div class="addon fade-up" data-calc data-base={prices.template} data-unit={prices.named}>
          <div class="addon-info">
            <h3>Именные ссылки</h3>
            <p><b>+{rub(prices.named)}</b> за каждого гостя с личной ссылкой</p>
          </div>
          <div class="addon-calc">
            <span class="addon-label" id="calc-label">Гостей</span>
            <div class="stepper" role="group" aria-labelledby="calc-label">
              <button type="button" data-step="-5" aria-label="Минус 5 гостей">−</button>
              <input id="calc-guests" type="number" inputmode="numeric" min="0" max="300" value={namedCount} aria-labelledby="calc-label" />
              <button type="button" data-step="5" aria-label="Плюс 5 гостей">+</button>
            </div>
          </div>
          <p class="addon-total" aria-live="polite">
            <small>Шаблон + <span data-calc-count>{namedCount}</span> именных</small>
            <b data-calc-total>{rub(prices.template + namedCount * prices.named)}</b>
            <a class="addon-cta" href={orderUrl()} target="_blank" rel="noopener" data-lead data-lead-source="prices" data-lead-product="template" data-lead-named-from="#calc-guests">Оставить заявку →</a>
          </p>
        </div>
      </div>
    </section>

    <section class="shop-block shop-block--surface" aria-labelledby="steps-title">
      <div class="shop-wide">
        <div class="shop-head">
          <p class="eyebrow">Как заказать</p>
          <h2 id="steps-title">Три шага</h2>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="fade-up" style={`--i:${i}`}>
              <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="shop-block" id="faq" aria-labelledby="faq-title">
      <div class="shop-wide">
        <div class="shop-head">
          <p class="eyebrow">FAQ</p>
          <h2 id="faq-title">Вопросы и ответы</h2>
        </div>
        <div class="faq">
          {faq.map((item, i) => (
            <details name="faq" open={i === 0}>
              <summary>{item.q}<span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-a">{item.a.map(t => <p>{t}</p>)}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="shop-final">
      <div class="wrap">
        <h2 class="fade-up">Выбрали дизайн?</h2>
        <p class="fade-up" style="--i:1">Напишите нам — ответим на вопросы и соберём приглашение под вашу пару.</p>
        <a class="btn fade-up" style="--i:2" href={orderUrl()} target="_blank" rel="noopener" data-lead data-lead-source="final-cta">Заказать приглашение <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 12 12 4M6 4h6v6" /></svg></span></a>
      </div>
    </section>
  </main>
  <footer class="shop-foot">
    <span>© {new Date().getFullYear()} saywed.ru</span>
    {leadFormEnabled && <a href="/privacy">Политика конфиденциальности</a>}
  </footer>
  {leadFormEnabled && <LeadForm />}
</Base>

<script>
const tryBox = document.querySelector<HTMLElement>('[data-named-try]')
if (tryBox) {
  const input = tryBox.querySelector<HTMLInputElement>('input[name="g"]')!
  const preview = tryBox.querySelector<HTMLElement>('[data-named-preview]')!
  const fallback = preview.textContent ?? ''
  input.addEventListener('input', () => {
    preview.textContent = input.value.trim() || fallback
  })
}

const calc = document.querySelector<HTMLElement>('[data-calc]')
if (calc) {
  const base = Number(calc.dataset.base)
  const unit = Number(calc.dataset.unit)
  const input = calc.querySelector<HTMLInputElement>('input')!
  const count = calc.querySelector<HTMLElement>('[data-calc-count]')!
  const total = calc.querySelector<HTMLElement>('[data-calc-total]')!
  const clamp = (n: number) => Math.max(0, Math.min(300, Math.round(n) || 0))
  const render = (n: number) => {
    count.textContent = String(n)
    total.textContent = `${(base + n * unit).toLocaleString('ru-RU')} ₽`
  }
  calc.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(b =>
    b.addEventListener('click', () => {
      input.value = String(clamp(Number(input.value) + Number(b.dataset.step)))
      render(Number(input.value))
    }),
  )
  input.addEventListener('input', () => render(clamp(Number(input.value))))
  input.addEventListener('change', () => {
    input.value = String(clamp(Number(input.value)))
  })
}
</script>

<style>
  /* main в Base — grid: без minmax(0) карусель растягивает колонку до своей ширины */
  .shop { overflow-x: clip; grid-template-columns: minmax(0, 1fr); }
  .shop-wide { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  .shop h1, .shop h2, .shop h3 { font-family: var(--font-display); font-weight: 400; color: var(--text); margin: 0; }
  .shop em { font-style: italic; color: var(--accent); }

  /* ── hero ── */
  .shop-hero { padding: clamp(72px, 14vh, 140px) 0 clamp(48px, 8vh, 80px); text-align: center; }
  .shop-hero .wrap { display: grid; justify-items: center; gap: 22px; }
  .shop-hero h1 { font-size: clamp(2.3rem, 8vw, 4.2rem); line-height: 1.08; max-width: 14ch; text-wrap: balance; }
  .shop-sub { max-width: 44ch; font-size: 1.05rem; line-height: 1.65; color: var(--text-2); margin: 0; text-wrap: pretty; }
  .shop-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
  .shop-proof { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; font-size: 0.8rem; letter-spacing: 0.06em; color: var(--muted); }
  .shop-proof li::before { content: '✦'; color: var(--accent); margin-right: 8px; font-size: 0.7em; vertical-align: 0.15em; }

  /* ── блоки ── */
  .shop-block { padding: clamp(64px, 10vh, 110px) 0; }
  .shop-block--surface { background: var(--surface); }
