---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const invitations = await getCollection('invitations');
---

<Base title="Приглашения — все темы">
  <main class="section">
    <div class="wrap wrap--narrow index">
      <p class="eyebrow">Демо</p>
      <h1>Выберите тему приглашения</h1>
      <ul>
        {invitations.map((inv) => (
          <li>
            <a href={`/${inv.id}`} class="plate">
              <span class="plate-inner">
                <strong>{inv.data.groom} &amp; {inv.data.bride}</strong>
                <small>{inv.data.theme} · {inv.data.date}</small>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Base>

<style>
  .index { display: grid; justify-items: center; gap: 18px; text-align: center; }
  .index ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 14px; width: 100%; }
  .index a { display: block; text-decoration: none; transition: transform 0.4s var(--ease); }
  .index a:hover { transform: translateY(-2px); }
  .index .plate-inner { display: grid; gap: 4px; text-align: center; }
  .index strong { font-family: var(--font-display); font-size: 1.3rem; font-weight: 400; }
  .index small { color: var(--muted); font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; }
</style>
