---
// заголовок секции как указатель в аэропорту: номер выхода, двуязычная табличка, стрелка
interface Props {
  code: string; // «A1», «B2» — номер «выхода»
  label: string;
  en: string;
  title?: string;
  guest?: string; // шаблон {g} для личного обращения
}
const { code, label, en, title, guest } = Astro.props;
---

<header class="sign">
  <p class="sign-plate">
    <span class="sign-code">{code}</span>
    <span class="sign-label" data-guest={guest}>{label}</span>
    <span class="sign-en" aria-hidden="true">{en}</span>
    <svg class="sign-arrow" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
  </p>
  {title && <h2>{title}</h2>}
</header>

<style>
  .sign {
    display: grid;
    justify-items: start;
    gap: 18px;
    margin-bottom: clamp(28px, 5vw, 44px);
  }
  .sign-plate {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    padding: 6px 14px 6px 6px;
    background: var(--text);
    color: var(--bg);
    border-radius: 6px;
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.2;
    box-shadow: 0 10px 20px -14px rgba(37, 48, 60, 0.7);
  }
  .sign-code {
    display: grid;
    place-items: center;
    min-width: 32px;
    height: 28px;
    padding: 0 6px;
    border-radius: 3px;
    background: #f2b84b;
    color: var(--text);
    font-weight: 700;
    letter-spacing: 0.04em;
    font-size: 0.8rem;
  }
  .sign-en { opacity: 0.55; }
  .sign-en::before { content: '/'; margin-right: 10px; opacity: 0.6; }
  .sign-arrow { width: 16px; height: 16px; flex: none; color: #f2b84b; }
  .sign h2 {
    font-style: italic;
    font-size: clamp(2.1rem, 8vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--text);
    max-width: 16ch;
    text-wrap: balance;
  }
  @media (max-width: 480px) {
    .sign-en { display: none; }
  }
</style>
