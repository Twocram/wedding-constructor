---
// поля анкеты + отправка в Telegram; обёртку (секция, диалог) даёт вызывающий
interface Props {
  drinks?: string[]; // чекбоксы напитков
  plusOne?: boolean; // чекбокс «приду с парой»
}
const { drinks, plusOne } = Astro.props;
const botToken = import.meta.env.PUBLIC_TG_BOT_TOKEN ?? '';
const chatId = import.meta.env.PUBLIC_TG_CHAT_ID ?? '';
---

<div class="plate rsvp-plate">
  <form id="rsvp-form" class="plate-inner" novalidate>
    <fieldset class="field">
      <span>Сможете ли вы присутствовать?</span>
      <div class="choice-group">
        <label class="choice">
          <input type="radio" name="attending" value="Приду" required />
          <strong>Да, я буду</strong>
          <small>Ждём вас в этот день</small>
        </label>
        <label class="choice">
          <input type="radio" name="attending" value="Не смогу" />
          <strong>К сожалению, не смогу</strong>
          <small>Мы всё равно вас любим</small>
        </label>
      </div>
    </fieldset>
    <label class="field">
      <span>Имя и фамилия</span>
      <input name="name" type="text" required autocomplete="name" placeholder="Как к вам обращаться" data-guest-value />
    </label>
    {drinks && drinks.length > 0 && (
      <fieldset class="field">
        <span>Что будете пить?</span>
        <div class="checks">
          {drinks.map((d) => (
            <label class="check">
              <input type="checkbox" name="drinks" value={d} />
              <i aria-hidden="true"></i>
              {d}
            </label>
          ))}
        </div>
      </fieldset>
    )}
    {plusOne && (
      <label class="check check--line">
        <input type="checkbox" name="plusOne" value="да" />
        <i aria-hidden="true"></i>
        Приду не один(одна)
      </label>
    )}
    <label class="field">
      <span>Пожелания, аллергии</span>
      <textarea name="notes" rows="3" placeholder="Предпочтения по еде, музыке — всё, что нам стоит знать"></textarea>
    </label>
    <button type="submit" class="btn btn--block">
      Отправить ответ
      <span class="btn-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
      </span>
    </button>
    <p class="form-status" role="status"></p>
  </form>
</div>

<script define:vars={{ botToken, chatId }}>
  // ponytail: токен бота виден в клиенте, для MVP-демо ок; на этапе 3 — отправка через свой server endpoint
  const form = document.getElementById('rsvp-form');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector('.form-status');
    if (!form.reportValidity()) {
      status.textContent = 'Заполните имя и выберите ответ.';
      return;
    }
    const button = form.querySelector('button[type="submit"]');
    const data = new FormData(form);
    const lines = [
      'RSVP',
      `Имя: ${data.get('name')}`,
      `Ответ: ${data.get('attending')}`,
    ];
    const picked = data.getAll('drinks');
    if (picked.length) lines.push(`Напитки: ${picked.join(', ')}`);
    if (data.get('plusOne')) lines.push('С парой: да');
    lines.push(`Пожелания: ${data.get('notes') || '—'}`);
    const text = lines.join('\n');
    button.disabled = true;
    status.textContent = 'Отправляем…';
    try {
      const res = await fetch(`https://api.telegram.org/bot${botToken}/sendMessage`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ chat_id: chatId, text }),
      });
      if (!res.ok) throw new Error();
      status.textContent = 'Спасибо. Ваш ответ получен.';
      form.reset();
    } catch {
      status.textContent = 'Не удалось отправить. Попробуйте ещё раз.';
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .rsvp-plate { text-align: left; }
  .rsvp-plate form { display: grid; gap: 22px; }
  .rsvp-plate fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .rsvp-plate .btn { margin-top: 6px; }
  .rsvp-plate .form-status { margin-top: -10px; }

  /* чекбоксы-пилюли в стиле плиток выбора */
  .checks { display: flex; flex-wrap: wrap; gap: 8px; }
  .check {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.4s var(--ease), background-color 0.4s var(--ease);
  }
  .check input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .check i {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .check:hover { border-color: var(--line-strong); }
  .check:has(:checked) { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .check:has(:checked) i { background: var(--accent); border-color: var(--accent); box-shadow: inset 0 0 0 3px var(--bg); }
  .check:has(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .check--line { width: fit-content; }
</style>
