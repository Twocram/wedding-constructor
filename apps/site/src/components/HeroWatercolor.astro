---
import HeroMedia from './HeroMedia.astro';
import ScrollHint from './ScrollHint.astro';
interface Props {
  groom: string;
  bride: string;
  date: string;
  city?: string;
  heroPhoto?: string;
  heroVideo?: string;
}
const { groom, bride, date, city, heroPhoto , heroVideo} = Astro.props;
---

<header class="hero-wc">
  <div class="wc-blobs" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="wc-content">
    <p class="wc-label">Приглашение на свадьбу</p>
    <h1>
      <span class="wc-name">{groom}</span>
      <span class="wc-amp">&</span>
      <span class="wc-name">{bride}</span>
    </h1>
    {(heroPhoto || heroVideo) && (
      <div class="wc-arch">
        <HeroMedia photo={heroPhoto} video={heroVideo} />
      </div>
    )}
    <p class="wc-date">{date}{city && ` · ${city}`}</p>
    <ScrollHint />
  </div>
</header>

<style>
  .hero-wc {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(36px, 6vh, 56px) 24px;
    text-align: center;
  }
  /* акварельные пятна: мягкие цветные блобы, плывущие за текстом */
  .wc-blobs { position: absolute; inset: 0; z-index: -1; }
  .wc-blobs i {
    position: absolute;
    border-radius: 50%;
    filter: blur(46px);
    opacity: 0.5;
    animation: wc-float 16s ease-in-out infinite alternate;
  }
  .wc-blobs i:nth-child(1) { width: 62vw; height: 62vw; max-width: 380px; max-height: 380px; left: -18%; top: -8%; background: var(--accent-2); }
  .wc-blobs i:nth-child(2) { width: 54vw; height: 54vw; max-width: 330px; max-height: 330px; right: -16%; top: 32%; background: #c9b8d9; animation-delay: -5s; }
  .wc-blobs i:nth-child(3) { width: 58vw; height: 58vw; max-width: 350px; max-height: 350px; left: 8%; bottom: -14%; background: #e8c9b0; animation-delay: -10s; }
  @keyframes wc-float {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(26px, -22px) scale(1.12); }
  }

  .wc-content { display: grid; justify-items: center; gap: 16px; }
  .wc-content > * { animation: wc-rise 1.1s var(--ease-out) both; }
  .wc-content > :nth-child(1) { animation-delay: 0.1s; }
  .wc-content > :nth-child(2) { animation-delay: 0.25s; }
  .wc-content > :nth-child(3) { animation-delay: 0.4s; }
  .wc-content > :nth-child(4) { animation-delay: 0.55s; }
  .wc-content > :nth-child(5) { animation-delay: 0.7s; }
  @keyframes wc-rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }

  .wc-label {
    font-size: 0.66rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 { display: grid; justify-items: center; font-weight: 500; font-size: clamp(2.7rem, 12vw, 5.4rem); line-height: 1.02; }
  .wc-amp { font-family: var(--font-accent); font-weight: 700; font-size: 0.62em; line-height: 0.8; color: var(--accent); }
  .wc-arch {
    width: min(66vw, 260px);
    aspect-ratio: 4 / 5;
    padding: 10px;
    background: color-mix(in srgb, #ffffff 55%, transparent);
    border-radius: 999px 999px var(--r-md) var(--r-md);
    box-shadow: 0 24px 44px -22px color-mix(in srgb, var(--accent) 45%, transparent);
    rotate: -1.5deg;
  }
  .wc-arch img { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
  .wc-date {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--text-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .wc-blobs i, .wc-content > * { animation: none; }
  }
</style>
