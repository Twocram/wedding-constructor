---
import Section from './Section.astro';
interface Props {
  name: string;
  phone: string;
}
const { name, phone } = Astro.props;
const tel = phone.replace(/[^+\d]/g, '');
---

<Section eyebrow="Контакты" title="Если остались вопросы" narrow>
  <div class="org">
    <span class="org-avatar" aria-hidden="true">{name[0]}</span>
    <div class="org-body">
      <p class="org-name">{name}</p>
      <p class="org-role">свадебный организатор</p>
    </div>
    <a class="org-phone" href={`tel:${tel}`}>{phone}</a>
  </div>
</Section>

<style>
  .org {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 18px;
    text-align: left;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }
  .org-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .org-name { font-weight: 500; color: var(--text) !important; line-height: 1.3; }
  .org-role { font-size: 0.8rem; color: var(--muted) !important; letter-spacing: 0.04em; }
  .org-phone {
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    font-weight: 400;
    white-space: nowrap;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--accent);
    transition: color 0.4s var(--ease);
  }
  .org-phone:hover { color: var(--accent); }
  @media (max-width: 480px) {
    .org { grid-template-columns: auto 1fr; }
    .org-phone { grid-column: 2; justify-self: start; }
  }
</style>
