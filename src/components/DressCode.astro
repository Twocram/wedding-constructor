---
import Section from './Section.astro';
interface Props {
  text: string;
  colors?: string[];
}
const { text, colors } = Astro.props;
---

<Section eyebrow="Дресс-код" title="Палитра вечера" variant="surface" narrow>
  <p class="dc-text">{text}</p>
  {colors && (
    <ul class="palette" role="list" aria-label="Оттенки дресс-кода">
      {colors.map((c, i) => (
        <li class="fade-up" style={`--i:${i + 1}; --c:${c}`} title={c}>
          <span class="swatch"></span>
        </li>
      ))}
    </ul>
  )}
</Section>

<style>
  .dc-text { max-width: 40ch; margin: 0 auto; }
  .palette {
    list-style: none;
    padding: 0;
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }
  .palette li {
    width: 64px;
    height: 64px;
    margin: 0 -8px;
    border-radius: var(--r-swatch);
    padding: 5px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    transition: transform 0.6s var(--ease);
    position: relative;
    z-index: 1;
  }
  .palette li:hover { transform: translateY(-8px); z-index: 2; }
  .swatch {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--r-swatch);
    background: var(--c);
    box-shadow: inset 0 -6px 12px rgba(0, 0, 0, 0.12), inset 0 2px 4px rgba(255, 255, 255, 0.35);
  }
  :global(body[data-theme='amalfi']) .palette li {
    background: var(--surface);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  @media (max-width: 380px) { .palette li { width: 54px; height: 54px; } }
</style>
