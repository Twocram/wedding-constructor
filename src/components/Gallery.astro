---
import Section from './Section.astro';
interface Props {
  photos: string[];
}
const { photos } = Astro.props;
const total = String(photos.length).padStart(2, '0');
---

<Section eyebrow="Наша история" title="Несколько моментов">
  <div class="gallery">
    {photos.map((p, i) => (
      <figure class:list={['fade-up', { wide: i === 0 }]} style={`--i:${i}`}>
        <img src={p} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
        <figcaption>{String(i + 1).padStart(2, '0')} / {total}</figcaption>
      </figure>
    ))}
  </div>
</Section>

<style>
  /* одно широкое фото + асимметричная пара ниже — журнальная вёрстка */
  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 3vw, 28px);
  }
  .gallery figure { margin: 0; }
  .gallery .wide { grid-column: 1 / -1; }
  .gallery img {
    width: 100%;
    object-fit: cover;
    border-radius: calc(var(--r-lg) - 6px);
    box-shadow: var(--shadow);
  }
  .gallery .wide img { aspect-ratio: 16 / 10; }
  .gallery figure:not(.wide) img { aspect-ratio: 3 / 4; }
  .gallery figcaption {
    margin-top: 10px;
    text-align: left;
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  @media (min-width: 640px) {
    /* правая колонка опущена — асимметрия */
    .gallery figure:nth-child(odd):not(.wide) { margin-top: clamp(32px, 7vw, 72px); }
  }
</style>
