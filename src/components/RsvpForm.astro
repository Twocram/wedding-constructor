---
import Section from './Section.astro';
import RsvpFields from './RsvpFields.astro';
interface Props {
  deadline: string;
  photo?: string;
}
const { deadline, photo } = Astro.props;
---

<Section id="rsvp" eyebrow="Анкета гостя" title="Будете с нами?" variant={photo ? 'photo' : 'plain'} photo={photo} narrow>
  <p class="rsvp-intro">Пожалуйста, ответьте до <strong>{deadline}</strong> — так нам будет проще всё подготовить.</p>
  <RsvpFields />
</Section>

<style>
  .rsvp-intro { max-width: 36ch; margin: -20px auto 36px; }
</style>
