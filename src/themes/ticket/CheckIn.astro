---
// RSVP — онлайн-регистрация на рейс: стойка с данными рейса + бланк RsvpFields в моно-стилистике
import Sign from './Sign.astro';
import RsvpFields from '../../components/RsvpFields.astro';
interface Props {
  deadline: string;
  flight: string;
  iata: string;
  code: string;
}
const { deadline, flight, iata, code } = Astro.props;
const rand = (seed: number) => {
  const x = Math.sin(seed * 53.3) * 43758.5453;
  return x - Math.floor(x);
};
const bars = Array.from({ length: 40 }, (_, i) => 1 + Math.floor(rand(i + 7) * 3));
---

<section class="tk-sec ci-sec fade-up" id="rsvp">
  <div class="tk-wrap">
    <Sign code={code} label="Регистрация" en="Online check-in" title="Регистрация на рейс" />

    <div class="ci">
      <aside class="ci-desk">
        <p class="ci-kicker">Стойка регистрации</p>
        <dl class="ci-grid">
          <div><dt>Рейс</dt><dd>{flight}</dd></div>
          <div><dt>Куда</dt><dd>{iata}</dd></div>
          <div><dt>Класс</dt><dd>Первый</dd></div>
          <div><dt>Место</dt><dd>У окна</dd></div>
        </dl>
        <p class="ci-deadline">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
          <span>Регистрация закрывается <b>{deadline}</b></span>
        </p>
        <p class="ci-note">Отметьтесь заранее — так мы успеем посчитать места и&nbsp;меню на&nbsp;борту.</p>
        <div class="ci-bars" aria-hidden="true">{bars.map((w) => <i style={`width:${w}px`} />)}</div>
      </aside>

      <div class="ci-form">
        <RsvpFields />
      </div>
    </div>
  </div>
</section>

<style>
  .ci {
    position: relative;
    display: grid;
    background: #fbf7ec;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    box-shadow: var(--shadow);
  }
  .ci-desk {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(20px, 5vw, 34px);
    background: var(--text);
    color: var(--bg);
    border-radius: 15px 15px 0 0;
  }
  /* вырубные полукруги на линии отрыва (мобильный — горизонтальная) */
  .ci-desk::before, .ci-desk::after {
    content: '';
    position: absolute;
    bottom: -12px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg);
    z-index: 1;
  }
  .ci-desk::before { left: -12px; }
  .ci-desk::after { right: -12px; }
  .ci-kicker {
    font-family: var(--font-label);
    font-size: 0.64rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #f2b84b !important;
  }
  .ci-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 18px;
    margin: 0;
  }
  .ci-grid dt {
    font-family: var(--font-label);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(243, 239, 230, 0.5);
  }
  .ci-grid dd {
    margin: 4px 0 0;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
  }
  .ci-deadline {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 12px 14px;
    border: 1px dashed rgba(242, 184, 75, 0.6);
    border-radius: 6px;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.5;
    color: var(--bg) !important;
  }
  .ci-deadline svg { width: 18px; height: 18px; flex: none; color: #f2b84b; margin-top: 1px; }
  .ci-deadline b { color: #f2b84b; white-space: nowrap; }
  .ci-bars { display: flex; gap: 2px; height: 38px; margin-top: auto; opacity: 0.85; }
  .ci-bars i { display: block; background: var(--bg); }
  .ci-note { font-size: 0.92rem; color: rgba(243, 239, 230, 0.7) !important; line-height: 1.5; }

  .ci-form { padding: clamp(22px, 5vw, 36px) clamp(18px, 5vw, 36px) clamp(18px, 4vw, 28px); border-top: 2px dashed var(--line-strong); }

  /* ── перекраска общего бланка RsvpFields под бланк регистрации ── */
  .ci :global(.plate) { padding: 0; background: none; border: 0; border-radius: 0; }
  .ci :global(.plate > .plate-inner) { padding: 0; background: none; box-shadow: none; border-radius: 0; }
  .ci :global(form) { counter-reset: ci-field; }
  .ci :global(.field > span) {
    display: flex;
    gap: 10px;
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    color: var(--text-2);
  }
  /* номер пункта бланка: 01 / 02 / 03 */
  .ci :global(.field > span)::before {
    counter-increment: ci-field;
    content: counter(ci-field, decimal-leading-zero);
    color: var(--accent);
    font-weight: 700;
  }
  .ci :global(.field input),
  .ci :global(.field textarea) {
    padding: 10px 2px;
    border: 0;
    border-bottom: 1.5px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    font-size: 1.05rem;
  }
  .ci :global(.field textarea) {
    min-height: 96px;
    /* строки бланка под рукописный ответ */
    background: repeating-linear-gradient(to bottom, transparent 0 31px, var(--line) 31px 32px);
    line-height: 32px;
    padding-top: 0;
  }
  .ci :global(.field input::placeholder),
  .ci :global(.field textarea::placeholder) { font-family: var(--font-label); font-size: 0.78rem; color: var(--muted); }
  .ci :global(.field input:focus),
  .ci :global(.field textarea:focus) {
    border-bottom-color: var(--accent);
    background-color: transparent;
    box-shadow: none;
  }
  .ci :global(.choice) {
    padding: 14px 44px 14px 16px;
    border: 1.5px solid var(--line-strong);
    border-radius: 6px;
    background: var(--bg);
  }
  .ci :global(.choice::after) { border-radius: 3px; border-width: 1.5px; }
  .ci :global(.choice strong) { font-family: var(--font-label); font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .ci :global(.choice:has(:checked)) { background: var(--text); border-color: var(--text); color: var(--bg); }
  .ci :global(.choice:has(:checked) small) { color: rgba(243, 239, 230, 0.7); }
  .ci :global(.choice:has(:checked)::after) { background: #f2b84b; border-color: #f2b84b; box-shadow: inset 0 0 0 3px var(--text); }
  .ci :global(.btn) {
    --btn-bg: var(--accent);
    border-radius: 6px;
    padding: 8px 8px 8px 22px;
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    box-shadow: 0 12px 24px -14px rgba(194, 69, 45, 0.9);
  }
  .ci :global(.btn .btn-icon) { border-radius: 4px; }
  .ci :global(.btn:hover) { --btn-bg: var(--text); box-shadow: 0 16px 26px -14px rgba(37, 48, 60, 0.8); }
  .ci :global(.form-status) { font-family: var(--font-label); font-size: 0.74rem; letter-spacing: 0.04em; color: var(--accent); }

  @media (min-width: 860px) {
    .ci { grid-template-columns: 300px 1fr; }
    .ci-desk { border-radius: 15px 0 0 15px; }
    .ci-desk::before, .ci-desk::after { left: auto; right: -12px; }
    .ci-desk::before { top: -12px; bottom: auto; }
    .ci-desk::after { bottom: -12px; }
    .ci-form { border-top: 0; border-left: 2px dashed var(--line-strong); }
  }
</style>
