---
// место — багажная бирка: трёхбуквенный код города, люверс с верёвочкой, штрих-код и маршрут
import Sign from './Sign.astro';
interface Props {
  name: string;
  address: string;
  mapIframe?: string;
  iata: string;
  city?: string;
  flight: string;
  date: string;
  code: string;
}
const { name, address, mapIframe, iata, city, flight, date, code } = Astro.props;
const routeUrl = `https://yandex.ru/maps/?text=${encodeURIComponent(`${name}, ${address}`)}`;
const rand = (seed: number) => {
  const x = Math.sin(seed * 91.7) * 43758.5453;
  return x - Math.floor(x);
};
const bars = Array.from({ length: 34 }, (_, i) => 1 + Math.floor(rand(i + 3) * 3));
---

<section class="tk-sec tag-sec fade-up">
  <div class="tk-wrap">
    <Sign code={code} label="Пункт назначения" en="Destination" title="Куда летим" />

    <div class="tag-layout">
      <article class="tag">
        {/* верёвочка уходит за край бирки — будто привязана к чемодану */}
        <svg class="tag-string" viewBox="0 0 120 80" fill="none" aria-hidden="true">
          <path d="M40 40 C 20 20, 10 60, -10 30 S -40 10, -60 40" stroke="#b8894a" stroke-width="2.5" stroke-linecap="round" />
          <path d="M40 40 C 24 34, 12 70, -14 52" stroke="#a37538" stroke-width="2.5" stroke-linecap="round" />
        </svg>
        <span class="tag-hole" aria-hidden="true"></span>

        <div class="tag-body">
          <div class="tag-band" aria-hidden="true">
            <span>Wedding Airlines</span>
            <span>Priority · ♥</span>
          </div>

          <div class="tag-code">
            <small>Destination</small>
            <b aria-label={city ? `Код: ${iata}, ${city}` : `Код: ${iata}`}>{iata}</b>
          </div>

          <div class="tag-info">
            <h3>{name}</h3>
            <p>{address}</p>
          </div>

          <dl class="tag-grid">
            <div><dt>Рейс</dt><dd>{flight}</dd></div>
            <div><dt>Дата</dt><dd>{date}</dd></div>
            <div><dt>Багаж</dt><dd>2 сердца</dd></div>
          </dl>

          <div class="tag-foot">
            <div class="tag-bars" aria-hidden="true">{bars.map((w) => <i style={`width:${w}px`} />)}</div>
            <a class="tag-route" href={routeUrl} target="_blank" rel="noopener">
              Построить маршрут
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6" /></svg>
            </a>
          </div>
        </div>
      </article>

      {!mapIframe && (
        <aside class="route" aria-hidden="true">
          <p class="route-head"><span>Маршрут</span><span>Прямой рейс</span></p>
          <svg class="route-arc" viewBox="0 0 320 130" fill="none">
            <path class="route-path" d="M20 110 Q 160 -20 300 110" stroke="currentColor" stroke-width="2" stroke-dasharray="2 9" stroke-linecap="round" />
            <circle cx="20" cy="110" r="6" fill="var(--text)" />
            <circle cx="300" cy="110" r="6" fill="var(--accent)" />
            <circle cx="300" cy="110" r="13" stroke="var(--accent)" stroke-width="1.5" />
            <g transform="translate(148 33) rotate(90 12 12)" fill="var(--accent)"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z" /></g>
          </svg>
          <div class="route-ends">
            <span><b>ВЫ</b><small>Ваш город</small></span>
            <span><b>{iata}</b><small>{city ?? name}</small></span>
          </div>
          <p class="route-note">Без пересадок · Время в пути — вся жизнь</p>
        </aside>
      )}

      {mapIframe && (
        <figure class="flight-map">
          <iframe class="map-embed" src={mapIframe} loading="lazy" title="Карта проезда" />
          {/* пунктирная дуга маршрута поверх карты — чисто декор */}
          <svg class="map-arc" viewBox="0 0 400 300" fill="none" aria-hidden="true">
            <path d="M30 260 Q 170 20 300 140" stroke="var(--accent)" stroke-width="2.5" stroke-dasharray="2 9" stroke-linecap="round" />
            <circle cx="300" cy="140" r="8" fill="var(--accent)" />
            <circle cx="300" cy="140" r="16" stroke="var(--accent)" stroke-width="1.5" />
          </svg>
          <figcaption>Карта полёта · {iata}</figcaption>
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  .tag-layout {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  .tag {
    position: relative;
    width: min(100%, 560px);
    min-width: 0;
    padding-left: 54px;
    rotate: -1.5deg;
    transition: rotate 0.8s var(--ease);
    /* clip-path срезает box-shadow и рамку — тень и контур даёт фильтр родителя */
    filter: drop-shadow(0 0 0.6px rgba(37, 48, 60, 0.55)) drop-shadow(0 18px 22px rgba(37, 48, 60, 0.18));
  }
  .tag:hover { rotate: 0deg; }
  .tag-body {
    position: relative;
    display: grid;
    gap: 20px;
    padding: 22px clamp(18px, 4vw, 30px) 22px 30px;
    background: #fbf7ec;
    border-radius: 0 12px 12px 0;
    /* скошенные углы у люверса — силуэт бирки */
    clip-path: polygon(34px 0, 100% 0, 100% 100%, 34px 100%, 0 calc(100% - 34px), 0 34px);
  }
  .tag-hole {
    position: absolute;
    left: 66px;
    top: 50%;
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 0 0 0 5px #d9cfb8, 0 0 0 6px var(--line-strong), inset 0 2px 3px rgba(0, 0, 0, 0.25);
    z-index: 2;
  }
  .tag-string {
    position: absolute;
    left: 37px;
    top: 50%;
    width: 120px;
    height: 80px;
    margin-top: -40px;
    overflow: visible;
    z-index: 3;
    pointer-events: none;
  }

  .tag-band {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin: -22px calc(-1 * clamp(18px, 4vw, 30px)) 0 -30px;
    padding: 10px clamp(18px, 4vw, 30px) 10px 64px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .tag-code, .tag-info, .tag-grid, .tag-foot { padding-left: 34px; }
  .tag-code small, .tag-grid dt {
    display: block;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tag-code b {
    display: block;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: clamp(4.2rem, 21vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .tag-info h3 {
    font-size: clamp(1.4rem, 5vw, 1.9rem);
    font-style: italic;
    line-height: 1.15;
  }
  .tag-info p { margin-top: 6px; color: var(--text-2); }
  .tag-grid {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 8px 26px;
    margin: 0;
    padding-top: 16px;
    border-top: 1px dashed var(--line-strong);
  }
  .tag-grid dd {
    margin: 4px 0 0;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
  }
  .tag-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .tag-bars { display: flex; gap: 2px; height: 34px; }
  .tag-bars i { display: block; background: var(--text); }
  .tag-route {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 4px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: background-color 0.3s var(--ease), transform 0.4s var(--ease);
  }
  .tag-route svg { width: 14px; height: 14px; }
  .tag-route:hover { background: var(--accent); transform: translateY(-2px); }

  /* схема маршрута — декор для широкого экрана, на телефоне только бирка */
  .route {
    display: none;
    gap: 14px;
    align-self: center;
    padding: clamp(18px, 4vw, 28px);
    border: 1.5px dashed var(--line-strong);
    border-radius: 12px;
    color: var(--text);
  }
  .route-head, .route-note {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted) !important;
  }
  .route-arc { width: 100%; height: auto; color: var(--accent); overflow: visible; }
  /* пунктир «течёт» от вас к месту свадьбы */
  .route-path { animation: route-flow 1.4s linear infinite; }
  @keyframes route-flow { to { stroke-dashoffset: -22; } }
  .route-ends { display: flex; justify-content: space-between; margin-top: -6px; }
  .route-ends span { display: grid; gap: 2px; }
  .route-ends span:last-child { text-align: right; }
  .route-ends b { font-family: var(--font-label); font-weight: 700; font-size: 1.6rem; line-height: 1; }
  .route-ends small { font-size: 0.8rem; color: var(--muted); }
  .route-note { justify-content: center; }

  .flight-map {
    position: relative;
    margin: 0;
    padding: 8px;
    background: #fbf7ec;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    box-shadow: var(--shadow);
  }
  .flight-map .map-embed { border-radius: 6px; filter: saturate(0.4) sepia(0.2) contrast(1.02); }
  .map-arc { position: absolute; inset: 8px 8px 38px; width: calc(100% - 16px); height: calc(100% - 46px); pointer-events: none; }
  .flight-map figcaption {
    padding: 10px 4px 2px;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 360px) {
    .tag-band span:last-child { display: none; }
    .tag-grid { grid-template-columns: repeat(2, auto); }
  }
  @media (max-width: 420px) {
    .tag { padding-left: 38px; rotate: -0.8deg; }
    .tag-string { left: 21px; }
    .tag-hole { left: 50px; }
    .tag-code, .tag-info, .tag-grid, .tag-foot { padding-left: 26px; }
    .tag-grid { gap: 8px 18px; }
  }
  @media (min-width: 900px) {
    .tag-layout { grid-template-columns: 1.15fr 1fr; gap: 56px; }
    .route { display: grid; }
  }
</style>
