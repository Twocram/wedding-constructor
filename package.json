{
  "name": "saywed",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @saywed/site",
    "dev:api": "npm run dev -w @saywed/api",
    "build": "npm run build -w @saywed/site",
    "build:api": "npm run build -w @saywed/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
