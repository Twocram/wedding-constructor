---
import Head from './Head.astro';
// место — винтажная итальянская открытка: фото «Saluti da…», марка с перфорацией и круглый штемпель с датой
interface Props {
  name: string;
  address: string;
  mapIframe?: string;
  photo?: string;
  city?: string;
  date: string; // «20 июня 2027»
  when?: string; // ISO — для штемпеля
}
const { name, address, mapIframe, photo, city, date, when } = Astro.props;
const routeUrl = `https://yandex.ru/maps/?text=${encodeURIComponent(`${name}, ${address}`)}`;
const place = (city ?? address).split(',')[0].trim();
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
const d = when ? new Date(when) : null;
const valid = d && !Number.isNaN(d.getTime());
const stampDate = valid ? `${d.getDate()}·${roman[d.getMonth()]}·${d.getFullYear()}` : date;
const time = valid ? `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}` : '';
const ring = `${place.toUpperCase()} · ${place.toUpperCase()} · `;
---

<section class="am-post" aria-labelledby="am-post-title">
  <Head it="Dove ci vediamo" title="Место встречи" id="am-post-title" />

  <article class="am-card fade-up">
    {photo && (
      <div class="am-card-front">
        <img src={photo} alt="" loading="lazy" decoding="async" />
        <p class="am-card-greet">
          <span lang="it">Saluti da</span>
          <strong>{place}</strong>
        </p>
      </div>
    )}

    <div class="am-card-back">
      <p class="am-card-side" aria-hidden="true">Cartolina postale</p>

      <div class="am-card-post" aria-hidden="true">
        <!-- марка: перфорация маской, внутри — арка, луна и море -->
        <div class="am-stamp">
          <svg viewBox="0 0 70 84">
            <rect width="70" height="84" fill="#1f4f94" />
            <path d="M12 84V38a23 23 0 0 1 46 0v46" fill="#15375f" stroke="#e8c987" stroke-width="1.2" />
            <circle cx="42" cy="34" r="6" fill="#f3e2b0" />
            <circle cx="45" cy="32" r="5" fill="#15375f" />
            <path d="M12 62c8-3 15 3 23 0s15-3 23 0M12 70c8-3 15 3 23 0s15-3 23 0" fill="none" stroke="#efe6d2" stroke-width="1" opacity="0.7" />
            <text x="35" y="14" text-anchor="middle" fill="#efe6d2" font-size="7" letter-spacing="1.5">AMORE</text>
            <text x="35" y="80" text-anchor="middle" fill="#e8c987" font-size="6.5" letter-spacing="1">{valid ? d.getFullYear() : ''}</text>
          </svg>
        </div>
        <!-- штемпель поверх марки -->
        <svg class="am-postmark" viewBox="0 0 150 100">
          <defs><path id="am-ring" d="M50 50m-34 0a34 34 0 1 1 68 0a34 34 0 1 1-68 0" /></defs>
          <g fill="none" stroke="currentColor">
            <circle cx="50" cy="50" r="44" stroke-width="1.6" />
            <circle cx="50" cy="50" r="27" stroke-width="1" />
            <path d="M96 34c9-5 18 5 27 0s18-5 27 0M96 50c9-5 18 5 27 0s18-5 27 0M96 66c9-5 18 5 27 0s18-5 27 0" stroke-width="1.6" />
          </g>
          <text fill="currentColor" font-size="8.5" letter-spacing="2.2"><textPath href="#am-ring">{ring}</textPath></text>
          <text x="50" y="49" text-anchor="middle" fill="currentColor" font-size="9.5" letter-spacing="0.5">{stampDate}</text>
          {time && <text x="50" y="61" text-anchor="middle" fill="currentColor" font-size="7.5" letter-spacing="1">{time}</text>}
        </svg>
      </div>

      <p class="am-card-msg">
        <span lang="it">Ci vediamo al tramonto!</span>
        Увидимся на закате — на террасе над самым морем.
      </p>
      <p class="am-card-to">Ждём вас по адресу</p>
      <div class="am-card-lines">
        <h3>{name}</h3>
        <p>{address}</p>
        <p>{date}{time && `, ${time}`}</p>
      </div>

      <a class="am-card-route" href={routeUrl} target="_blank" rel="noopener">
        Построить маршрут
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6" /></svg>
      </a>
    </div>
  </article>

  {mapIframe && (
    <div class="am-map fade-up">
      <iframe src={mapIframe} title={`Карта: ${name}`} loading="lazy" allowfullscreen></iframe>
    </div>
  )}
</section>

<style>
  .am-post {
    --paper: #efe6d3;
    --ink: #1c2b3d;
    --ink-2: #4b5868;
    padding: clamp(88px, 12vw, 128px) 20px clamp(40px, 6vw, 64px);
  }
  .am-card {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.35), transparent 30%),
      var(--paper);
    color: var(--ink);
    border-radius: 6px;
    padding: 10px;
    rotate: -1.2deg;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.85), 0 14px 28px -16px rgba(0, 0, 0, 0.6);
  }
  .am-card-front {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
  }
  .am-card-front img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: sepia(0.18) saturate(1.1) contrast(1.02);
  }
  .am-card-front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(12, 21, 32, 0.65));
  }
  .am-card-greet {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 14px;
    z-index: 1;
    display: grid;
    line-height: 1;
    color: #fbf3de;
  }
  .am-card-greet span {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: clamp(1.4rem, 5vw, 2rem);
  }
  .am-card-greet strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 11vw, 4.2rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #f3d88f;
    text-shadow: 0 2px 0 rgba(12, 21, 32, 0.35);
  }

  .am-card-back {
    position: relative;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 28px 16px 22px;
  }
  .am-card-side {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--ink-2);
    border-bottom: 1px solid rgba(28, 43, 61, 0.2);
    padding-bottom: 12px;
    margin-bottom: 4px;
  }

  .am-card-post {
    position: absolute;
    top: 64px;
    right: 14px;
    width: 76px;
    height: 92px;
  }
  .am-stamp {
    width: 76px;
    height: 92px;
    padding: 4px;
    background: #fbf6ea;
    /* перфорация: сплошной центр + «дырочки» по кромке */
    -webkit-mask: linear-gradient(#000 0 0) content-box, radial-gradient(circle at 50% 50%, transparent 2.2px, #000 2.6px) -4px -4px / 8px 8px round;
    mask: linear-gradient(#000 0 0) content-box, radial-gradient(circle at 50% 50%, transparent 2.2px, #000 2.6px) -4px -4px / 8px 8px round;
    rotate: 4deg;
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.15));
  }
  .am-stamp svg { display: block; width: 100%; height: 100%; font-family: var(--font-label); }
  .am-postmark {
    position: absolute;
    top: 40px;
    right: 22px;
    width: 124px;
    color: rgba(28, 43, 61, 0.62);
    rotate: -14deg;
    font-family: var(--font-label);
    mix-blend-mode: multiply;
  }

  .am-card-msg {
    display: grid;
    gap: 6px;
    min-height: 112px;
    padding-right: 158px;
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .am-card-msg span { font-size: 1.5rem; line-height: 1.1; color: #1f4f94; }
  .am-card-to {
    margin-top: 18px;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  /* строки адреса на «линовке» открытки */
  .am-card-lines { display: grid; }
  .am-card-lines > * {
    padding: 10px 0 6px;
    border-bottom: 1px solid rgba(28, 43, 61, 0.28);
    line-height: 1.35;
  }
  .am-card-lines h3 {
    font-size: clamp(1.3rem, 5vw, 1.7rem);
    color: var(--ink);
  }
  .am-card-lines p {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 1.22rem;
    color: var(--ink);
  }

  .am-card-route {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
    padding: 13px 22px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--accent-2);
    text-decoration: none;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transition: transform 0.5s var(--ease), background-color 0.4s var(--ease);
  }
  .am-card-route svg { width: 14px; height: 14px; transition: transform 0.5s var(--ease); }
  .am-card-route:hover { background: #24384f; transform: translateY(-2px); }
  .am-card-route:hover svg { transform: translate(2px, -2px); }

  .am-map {
    max-width: 760px;
    margin: 56px auto 0;
    padding: 10px 10px 34px;
    background: var(--paper);
    border-radius: 4px;
    rotate: 1deg;
    box-shadow: var(--shadow);
  }
  .am-map iframe { display: block; width: 100%; aspect-ratio: 4 / 3; border: 0; filter: saturate(0.7) sepia(0.1); }

  @media (min-width: 760px) {
    .am-card { grid-template-columns: 1.08fr 1fr; padding: 14px; }
    /* фото растягивается на высоту оборота, а не задаёт её своими пропорциями */
    .am-card-front { min-height: 460px; }
    .am-card-front img { position: absolute; inset: 0; height: 100%; aspect-ratio: auto; }
    .am-card-back { padding: 30px 30px 26px 44px; }
    /* разделительная линия оборота открытки */
    .am-card-back::before {
      content: '';
      position: absolute;
      left: 20px;
      top: 24px;
      bottom: 24px;
      width: 1px;
      background: rgba(28, 43, 61, 0.22);
    }
    /* адрес прижат к низу оборота, послание — сверху, как на настоящей открытке */
    .am-card-back { display: flex; flex-direction: column; }
    .am-card-post { top: 70px; right: 26px; }
    .am-postmark { top: 34px; right: 28px; width: 150px; }
    .am-card-msg { padding-right: 170px; font-size: 1.25rem; }
    .am-card-msg span { font-size: 1.9rem; }
    .am-card-to { margin-top: auto; padding-top: 24px; }
    .am-map iframe { aspect-ratio: 16 / 9; }
  }
</style>
