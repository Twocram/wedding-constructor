---
import Section from './Section.astro';
interface Props {
  name: string;
  address: string;
  mapIframe?: string;
}
const { name, address, mapIframe } = Astro.props;
const routeUrl = `https://yandex.ru/maps/?text=${encodeURIComponent(`${name}, ${address}`)}`;
---

<Section eyebrow="Место" title="Где мы встретимся" narrow>
  <div class="venue plate">
    <div class="plate-inner">
      <svg class="venue-pin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
        <path d="M12 21s-6.5-5.4-6.5-11A6.5 6.5 0 0 1 18.5 10c0 5.6-6.5 11-6.5 11Z" />
        <circle cx="12" cy="10" r="2.4" />
      </svg>
      <h3>{name}</h3>
      <p class="venue-address">{address}</p>
      <a class="btn btn--ghost" href={routeUrl} target="_blank" rel="noopener">
        Построить маршрут
        <span class="btn-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 12 12 4M6 4h6v6" /></svg>
        </span>
      </a>
    </div>
  </div>
  {mapIframe && (
    <div class="plate map-plate fade-up">
      <iframe class="map-embed" src={mapIframe} loading="lazy" title="Карта проезда" />
    </div>
  )}
</Section>

<style>
  .venue .plate-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 10px;
  }
  .venue-pin { width: 32px; height: 32px; color: var(--accent); margin-bottom: 6px; }
  .venue h3 { font-size: clamp(1.5rem, 5vw, 1.9rem); }
  .venue-address { color: var(--text-2); font-size: 0.98rem; }
  .venue .btn { margin-top: 14px; }
  .map-plate { margin-top: 14px; }
  :global(body[data-theme='editorial']) .venue h3 { font-weight: 300; font-style: italic; font-size: clamp(1.9rem, 6vw, 2.4rem); }
  :global(body[data-theme='amalfi']) .venue h3 { font-size: clamp(1.3rem, 4.5vw, 1.6rem); }
</style>
