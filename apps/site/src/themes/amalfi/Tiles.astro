---
import Head from './Head.astro';
// дресс-код — расписные керамические плитки: каждый цвет палитры — своя плитка с узором
interface Props {
  text: string;
  colors?: string[];
}
const { text, colors = [] } = Astro.props;

// узор рисуем светлой или тёмной «глазурью» — в зависимости от яркости плитки
const isLight = (hex: string) => {
  const h = hex.replace('#', '');
  const full = h.length === 3 ? [...h].map((c) => c + c).join('') : h;
  const [r, g, b] = [0, 2, 4].map((i) => parseInt(full.slice(i, i + 2), 16) / 255);
  return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.55;
};
const motifs = [
  // четырёхлистник с угловыми дугами
  (c: string) => `<g fill='none' stroke='${c}' stroke-width='2.2' stroke-linecap='round'><path d='M50 18c10 12 10 20 0 32-10-12-10-20 0-32ZM50 82c10-12 10-20 0-32-10 12-10 20 0 32ZM18 50c12-10 20-10 32 0-12 10-20 10-32 0ZM82 50c-12-10-20-10-32 0 12 10 20 10 32 0Z'/><path d='M0 16a16 16 0 0 0 16-16M84 0a16 16 0 0 0 16 16M100 84a16 16 0 0 0-16 16M16 100A16 16 0 0 0 0 84'/></g><circle cx='50' cy='50' r='4' fill='${c}'/>`,
  // ромб-звезда с точками
  (c: string) => `<g fill='none' stroke='${c}' stroke-width='2.2' stroke-linejoin='round'><path d='M50 10 90 50 50 90 10 50Z'/><path d='M50 28 72 50 50 72 28 50Z'/></g><g fill='${c}'><circle cx='50' cy='50' r='5'/><circle cx='10' cy='10' r='3'/><circle cx='90' cy='10' r='3'/><circle cx='90' cy='90' r='3'/><circle cx='10' cy='90' r='3'/></g>`,
  // лимонная ветвь по диагонали
  (c: string) => `<g fill='none' stroke='${c}' stroke-width='2.2' stroke-linecap='round'><path d='M18 82C38 62 62 38 82 18'/><path d='M34 66c-2-10 4-16 12-16-1 9-6 14-12 16ZM50 50c-1-10 5-16 13-16-1 9-6 14-13 16ZM66 34c10 2 14 9 12 16-8-1-12-8-12-16ZM50 50c10 2 14 9 12 16-8-1-12-8-12-16Z'/><circle cx='26' cy='74' r='7'/></g>`,
];
const tiles = colors.map((hex, i) => {
  const ink = isLight(hex) ? 'rgba(20,40,70,.55)' : 'rgba(239,230,210,.5)';
  const svg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>${motifs[i % motifs.length](ink)}</svg>`;
  // «ручная» раскладка: лёгкий детерминированный поворот
  const tilt = (((i * 37) % 7) - 3) * 0.6;
  return { hex, bg: `url("data:image/svg+xml,${encodeURIComponent(svg)}")`, tilt };
});
---

<section class="am-tiles" aria-labelledby="am-tiles-title">
  <Head it="Colori della sera" title="Дресс-код" id="am-tiles-title" />
  <p class="am-tiles-text fade-up">{text}</p>
  {tiles.length > 0 && (
    <ul class="am-tiles-grid" aria-label="Палитра вечера">
      {tiles.map((t, i) => (
        <li class="am-tile fade-up" style={`--c:${t.hex};--motif:${t.bg};--tilt:${t.tilt}deg;--i:${i}`} aria-label={`Цвет ${t.hex}`}>
          <span class="am-tile-hex" aria-hidden="true">{t.hex}</span>
        </li>
      ))}
    </ul>
  )}
</section>

<style>
  .am-tiles { padding: clamp(80px, 12vw, 120px) 20px clamp(24px, 4vw, 40px); text-align: center; }
  .am-tiles-text {
    max-width: 42ch;
    margin: 0 auto;
    color: var(--text-2);
  }
  .am-tiles-grid {
    list-style: none;
    padding: 0;
    margin: clamp(40px, 7vw, 60px) auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    max-width: 720px;
  }
  .am-tile {
    --size: clamp(84px, 26vw, 124px);
    position: relative;
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 5px;
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.22), transparent 38%, transparent 70%, rgba(0, 0, 0, 0.2)),
      var(--motif) center / 86% no-repeat,
      var(--c);
    box-shadow:
      inset 0 0 0 5px color-mix(in srgb, var(--c) 80%, white 12%),
      inset 0 0 0 6px rgba(0, 0, 0, 0.12),
      0 14px 24px -12px rgba(0, 0, 0, 0.7);
    rotate: var(--tilt);
    transition: rotate 0.6s var(--ease), translate 0.6s var(--ease);
  }
  .am-tile:hover { rotate: 0deg; translate: 0 -4px; }
  .am-tile-hex {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -26px;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .am-tile:hover .am-tile-hex { opacity: 1; }
</style>
