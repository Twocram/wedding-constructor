---
import Section from './Section.astro';
interface Props {
  photos: string[];
}
const { photos } = Astro.props;
---

<Section eyebrow="Наша история" title="Несколько моментов">
  <div class="gallery" tabindex="0" aria-label="Галерея фотографий">
    {photos.map((p, i) => (
      <figure class="fade-up" style={`--i:${i}`}>
        <img src={p} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
      </figure>
    ))}
  </div>
  <div class="gallery-bar" aria-hidden="true"><i></i></div>
</Section>

<script>
  // индикатор прогресса по горизонтальному скроллу
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gal) => {
    const bar = gal.parentElement?.querySelector<HTMLElement>('.gallery-bar i');
    if (!bar) return;
    const update = () => {
      const max = gal.scrollWidth - gal.clientWidth;
      const p = max > 0 ? gal.scrollLeft / max : 0;
      const w = Math.max(0.2, gal.clientWidth / gal.scrollWidth);
      bar.style.width = `${w * 100}%`;
      bar.style.transform = `translateX(${(p * (1 - w) * 100) / w}%)`;
    };
    gal.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .gallery {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 24px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 0 -24px;
    padding: 0 24px 28px;
  }
  .gallery::-webkit-scrollbar { display: none; }
  .gallery figure {
    flex: 0 0 74%;
    scroll-snap-align: center;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--text) 3%, transparent);
  }
  /* арка на каждой третьей — форма разная, уровень один */
  .gallery figure:nth-child(3n + 1) { border-radius: 200px 200px var(--r-lg) var(--r-lg); }
  .gallery figure:nth-child(3n + 1) img { border-radius: 194px 194px calc(var(--r-lg) - 6px) calc(var(--r-lg) - 6px); }
  .gallery img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: calc(var(--r-lg) - 6px);
    box-shadow: var(--shadow);
  }
  @media (min-width: 720px) {
    .gallery figure { flex-basis: 40%; }
  }
  /* editorial — строгая сетка без арок; amalfi — арка на каждом фото */
  :global(body[data-theme='editorial']) .gallery figure:nth-child(3n + 1),
  :global(body[data-theme='editorial']) .gallery figure:nth-child(3n + 1) img { border-radius: 0; }
  :global(body[data-theme='amalfi']) .gallery figure { border-radius: 200px 200px var(--r-lg) var(--r-lg); }
  :global(body[data-theme='amalfi']) .gallery img { border-radius: 194px 194px calc(var(--r-lg) - 6px) calc(var(--r-lg) - 6px); }
  .gallery-bar {
    width: 140px;
    height: 2px;
    margin: 0 auto;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }
  .gallery-bar i {
    display: block;
    height: 100%;
    width: 30%;
    background: var(--accent);
    border-radius: 2px;
    transition: transform 0.2s linear, width 0.2s linear;
  }
</style>
