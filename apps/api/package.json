{
  "name": "@saywed/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "cli": "bun src/main.ts",
    "db:generate": "drizzle-kit generate",
    "build": "bun build src/main.ts --compile --minify --sourcemap --target=bun-linux-x64 --outfile dist/saywed-api",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@saywed/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
