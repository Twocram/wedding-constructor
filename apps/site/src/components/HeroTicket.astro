---
import ScrollHint from './ScrollHint.astro';
interface Props {
  groom: string;
  bride: string;
  date: string;
  city?: string;
  heroPhoto?: string;
}
const { groom, bride, date, city } = Astro.props;
const initials = `${groom[0]}${bride[0]}`;
// детерминированный «штрих-код» (SSR-стабильный), как звёзды в amalfi
const rand = (seed: number) => {
  const x = Math.sin(seed * 127.1) * 43758.5453;
  return x - Math.floor(x);
};
const bars = Array.from({ length: 42 }, (_, i) => (1 + Math.floor(rand(i + 1) * 3)));
---

<header class="hero-tk">
  {/* пунктирная траектория рейса за билетом */}
  <svg class="tk-path" viewBox="0 0 600 220" fill="none" aria-hidden="true">
    <path d="M10 200 Q 300 10 585 130" stroke="currentColor" stroke-width="1.5" stroke-dasharray="1 8" stroke-linecap="round" />
    <text x="556" y="118" font-size="22" fill="currentColor" transform="rotate(18 566 125)">✈</text>
  </svg>

  <div class="ticket">
    <div class="ticket-main">
      <div class="tk-head">
        <span>Wedding Airlines</span>
        <span>Boarding pass · First class</span>
      </div>

      <div class="tk-passenger">
        <small>Passengers</small>
        <h1>{groom} <i>&</i> {bride}</h1>
      </div>

      <div class="tk-grid">
        <div><small>From</small><b>Single</b></div>
        <div><small>To</small><b>Married</b></div>
        <div><small>Date</small><b>{date}</b></div>
        {city && <div><small>Dest</small><b>{city}</b></div>}
        <div><small>Gate</small><b>LOVE</b></div>
        <div><small>Seats</small><b>1A · 1B</b></div>
      </div>

      <div class="tk-barcode" aria-hidden="true">
        {bars.map((w) => <i style={`width:${w}px`} />)}
      </div>
    </div>

    <div class="ticket-stub">
      <span class="tk-stamp" aria-hidden="true">Admit<br />two</span>
      <b class="tk-stub-mono">{initials}</b>
      <small>{date}</small>
    </div>
  </div>

  <div class="tk-hint"><ScrollHint /></div>
</header>

<style>
  .hero-tk {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 36px;
    padding: 64px 20px 48px;
    overflow: hidden;
    isolation: isolate;
    /* точечная «бланочная» сетка фона */
    background-image: radial-gradient(color-mix(in srgb, var(--text) 12%, transparent) 1px, transparent 1px);
    background-size: 26px 26px;
  }
  .tk-path {
    position: absolute;
    top: 4%;
    left: 50%;
    translate: -50% 0;
    width: min(680px, 110%);
    color: var(--accent);
    opacity: 0.5;
    z-index: -1;
  }

  /* ── билет ── */
  .ticket {
    display: grid;
    grid-template-columns: 1fr auto;
    width: min(760px, 100%);
    /* светлее фона страницы — иначе вырубные полукруги не отличить */
    background: #fbf7ec;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    box-shadow: var(--shadow);
    overflow: hidden;
    animation: tk-in 1s var(--ease-out) both;
    rotate: -1.2deg;
    transition: rotate 0.6s var(--ease);
  }
  .ticket:hover { rotate: 0deg; }
  @keyframes tk-in {
    from { opacity: 0; transform: translateY(30px) rotate(-1deg); }
    to { opacity: 1; transform: none; }
  }

  .ticket-main {
    display: grid;
    gap: 22px;
    padding: clamp(22px, 5vw, 36px);
  }
  .tk-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-label);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--line-strong);
  }
  .tk-passenger small, .tk-grid small {
    display: block;
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .tk-passenger h1 {
    font-size: clamp(2rem, 7.5vw, 3.6rem);
    line-height: 1.05;
    font-style: italic;
  }
  .tk-passenger h1 i { color: var(--accent); }
  .tk-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px 12px;
  }
  .tk-grid b {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .tk-barcode {
    display: flex;
    align-items: stretch;
    gap: 2px;
    height: 42px;
  }
  .tk-barcode i { background: var(--text); display: block; }

  /* отрывной стуб с перфорацией */
  .ticket-stub {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 10px;
    padding: clamp(18px, 4vw, 28px) clamp(20px, 4vw, 32px);
    border-left: 2px dashed var(--line-strong);
    text-align: center;
  }
  /* вырубные полукруги на линии отрыва */
  .ticket-stub::before, .ticket-stub::after {
    content: '';
    position: absolute;
    left: -13px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--bg);
  }
  .ticket-stub::before { top: -13px; box-shadow: inset -1px -1px 0 var(--line-strong); }
  .ticket-stub::after { bottom: -13px; box-shadow: inset -1px 1px 0 var(--line-strong); }
  .tk-stamp {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    border: 2px solid var(--accent);
    border-radius: 8px;
    padding: 8px 10px;
    rotate: -8deg;
    line-height: 1.4;
  }
  .tk-stub-mono {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 500;
  }
  .ticket-stub small {
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .tk-hint { color: var(--text-2); }

  @media (max-width: 560px) {
    .ticket { grid-template-columns: 1fr; rotate: -0.8deg; }
    .ticket-stub {
      border-left: 0;
      border-top: 2px dashed var(--line-strong);
      grid-auto-flow: column;
      align-items: center;
      justify-content: space-between;
    }
    .ticket-stub::before { top: -13px; left: -13px; box-shadow: inset -1px -1px 0 var(--line-strong); }
    .ticket-stub::after { top: -13px; bottom: auto; left: auto; right: -13px; box-shadow: inset 1px -1px 0 var(--line-strong); }
    .tk-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticket { animation: none; rotate: 0deg; }
  }
</style>
