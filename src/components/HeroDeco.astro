---
import ScrollHint from './ScrollHint.astro';
interface Props {
  groom: string;
  bride: string;
  date: string;
  city?: string;
  heroPhoto?: string;
}
const { groom, bride, date, city, heroPhoto } = Astro.props;
---

<header class="hero-deco">
  {/* класс hero-photo — хук для GSAP-зума/параллакса из Base */}
  {heroPhoto && <img src={heroPhoto} alt="" class="hero-photo hero-deco-photo" fetchpriority="high" />}
  <div class="hero-deco-veil" aria-hidden="true"></div>

  {/* двойная золотая рамка с углами — ар-деко */}
  <div class="hero-deco-frame" aria-hidden="true">
    <i class="corner corner--tl"></i>
    <i class="corner corner--tr"></i>
    <i class="corner corner--br"></i>
    <i class="corner corner--bl"></i>
  </div>

  <div class="hero-deco-content">
    <svg class="hero-deco-fan" viewBox="0 0 120 64" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
      <path d="M60 60 L60 16 M60 60 L30 20 M60 60 L90 20 M60 60 L8 34 M60 60 L112 34" />
      <path d="M10 40 A 52 52 0 0 1 110 40" />
      <path d="M56 60 L60 54 L64 60 Z" fill="currentColor" stroke="none" />
    </svg>
    <h1>
      <span class="hero-deco-name">{groom}</span>
      <span class="hero-deco-amp">&</span>
      <span class="hero-deco-name">{bride}</span>
    </h1>
    <p class="hero-deco-date">· {date}{city && <> · <span class="hero-deco-city">{city}</span></>} ·</p>
    <ScrollHint />
  </div>
</header>

<style>
  .hero-deco {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    justify-items: center;
    overflow: hidden;
    color: #efe9da;
    isolation: isolate;
  }
  .hero-deco-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -3;
    animation: deco-zoom 28s var(--ease-out) infinite alternate;
  }
  @keyframes deco-zoom {
    from { transform: scale(1); }
    to { transform: scale(1.08); }
  }
  .hero-deco-veil {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(110% 80% at 50% 50%, transparent 40%, rgba(12, 10, 8, 0.75) 100%),
      linear-gradient(to bottom, rgba(12, 10, 8, 0.55), rgba(12, 10, 8, 0.25) 40%, rgba(12, 10, 8, 0.7));
  }

  /* рамка: двойная волосяная линия + золотые углы */
  .hero-deco-frame {
    position: absolute;
    inset: 20px;
    border: 1px solid rgba(201, 162, 39, 0.4);
    pointer-events: none;
  }
  .hero-deco-frame::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid rgba(201, 162, 39, 0.2);
  }
  .corner {
    position: absolute;
    width: 46px;
    height: 46px;
    border: 2px solid var(--accent);
    border-right: 0;
    border-bottom: 0;
  }
  .corner--tl { top: -2px; left: -2px; }
  .corner--tr { top: -2px; right: -2px; transform: rotate(90deg); }
  .corner--br { bottom: -2px; right: -2px; transform: rotate(180deg); }
  .corner--bl { bottom: -2px; left: -2px; transform: rotate(270deg); }

  .hero-deco-content {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 26px;
    padding: 0 32px;
  }
  .hero-deco-content > * { animation: deco-rise 1.1s var(--ease-out) both; }
  .hero-deco-content > :nth-child(2) { animation-delay: 0.2s; }
  .hero-deco-content > :nth-child(3) { animation-delay: 0.4s; }
  .hero-deco-content > :nth-child(4) { animation-delay: 0.6s; }
  @keyframes deco-rise {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: none; }
  }

  .hero-deco-fan { width: 96px; color: var(--accent); opacity: 0.9; }

  .hero-deco h1 {
    display: grid;
    justify-items: center;
    gap: 0.1em;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: clamp(2.2rem, 10vw, 5.5rem);
    line-height: 1.1;
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }
  .hero-deco-amp {
    font-size: 0.5em;
    line-height: 1;
    background: linear-gradient(180deg, var(--accent-2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-deco-city { white-space: nowrap; }
  .hero-deco-date {
    font-family: var(--font-label);
    font-size: 0.78rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--accent-2);
  }

  @media (min-width: 900px) {
    .hero-deco-frame { inset: 30px; }
    .hero-deco h1 { letter-spacing: 0.22em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-deco-photo, .hero-deco-content > * { animation: none; }
  }
</style>
