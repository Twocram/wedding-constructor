---
import Base from '../layouts/Base.astro'
---

<Base title="Страница не найдена — saywed" description="Такой страницы нет" noindex brand>
  <main class="nf">
    <p class="eyebrow">Ошибка 404</p>
    <h1>Такой страницы нет</h1>
    <p>Если это ссылка на приглашение, проверьте адрес или попросите пару прислать её ещё раз.</p>
    <a class="btn" href="/">На главную saywed</a>
  </main>
</Base>

<style>
  .nf {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 16px;
    min-height: 100svh;
    padding: 24px;
    text-align: center;
  }
  h1 { font-size: clamp(2.2rem, 8vw, 3.2rem); line-height: 1.1; }
  .btn { padding-inline: 28px; } /* кнопка без значка-стрелки */
  .nf p:not(.eyebrow) { max-width: 36ch; color: var(--text-2); }
</style>
