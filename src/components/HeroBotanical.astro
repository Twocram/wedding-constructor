---
import HeroMedia from './HeroMedia.astro';
import ScrollHint from './ScrollHint.astro';
interface Props {
  groom: string;
  bride: string;
  date: string;
  city?: string;
  heroPhoto?: string;
  heroVideo?: string;
}
const { groom, bride, date, city, heroPhoto , heroVideo} = Astro.props;
---

<header class="hero-bt">
  <div class="bt-inner">
    <svg class="bt-sprig" viewBox="0 0 140 52" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
      <path d="M70 48 V10" />
      <path d="M70 42 C 56 40, 46 32, 44 20 C 56 22, 66 30, 70 42 Z" />
      <path d="M70 42 C 84 40, 94 32, 96 20 C 84 22, 74 30, 70 42 Z" />
      <path d="M70 28 C 60 26, 54 20, 53 12 C 61 14, 67 20, 70 28 Z" />
      <path d="M70 28 C 80 26, 86 20, 87 12 C 79 14, 73 20, 70 28 Z" />
      <path d="M70 12 C 66 8, 66 4, 70 2 C 74 4, 74 8, 70 12 Z" />
    </svg>
    <p class="bt-label">Приглашение на свадьбу</p>
    <h1>
      <span class="bt-name">{groom}</span>
      <span class="bt-amp">&</span>
      <span class="bt-name">{bride}</span>
    </h1>
    {(heroPhoto || heroVideo) && (
      <div class="bt-arch">
        <HeroMedia photo={heroPhoto} video={heroVideo} />
      </div>
    )}
    <p class="bt-date">{date}{city && ` · ${city}`}</p>
    <ScrollHint />
  </div>
</header>

<style>
  .hero-bt {
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: clamp(32px, 6vh, 56px) 24px;
    background:
      radial-gradient(90% 50% at 50% 0%, color-mix(in srgb, var(--accent-2) 14%, transparent), transparent 70%),
      var(--bg);
    text-align: center;
  }
  .bt-inner { display: grid; justify-items: center; gap: 18px; }
  .bt-inner > * { animation: bt-rise 1.1s var(--ease-out) both; }
  .bt-inner > :nth-child(1) { animation-delay: 0.1s; }
  .bt-inner > :nth-child(2) { animation-delay: 0.25s; }
  .bt-inner > :nth-child(3) { animation-delay: 0.4s; }
  .bt-inner > :nth-child(4) { animation-delay: 0.55s; }
  .bt-inner > :nth-child(5) { animation-delay: 0.7s; }
  .bt-inner > :nth-child(6) { animation-delay: 0.85s; }
  @keyframes bt-rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }

  .bt-sprig { width: 88px; color: var(--accent); opacity: 0.9; }
  .bt-label {
    font-family: var(--font-label);
    font-size: 0.64rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h1 {
    display: grid;
    justify-items: center;
    gap: 0.05em;
    font-weight: 500;
    font-size: clamp(2.6rem, 11vw, 5rem);
    line-height: 1.05;
  }
  .bt-amp { font-style: italic; font-weight: 400; font-size: 0.5em; color: var(--accent); }
  .bt-arch {
    width: min(70vw, 280px);
    aspect-ratio: 3 / 4;
    padding: 8px;
    border: 1px solid var(--line-strong);
    border-radius: 999px 999px var(--r-md) var(--r-md);
  }
  .bt-arch img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    filter: saturate(0.92);
  }
  .bt-date {
    font-family: var(--font-label);
    font-size: 0.78rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .bt-inner > * { animation: none; }
  }
</style>
