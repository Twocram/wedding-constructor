---
import HeroMedia from './HeroMedia.astro';
import ScrollHint from './ScrollHint.astro';
interface Props {
  groom: string;
  bride: string;
  date: string;
  city?: string;
  heroPhoto?: string;
  heroVideo?: string;
}
const { groom, bride, date, city, heroPhoto, heroVideo } = Astro.props;
---

<header class="hero-cq">
  <div class="cq-pearls cq-pearls--top" aria-hidden="true">
    {Array.from({ length: 9 }, () => <i />)}
  </div>

  <div class="cq-content">
    <svg class="cq-bow" viewBox="0 0 48 34" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
      <path d="M24 16C19 7 7 6 6 13s11 9 18 3Zm0 0c5-9 17-10 18-3s-11 9-18 3Z" />
      <circle cx="24" cy="16" r="2.4" />
      <path d="M22 19c-1.5 4-3.5 7.5-6 10M26 19c1.5 4 3.5 7.5 6 10" />
    </svg>
    <p class="cq-label">Приглашение на свадьбу</p>
    <h1>
      <span class="cq-name">{groom}</span>
      <span class="cq-amp">&</span>
      <span class="cq-name">{bride}</span>
    </h1>
    {(heroPhoto || heroVideo) && (
      <div class="cq-arch">
        <HeroMedia photo={heroPhoto} video={heroVideo} />
      </div>
    )}
    <p class="cq-date">
      <i aria-hidden="true"></i>{date}{city && ` · ${city}`}<i aria-hidden="true"></i>
    </p>
    <ScrollHint />
  </div>

  <div class="cq-pearls cq-pearls--bottom" aria-hidden="true">
    {Array.from({ length: 9 }, () => <i />)}
  </div>
</header>

<style>
  .hero-cq {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(48px, 8vh, 72px) 24px;
    text-align: center;
    background:
      radial-gradient(70% 45% at 15% 8%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%),
      radial-gradient(65% 45% at 88% 22%, color-mix(in srgb, var(--accent-2) 22%, transparent), transparent 60%),
      radial-gradient(80% 55% at 50% 108%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 62%),
      var(--bg);
  }

  /* жемчужная нить сверху и снизу экрана */
  .cq-pearls {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 14px;
  }
  .cq-pearls--top { top: 18px; }
  .cq-pearls--bottom { bottom: 18px; }
  .cq-pearls i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, #fff, color-mix(in srgb, var(--accent-2) 55%, #fff) 62%, color-mix(in srgb, var(--accent) 45%, transparent));
    box-shadow: 0 1px 3px rgba(67, 42, 49, 0.18);
  }
  .cq-pearls i:nth-child(even) { opacity: 0.75; }

  .cq-content { position: relative; display: grid; justify-items: center; gap: 18px; }
  .cq-content > * { animation: cq-rise 1.1s var(--ease-out) both; }
  .cq-content > :nth-child(1) { animation-delay: 0.1s; }
  .cq-content > :nth-child(2) { animation-delay: 0.25s; }
  .cq-content > :nth-child(3) { animation-delay: 0.4s; }
  .cq-content > :nth-child(4) { animation-delay: 0.55s; }
  .cq-content > :nth-child(5) { animation-delay: 0.7s; }
  .cq-content > :nth-child(6) { animation-delay: 0.85s; }
  @keyframes cq-rise {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }

  .cq-bow { width: 64px; color: var(--accent); }
  .cq-label {
    font-family: var(--font-label);
    font-size: 0.64rem;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--muted);
    padding-left: 0.42em;
  }
  h1 {
    display: grid;
    justify-items: center;
    gap: 0.06em;
    font-style: italic;
    font-size: clamp(2.6rem, 11vw, 5.4rem);
    line-height: 1.05;
  }
  .cq-amp { font-size: 0.5em; color: var(--accent); }

  /* фото в арке с «кружевным» пунктирным обрамлением */
  .cq-arch {
    width: min(56vw, 220px);
    aspect-ratio: 3 / 4;
    padding: 8px;
    border: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 999px 999px 18px 18px;
  }
  .cq-arch :is(img, video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }

  .cq-date {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-label);
    font-size: 0.74rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .cq-date i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, #fff, var(--accent-2) 65%, color-mix(in srgb, var(--accent) 50%, transparent));
  }
  @media (prefers-reduced-motion: reduce) {
    .cq-content > * { animation: none; }
  }
</style>
