---
// галерея — развороты паспорта: фото на уголках, поверх — визовые штампы, «ставятся» при появлении
import Sign from './Sign.astro';
interface Props {
  photos: string[];
  code: string;
  iata: string;
  stampDate: string; // «18.04.27»
}
const { photos, code, iata, stampDate } = Astro.props;
const spreads: (string | null)[][] = [];
for (let i = 0; i < photos.length; i += 2) spreads.push([photos[i], photos[i + 1] ?? null]);
const stampKinds = ['round', 'rect', 'oval', 'visa'] as const;
---

<section class="tk-sec pp-sec fade-up">
  <div class="tk-wrap">
    <Sign code={code} label="Паспортный контроль" en="Passport control" title="Отметки в паспорте" />

    <div class="pp-stack">
      {spreads.map((pages, s) => (
        <div class="passport" style={`--tilt:${s % 2 ? 1 : -1}`}>
          {pages.map((src, p) => {
            const n = s * 2 + p;
            const kind = stampKinds[n % stampKinds.length];
            return (
              <div class:list={['pp-page', p ? 'pp-page--r' : 'pp-page--l']}>
                <p class="pp-head" aria-hidden="true"><span>Визы</span><span>Visas</span></p>
                {src ? (
                  <figure class="pp-photo" style={`--r:${[-3, 2.5, 2, -2.5][n % 4]}deg`}>
                    <img src={src} alt={`Фото пары ${n + 1}`} loading="lazy" decoding="async" />
                  </figure>
                ) : (
                  <p class="pp-empty">Место для<br />новых штампов</p>
                )}

                <div class:list={['pp-stamp', `pp-stamp--${kind}`]} style={`--d:${n * 160}ms`} aria-hidden="true">
                  {kind === 'round' && (
                    <svg viewBox="0 0 120 120">
                      <defs><path id={`st-c-${n}`} d="M60 60 m-44 0 a44 44 0 1 1 88 0 a44 44 0 1 1 -88 0" /></defs>
                      <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="3" />
                      <circle cx="60" cy="60" r="34" fill="none" stroke="currentColor" stroke-width="1.5" />
                      <text font-size="10.5" font-weight="700" letter-spacing="2.4" fill="currentColor"><textPath href={`#st-c-${n}`}>ВЪЕЗД · ARRIVED · {iata} · ВЪЕЗД ·</textPath></text>
                      <text x="60" y="58" font-size="15" font-weight="700" text-anchor="middle" fill="currentColor">{iata}</text>
                      <text x="60" y="74" font-size="9" text-anchor="middle" fill="currentColor">{stampDate}</text>
                    </svg>
                  )}
                  {kind === 'rect' && (
                    <svg viewBox="0 0 150 90">
                      <rect x="3" y="3" width="144" height="84" rx="6" fill="none" stroke="currentColor" stroke-width="3" />
                      <rect x="10" y="10" width="130" height="70" rx="3" fill="none" stroke="currentColor" stroke-width="1.2" />
                      <text x="75" y="34" font-size="12" font-weight="700" letter-spacing="2" text-anchor="middle" fill="currentColor">ENTRY</text>
                      <text x="75" y="54" font-size="15" font-weight="700" letter-spacing="1" text-anchor="middle" fill="currentColor">РАЗРЕШЁН ♥</text>
                      <text x="75" y="70" font-size="8.5" letter-spacing="1.4" text-anchor="middle" fill="currentColor">{stampDate} · WD</text>
                    </svg>
                  )}
                  {kind === 'oval' && (
                    <svg viewBox="0 0 160 96">
                      <ellipse cx="80" cy="48" rx="76" ry="44" fill="none" stroke="currentColor" stroke-width="3" />
                      <ellipse cx="80" cy="48" rx="64" ry="33" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" />
                      <text x="80" y="44" font-size="12" font-weight="700" letter-spacing="1.5" text-anchor="middle" fill="currentColor">ЛЮБОВЬ</text>
                      <text x="80" y="60" font-size="9" letter-spacing="2.5" text-anchor="middle" fill="currentColor">БЕЗ ГРАНИЦ</text>
                    </svg>
                  )}
                  {kind === 'visa' && (
                    <svg viewBox="0 0 150 100">
                      <path d="M4 14 L14 4 H136 L146 14 V86 L136 96 H14 L4 86 Z" fill="none" stroke="currentColor" stroke-width="3" />
                      <text x="75" y="30" font-size="10" letter-spacing="3" text-anchor="middle" fill="currentColor">VISA · ВИЗА</text>
                      <line x1="18" y1="40" x2="132" y2="40" stroke="currentColor" stroke-width="1" />
                      <text x="75" y="64" font-size="18" font-weight="700" letter-spacing="1" text-anchor="middle" fill="currentColor">MARRIED</text>
                      <text x="75" y="82" font-size="9" letter-spacing="2" text-anchor="middle" fill="currentColor">СРОК: НАВСЕГДА</text>
                    </svg>
                  )}
                </div>

                <span class="pp-num" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .pp-stack { display: grid; gap: clamp(32px, 6vw, 56px); }
  /* на десктопе развороты рядом, второй чуть ниже — как брошенные на стол */
  @media (min-width: 1000px) {
    .pp-stack { grid-template-columns: repeat(2, 1fr); gap: 40px; align-items: start; }
    .pp-stack:has(> .passport:only-child) { grid-template-columns: minmax(0, 620px); justify-content: center; }
    .passport:nth-child(even) { margin-top: 72px; }
  }
  .passport {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    max-width: 880px;
    width: 100%;
    margin: 0 auto;
    padding: 6px;
    border-radius: 14px;
    /* обложка паспорта выглядывает из-под страниц */
    background: #26344a;
    box-shadow: var(--shadow);
    rotate: calc(var(--tilt) * 0.8deg);
  }
  .pp-page {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: center;
    gap: 12px;
    padding: clamp(12px, 3vw, 28px) clamp(10px, 3vw, 32px) clamp(10px, 2vw, 18px);
    min-width: 0;
    overflow: hidden;
    /* защитная сетка паспортной бумаги */
    background:
      repeating-radial-gradient(circle at 50% 120%, transparent 0 9px, rgba(44, 79, 140, 0.06) 9px 10px),
      repeating-linear-gradient(60deg, transparent 0 14px, rgba(194, 69, 45, 0.035) 14px 15px),
      #f7f1e1;
  }
  .pp-page--l { border-radius: 10px 2px 2px 10px; box-shadow: inset -18px 0 24px -18px rgba(37, 48, 60, 0.35); }
  .pp-page--r { border-radius: 2px 10px 10px 2px; box-shadow: inset 18px 0 24px -18px rgba(37, 48, 60, 0.35); }
  .pp-head {
    display: flex;
    justify-content: space-between;
    width: 100%;
    font-family: var(--font-label);
    font-size: 0.56rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(44, 79, 140, 0.6);
    border-bottom: 1px solid rgba(44, 79, 140, 0.18);
    padding-bottom: 8px;
  }
  .pp-photo {
    margin: 0;
    width: 78%;
    padding: 5px 5px 18px;
    background: #fffdf8;
    box-shadow: 0 10px 18px -10px rgba(37, 48, 60, 0.45), 0 0 0 1px rgba(37, 48, 60, 0.08);
    rotate: var(--r);
    align-self: center;
  }
  .pp-photo img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    outline: 1px solid var(--img-outline);
    outline-offset: -1px;
  }
  .pp-empty {
    align-self: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.95rem, 3vw, 1.3rem);
    text-align: center;
    color: rgba(44, 79, 140, 0.45);
  }
  .pp-num {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: rgba(44, 79, 140, 0.55);
  }
  .pp-page--l .pp-num { justify-self: start; }
  .pp-page--r .pp-num { justify-self: end; }

  /* ── штампы: чернила «впитываются» в бумагу ── */
  .pp-stamp {
    position: absolute;
    z-index: 2;
    width: clamp(78px, 20vw, 150px);
    font-family: var(--font-label);
    mix-blend-mode: multiply;
    opacity: 0.88;
    pointer-events: none;
    /* неровная прокраска штемпеля */
    -webkit-mask: radial-gradient(circle at 30% 40%, #000 55%, rgba(0, 0, 0, 0.55) 80%);
    mask: radial-gradient(circle at 30% 40%, #000 55%, rgba(0, 0, 0, 0.55) 80%);
  }
  .pp-stamp svg { display: block; width: 100%; height: auto; }
  /* штампы ложатся на край карточки и бумагу, а не в центр фото — иначе тёмный кадр «съедает» чернила */
  .pp-stamp--round { color: var(--accent); right: 2%; bottom: 4%; rotate: -14deg; }
  .pp-stamp--rect { color: #2c4f8c; left: 2%; bottom: 4%; rotate: 9deg; }
  .pp-stamp--oval { color: #3d6b4f; right: 1%; top: 9%; rotate: -8deg; }
  .pp-stamp--visa { color: #7a3b5c; left: 2%; bottom: 3%; rotate: -6deg; }

  .pp-sec:global(.visible) .pp-stamp { animation: stamp 0.55s cubic-bezier(0.3, 1.5, 0.5, 1) both; animation-delay: calc(500ms + var(--d)); }
  @keyframes stamp {
    from { opacity: 0; transform: scale(1.7); }
    60% { opacity: 0.9; }
    to { opacity: 0.88; transform: scale(1); }
  }
</style>
