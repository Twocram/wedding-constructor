# /etc/saywed/api.env — права 640, владелец root:saywed
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/saywed/saywed.db
MIGRATIONS_DIR=/opt/saywed-api/drizzle
ALLOWED_ORIGINS=https://saywed.ru,https://admin.saywed.ru
# openssl rand -hex 16
IP_SALT=
ADMIN_URL=https://admin.saywed.ru
# бот для уведомлений: @BotFather → токен; chat id — личка или общий чат с ботом
TG_BOT_TOKEN=
TG_CHAT_ID=
# api.telegram.org из РФ недоступен — воркер deploy/tg-relay: https://saywed-tg-relay.<аккаунт>.workers.dev
TG_API_URL=
# тот же ключ, что в секрете RELAY_KEY воркера: openssl rand -hex 32
TG_RELAY_KEY=
# true — имена и контакты прямо в уведомлении (передача ПД на серверы Telegram)
TG_NOTIFY_CONTACTS=false
