---
import ScrollHint from './ScrollHint.astro';
interface Props {
  groom: string;
  bride: string;
  date: string;
  heroPhoto?: string;
}
const { groom, bride, date, heroPhoto } = Astro.props;
const initials = `${groom[0]}${bride[0]}`;
const dateParts = date.split(' ');
---

<header class="hero-ed">
  <span class="hero-ed-mark" aria-hidden="true">{initials}</span>

  <div class="hero-ed-text">
    <p class="hero-ed-label">Приглашение на свадьбу</p>
    <h1>
      <span class="hero-ed-name">{groom}</span>
      <span class="hero-ed-amp">&</span>
      <span class="hero-ed-name">{bride}</span>
    </h1>
    <p class="hero-ed-date">
      {dateParts.map((part, i) => (
        <>
          {i > 0 && <i aria-hidden="true">·</i>}
          <span>{part}</span>
        </>
      ))}
    </p>
  </div>

  {heroPhoto && (
    <figure class="hero-ed-figure">
      <div class="hero-ed-arch">
        <img src={heroPhoto} alt="" fetchpriority="high" />
      </div>
    </figure>
  )}

  <div class="hero-ed-hint"><ScrollHint /></div>
</header>

<style>
  .hero-ed {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: start; /* editorial — левосторонний и на мобильном */
    gap: 0;
    padding: 72px 24px 32px;
    overflow: hidden;
    isolation: isolate;
  }
  /* водяные инициалы — огромный контур на фоне */
  .hero-ed-mark {
    position: absolute;
    left: 50%;
    top: 6%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(12rem, 52vw, 26rem);
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--text) 9%, transparent);
    z-index: -1;
    user-select: none;
    white-space: nowrap;
    animation: ed-fade 2s var(--ease-out) both;
  }
  @keyframes ed-fade { from { opacity: 0; } to { opacity: 1; } }

  .hero-ed-text { display: grid; justify-items: start; text-align: left; gap: 18px; position: relative; z-index: 2; }
  .hero-ed-label {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.36em;
    font-size: 0.66rem;
    color: var(--text-2);
    display: inline-flex;
    align-items: center;
    gap: 16px;
  }
  .hero-ed-label::before { display: none; }
  .hero-ed-label::after {
    content: '';
    width: 40px;
    height: 1px;
    background: currentColor;
    opacity: 0.4;
  }
  .hero-ed h1 { display: grid; justify-items: start; font-weight: 300; }
  .hero-ed-name {
    font-size: clamp(3.4rem, 17vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .hero-ed-amp {
    font-style: italic;
    font-size: clamp(2rem, 8vw, 3.6rem);
    color: var(--accent);
    line-height: 1;
    margin: 0.08em 0;
  }
  .hero-ed-date {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
    padding: 12px 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 0.72rem;
    color: var(--text-2);
  }
  .hero-ed-date i { color: var(--accent); font-style: normal; }

  /* фото-арка с двойной рамкой, имена слегка наезжают сверху */
  .hero-ed-figure {
    margin: -8px 0 0;
    position: relative;
    z-index: 1;
    width: min(320px, 78vw);
  }
  .hero-ed-arch {
    padding: 8px;
    border: 1px solid var(--line-strong);
    border-radius: 999px 999px 24px 24px;
    background: color-mix(in srgb, var(--text) 3%, transparent);
  }
  .hero-ed-arch img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 999px 999px 16px 16px;
    box-shadow: var(--shadow);
    animation: slowzoom 22s var(--ease-out) infinite alternate;
  }
  @keyframes slowzoom { from { transform: scale(1); } to { transform: scale(1.04); } }

  .hero-ed-hint { margin-top: 28px; color: var(--text-2); }

  .hero-ed > * { animation: ed-rise 1.1s var(--ease-out) both; }
  .hero-ed > :nth-child(2) { animation-delay: 0.1s; }
  .hero-ed > :nth-child(3) { animation-delay: 0.4s; }
  .hero-ed > :nth-child(4) { animation-delay: 0.7s; }
  @keyframes ed-rise {
    from { opacity: 0; transform: translateY(24px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  @media (min-width: 900px) {
    .hero-ed {
      grid-template-columns: 1.1fr 0.9fr;
      grid-template-areas: 'text figure' 'hint hint';
      align-items: center;
      column-gap: 48px;
      padding: 80px clamp(48px, 8vw, 140px) 40px;
      max-width: 1400px;
      margin: 0 auto;
    }
    .hero-ed-mark { left: -4%; top: 52%; transform: translateY(-50%); font-size: 26rem; }
    .hero-ed-text { grid-area: text; justify-items: start; text-align: left; }
    .hero-ed h1 { justify-items: start; }
    .hero-ed-name { font-size: clamp(5rem, 8.5vw, 8.5rem); }
    .hero-ed-figure { grid-area: figure; width: min(420px, 100%); justify-self: end; margin: 0; }
    .hero-ed-hint { grid-area: hint; justify-self: center; margin-top: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-ed-arch img, .hero-ed > *, .hero-ed-mark { animation: none; }
  }
</style>
