# локальная разработка: cp .env.example .env
PORT=3000
DATABASE_PATH=data/saywed.db
ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173
# соль для хеша IP в заявках
IP_SALT=dev-salt
# бот для уведомлений о заявках и ответах гостей; без токена заявки просто сохраняются
TG_BOT_TOKEN=
TG_CHAT_ID=
# адрес воркера-прокси deploy/tg-relay и его ключ; пусто — напрямую в api.telegram.org
TG_API_URL=
TG_RELAY_KEY=
# true — имена и контакты прямо в уведомлении (это передача ПД в Telegram)
TG_NOTIFY_CONTACTS=false
ADMIN_URL=http://localhost:5173
