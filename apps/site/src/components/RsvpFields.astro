---
// поля анкеты + отправка ответа в наш API; обёртку (секция, диалог) даёт вызывающий
import { getEntry } from 'astro:content'

interface Props {
  drinks?: string[] // чекбоксы напитков
  plusOne?: boolean // чекбокс «приду с парой»
}
const { drinks, plusOne } = Astro.props
const slug = Astro.params.slug ?? ''
const isDemo = Boolean((await getEntry('invitations', slug))?.data.demo);
---

<div class="plate rsvp-plate">
  <form id="rsvp-form" class="plate-inner" novalidate data-slug={slug} data-demo={String(isDemo)}>
    <fieldset class="field">
      <span>Сможете ли вы присутствовать?</span>
      <div class="choice-group">
        <label class="choice">
          <input type="radio" name="attending" value="yes" required />
          <strong>Да, я буду</strong>
          <small>Ждём вас в этот день</small>
        </label>
        <label class="choice">
          <input type="radio" name="attending" value="no" />
          <strong>К сожалению, не смогу</strong>
          <small>Мы всё равно вас любим</small>
        </label>
      </div>
    </fieldset>
    <label class="field">
      <span>Имя и фамилия</span>
      <input name="name" type="text" required minlength="2" maxlength="80" autocomplete="name" placeholder="Как к вам обращаться" data-guest-value />
    </label>
    {drinks && drinks.length > 0 && (
      <fieldset class="field">
        <span>Что будете пить?</span>
        <div class="checks">
          {drinks.map(d => (
            <label class="check">
              <input type="checkbox" name="drinks" value={d} />
              <i aria-hidden="true"></i>
              {d}
            </label>
          ))}
        </div>
      </fieldset>
    )}
    {plusOne && (
      <label class="check check--line">
        <input type="checkbox" name="plusOne" value="да" />
        <i aria-hidden="true"></i>
        Приду не один(одна)
      </label>
    )}
    <label class="field">
      <span>Пожелания, аллергии</span>
      <textarea name="notes" rows="3" maxlength="1000" placeholder="Предпочтения по еде, музыке — всё, что нам стоит знать"></textarea>
    </label>
    <input class="rsvp-hp" type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button type="submit" class="btn btn--block">
      Отправить ответ
      <span class="btn-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
      </span>
    </button>
    <p class="form-status" role="status"></p>
  </form>
</div>

<script>
const form = document.querySelector<HTMLFormElement>('#rsvp-form')
form?.addEventListener('submit', async (e) => {
  e.preventDefault()
  const status = form.querySelector<HTMLElement>('.form-status')!
  if (!form.reportValidity()) {
    status.textContent = 'Заполните имя и выберите ответ.'
    return
  }
  // в демо ответ никуда не уходит: показываем, как анкета работает в настоящем приглашении
  if (form.dataset.demo === 'true') {
    status.textContent = 'Это демо. В вашем приглашении ответ гостя сразу появится в списке ответов.'
    form.reset()
    return
  }
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!
  const data = new FormData(form)
  const text = (key: string) => String(data.get(key) ?? '').trim() || undefined
  button.disabled = true
  status.textContent = 'Отправляем…'
  try {
    const res = await fetch('/api/public/rsvp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        slug: form.dataset.slug,
        name: text('name'),
        attending: text('attending'),
        drinks: data.getAll('drinks').map(String),
        plusOne: data.has('plusOne'),
        notes: text('notes'),
        // имя из именной ссылки: паре видно, по чьей ссылке ответили
        guest: new URLSearchParams(location.search).get('g') || undefined,
        hp: text('hp'),
      }),
    })
    if (res.ok) {
      status.textContent = 'Спасибо! Ваш ответ получен.'
      form.reset()
    }
    else if (res.status === 422) {
      const body = await res.json().catch(() => ({})) as { errors?: { fieldErrors?: Record<string, string[]> } }
      const messages = Object.values(body.errors?.fieldErrors ?? {}).flat()
      status.textContent = messages.length ? messages.join('. ') : 'Проверьте ответы в анкете.'
    }
    else if (res.status === 404) {
      status.textContent = 'Анкета пока не принимает ответы. Пожалуйста, напишите паре напрямую.'
    }
    else if (res.status === 429) {
      status.textContent = 'Слишком много попыток. Попробуйте чуть позже.'
    }
    else {
      throw new Error(String(res.status))
    }
  }
  catch {
    status.textContent = 'Не удалось отправить. Попробуйте ещё раз.'
  }
  finally {
    button.disabled = false
  }
})
</script>

<style>
  .rsvp-plate { text-align: left; }
  .rsvp-plate form { display: grid; gap: 22px; }
  .rsvp-plate fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .rsvp-plate .btn { margin-top: 6px; }
  .rsvp-plate .form-status { margin-top: -10px; }
  .rsvp-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  /* чекбоксы-пилюли в стиле плиток выбора */
  .checks { display: flex; flex-wrap: wrap; gap: 8px; }
  .check {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.4s var(--ease), background-color 0.4s var(--ease);
  }
  .check input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .check i {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition: background-color 0.4s var(--ease), border-color 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .check:hover { border-color: var(--line-strong); }
  .check:has(:checked) { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, transparent); }
  .check:has(:checked) i { background: var(--accent); border-color: var(--accent); box-shadow: inset 0 0 0 3px var(--bg); }
  .check:has(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; }
  .check--line { width: fit-content; }
</style>
