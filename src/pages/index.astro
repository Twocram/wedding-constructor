---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const invitations = await getCollection('invitations');
const themeNames: Record<string, string> = {
  cover: 'Cover — классика',
  editorial: 'Editorial — минимализм',
  amalfi: 'Amalfi — вечер у моря',
  deco: 'Deco — ар-деко',
  ticket: 'Ticket — посадочный талон',
  cinema: 'Cinema — кино одним экраном',
};
---

<Base title="Wedding Constructor — свадебные приглашения">
  <main class="section">
    <div class="wrap wrap--narrow index">
      <p class="eyebrow">Wedding Constructor</p>
      <h1>Свадебное приглашение за несколько минут</h1>
      <p class="index-sub">Выберите стиль — персонализируйте имена, дату, фотографии, программу и RSVP.</p>
      <ul>
        {invitations.map((inv) => (
          <li>
            <a href={`/${inv.id}`} class="plate">
              <span class="plate-inner">
                <small>{themeNames[inv.data.theme] ?? inv.data.theme}</small>
                <strong>{inv.data.groom} &amp; {inv.data.bride}</strong>
                <span class="index-cta">Посмотреть демо →</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Base>

<style>
  .index { display: grid; justify-items: center; gap: 18px; text-align: center; }
  .index-sub { max-width: 40ch; }
  .index ul { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 14px; width: 100%; }
  .index a { display: block; text-decoration: none; transition: transform 0.4s var(--ease); }
  .index a:hover { transform: translateY(-2px); }
  .index .plate-inner { display: grid; gap: 6px; text-align: center; }
  .index strong { font-family: var(--font-display); font-size: 1.4rem; font-weight: 400; }
  .index small { color: var(--accent); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; }
  .index-cta { margin-top: 6px; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
</style>
