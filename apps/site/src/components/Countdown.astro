---
interface Props {
  target: string; // ISO-дата
}
const { target } = Astro.props;
---

<section class="section countdown fade-up" data-target={target}>
  <div class="wrap">
    <p class="eyebrow">до свадьбы осталось</p>
    <div class="countdown-grid">
      <div><span data-unit="days">–</span><small data-word="days">дней</small></div>
      <div><span data-unit="hours">–</span><small data-word="hours">часов</small></div>
      <div><span data-unit="minutes">–</span><small data-word="minutes">минут</small></div>
      <div><span data-unit="seconds">–</span><small data-word="seconds">секунд</small></div>
    </div>
    {Astro.slots.has('default') && <div class="countdown-extra"><slot /></div>}
  </div>
</section>

<script>
  import { pluralRu } from '../lib/plural';

  document.querySelectorAll<HTMLElement>('.countdown').forEach((el) => {
    const target = new Date(el.dataset.target ?? '').getTime();
    if (Number.isNaN(target)) return;
    const q = (u: string) => el.querySelector(`[data-unit="${u}"]`)!;
    const w = (u: string) => el.querySelector(`[data-word="${u}"]`);
    const forms: Record<string, [string, string, string]> = {
      days: ['день', 'дня', 'дней'],
      hours: ['час', 'часа', 'часов'],
      minutes: ['минута', 'минуты', 'минут'],
      seconds: ['секунда', 'секунды', 'секунд'],
    };
    const units = { days: q('days'), hours: q('hours'), minutes: q('minutes'), seconds: q('seconds') };
    const set = (u: string, n: number) => {
      const label = w(u);
      if (label) label.textContent = pluralRu(n, forms[u]);
      return n;
    };
    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      units.days.textContent = String(set('days', Math.floor(diff / 864e5)));
      units.hours.textContent = String(set('hours', Math.floor(diff / 36e5) % 24)).padStart(2, '0');
      units.minutes.textContent = String(set('minutes', Math.floor(diff / 6e4) % 60)).padStart(2, '0');
      units.seconds.textContent = String(set('seconds', Math.floor(diff / 1e3) % 60)).padStart(2, '0');
    };
    tick();
    setInterval(tick, 1000);
  });
</script>

<style>
  .countdown { padding-top: clamp(56px, 9vw, 96px); padding-bottom: clamp(56px, 9vw, 96px); }
  .countdown-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: 28px;
  }
  .countdown-extra { margin-top: 32px; }
  .countdown-grid div {
    display: grid;
    gap: 2px;
    padding: 8px 4px;
    position: relative;
  }
  /* волосяные разделители вместо коробок */
  .countdown-grid div + div::before {
    content: '';
    position: absolute;
    left: 0;
    top: 18%;
    height: 64%;
    width: 1px;
    background: var(--line-strong);
  }
  .countdown-grid span {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 10vw, 4rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }
  .countdown-grid small {
    font-family: var(--font-label);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  @media (max-width: 420px) {
    /* «секунды» в верхнем регистре с трекингом шире карточки — сжимаем, чтобы не резалось */
    .countdown-grid small { font-size: 0.58rem; letter-spacing: 0.13em; }
  }
  :global(body[data-theme='amalfi']) .countdown-grid span { color: var(--accent-2); }
  :global(body[data-theme='editorial']) .countdown-grid span { font-weight: 300; }
</style>
