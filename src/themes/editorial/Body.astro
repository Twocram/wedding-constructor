---
// editorial — приглашение свёрстано как свадебный выпуск журнала: выходные данные, оглавление, рубрики с номерами полос
import type { Props } from '../../components/ClassicBody.astro';
import RsvpFields from '../../components/RsvpFields.astro';
import SectionHead from './SectionHead.astro';
import StyleNotes from './StyleNotes.astro';

const { inv, slug, cal } = Astro.props as Props;

// «12 сентября 2027» → «Сентябрь 2027» для выходных данных номера
const monthNames: Record<string, string> = {
  января: 'Январь', февраля: 'Февраль', марта: 'Март', апреля: 'Апрель', мая: 'Май', июня: 'Июнь',
  июля: 'Июль', августа: 'Август', сентября: 'Сентябрь', октября: 'Октябрь', ноября: 'Ноябрь', декабря: 'Декабрь',
};
const dateWords = inv.date.toLowerCase().split(/\s+/);
const month = dateWords.map((w) => monthNames[w]).find(Boolean);
const year = inv.date.match(/\d{4}/)?.[0];
const issueDate = [month, year].filter(Boolean).join(' ') || inv.date;
const couple = `${inv.groom} & ${inv.bride}`;

const hasInfo = Boolean(inv.transfer || inv.telegramChat || inv.organizer);
// рубрики нумеруются по факту: пустые секции не оставляют дыр в оглавлении
const chapters = [
  inv.welcome && { id: 'ed-letter', label: 'Письмо' },
  inv.gallery?.length && { id: 'ed-gallery', label: 'Фоторепортаж' },
  inv.venue && { id: 'ed-venue', label: 'Место' },
  inv.timeline?.length && { id: 'ed-program', label: 'Программа' },
  inv.dressCode && { id: 'ed-style', label: 'Стиль' },
  inv.wishes?.length && { id: 'ed-wishes', label: 'Просьбы' },
  hasInfo && { id: 'ed-info', label: 'Полезное' },
  inv.rsvp && { id: 'ed-reply', label: 'Ответ' },
].filter(Boolean) as { id: string; label: string }[];
const folio = (id: string) => String(chapters.findIndex((c) => c.id === id) + 1).padStart(2, '0');

// вынос-цитата — первая фраза письма, как в журнальной колонке; у одной фразы выноса нет
const sentences = inv.welcome?.split(/(?<=[.!?…])\s+/).filter(Boolean) ?? [];
const pullQuote = sentences.length > 1 ? sentences[0] : null;

// строка под счётчиком: «суббота, 18 сентября 2027 · 15:30»; время «плавающее», как в календаре
const countStart = inv.countdown ? new Date(`${inv.countdown.slice(0, 19)}Z`) : null;
const countValid = countStart && !Number.isNaN(countStart.getTime());
const weekday = countValid ? countStart.toLocaleDateString('ru-RU', { weekday: 'long', timeZone: 'UTC' }) : '';
const startTime = countValid ? inv.countdown!.slice(11, 16) : '';

const captions = ['Кадр из нашей истории', 'Из семейного архива', 'Мгновение вдвоём', 'Между кадрами', 'Где-то по дороге'];

const routeUrl = inv.venue
  ? `https://yandex.ru/maps/?text=${encodeURIComponent(`${inv.venue.name}, ${inv.venue.address}`)}`
  : '';
const arrow = 'M3 8h10M9 4l4 4-4 4';
---

<main id="content" class="ed">
  {/* выходные данные номера — полоса-шапка, как над обложкой журнала */}
  <div class="ed-mast fade-up">
    <div class="ed-wrap ed-mast-row">
      <span>Выпуск № 1</span>
      <span class="ed-mast-title">Свадебный номер</span>
      <span>{issueDate}</span>
    </div>
  </div>

  {chapters.length > 1 && (
    <nav class="ed-wrap ed-contents" aria-label="В этом номере">
      <p class="ed-contents-title fade-up">В этом <i>номере</i></p>
      <ol class="ed-contents-list">
        {chapters.map((c, i) => (
          <li class="fade-up" style={`--i:${i}`}>
            <a href={`#${c.id}`}>
              <span class="ed-contents-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="ed-contents-label">{c.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )}

  {inv.welcome && (
    <section id="ed-letter" class="ed-sec" aria-labelledby="ed-letter-h">
      <div class="ed-wrap">
        <SectionHead num={folio('ed-letter')} label="Письмо" running={couple} />
      </div>
      <div class="ed-wrap ed-split">
        <div class="ed-split-aside">
          <p class="ed-kicker fade-up" data-guest="{g}, ждём вас">Дорогие гости</p>
          <h2 id="ed-letter-h" class="ed-h2 fade-up">Слово <i>от нас двоих</i></h2>
          {pullQuote && (
            <blockquote class="ed-pull fade-up" aria-hidden="true">
              <p>{pullQuote}</p>
            </blockquote>
          )}
        </div>
        <div class="ed-split-main">
          <p class="ed-letter fade-up">{inv.welcome}</p>
          <p class="ed-sign fade-up">
            <span>С любовью,</span>
            <span class="ed-sign-names">— {inv.groom} <i>&</i> {inv.bride}</span>
          </p>
        </div>
      </div>
    </section>
  )}

  {inv.countdown && countValid && (
    <section class="ed-count" data-target={inv.countdown} aria-label="Обратный отсчёт до свадьбы">
      <div class="ed-wrap ed-count-grid">
        <p class="ed-count-kicker fade-up">Обратный отсчёт</p>
        <p class="ed-count-big fade-up">
          <span class="ed-count-days" data-unit="days">—</span>
          <span class="ed-count-word" data-word="days">дней</span>
        </p>
        <div class="ed-count-side fade-up" style="--i:1">
          <p class="ed-count-line">
            до свадьбы — и ещё <span data-unit="hours">–</span> <span data-word="hours">часов</span>,
            <span data-unit="minutes">–</span> <span data-word="minutes">минут</span>
            и <span data-unit="seconds">–</span> <span data-word="seconds">секунд</span>
          </p>
          <p class="ed-count-when">
            <span>{weekday}</span><i aria-hidden="true">·</i><span>{inv.date}</span><i aria-hidden="true">·</i><span>{startTime}</span>
          </p>
          {cal && (
            <div class="ed-cal">
              <span class="ed-cal-caption">Добавить в календарь</span>
              <a href={`/ics/${slug}.ics`}>Apple / Outlook</a>
              <a href={cal.google} target="_blank" rel="noopener">Google</a>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {inv.gallery && inv.gallery.length > 0 && (
    <section id="ed-gallery" class="ed-sec" aria-labelledby="ed-gallery-h">
      <div class="ed-wrap">
        <SectionHead num={folio('ed-gallery')} label="Фоторепортаж" running={couple} />
        <div class="ed-gallery-head">
          <h2 id="ed-gallery-h" class="ed-h2 fade-up">Несколько <i>кадров</i></h2>
          <p class="ed-standfirst fade-up" style="--i:1">Страницы из нашего семейного альбома — до того, как в нём появится главная глава.</p>
        </div>
        <div class="ed-spread">
          {inv.gallery.map((src, i) => (
            <figure class="ed-shot fade-up">
              <div class="ed-shot-frame">
                <img src={src} alt={`${couple}: ${captions[i % captions.length].toLowerCase()}`} loading="lazy" decoding="async" />
              </div>
              <figcaption>
                <span class="ed-shot-num">Фото {i + 1}</span>
                <span>{captions[i % captions.length]}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <p class="ed-credit fade-up">Фото: личный архив пары</p>
      </div>
    </section>
  )}

  {inv.venue && (
    <section id="ed-venue" class="ed-sec" aria-labelledby="ed-venue-h">
      <div class="ed-wrap">
        <SectionHead num={folio('ed-venue')} label="Место" running={couple} />
        <div class={`ed-venue ${inv.venue.mapIframe ? 'ed-venue--map' : ''}`}>
          <div class="ed-venue-text">
            <p class="ed-kicker fade-up">Место встречи</p>
            <h2 id="ed-venue-h" class="ed-h2 ed-venue-name fade-up">{inv.venue.name}</h2>
            <dl class="ed-venue-facts fade-up" style="--i:1">
              <div><dt>Адрес</dt><dd>{inv.venue.address}</dd></div>
              {inv.city && <div><dt>Город</dt><dd>{inv.city}</dd></div>}
              {startTime && <div><dt>Начало</dt><dd>{startTime}</dd></div>}
            </dl>
            <a class="ed-link fade-up" style="--i:2" href={routeUrl} target="_blank" rel="noopener">
              Проложить маршрут
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d={arrow} /></svg>
            </a>
          </div>
          {inv.venue.mapIframe && (
            <figure class="ed-map fade-up" style="--i:1">
              <div class="ed-map-frame">
                <iframe src={inv.venue.mapIframe} title={`Карта: ${inv.venue.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
              </div>
              <figcaption><span class="ed-shot-num">Рис. 1</span><span>Схема проезда</span></figcaption>
            </figure>
          )}
        </div>
      </div>
    </section>
  )}

  {inv.timeline && inv.timeline.length > 0 && (
    <section id="ed-program" class="ed-sec" aria-labelledby="ed-program-h">
      <div class="ed-wrap">
        <SectionHead num={folio('ed-program')} label="Программа" running={couple} />
      </div>
      <div class="ed-wrap ed-split">
        <div class="ed-split-aside">
          <h2 id="ed-program-h" class="ed-h2 fade-up">Содержание <i>вечера</i></h2>
          <p class="ed-standfirst fade-up" style="--i:1">Время ориентировочное — главное, чтобы вам было хорошо.</p>
        </div>
        <ol class="ed-split-main ed-toc">
          {inv.timeline.map((item, i) => (
            <li class="ed-toc-row fade-up" style={`--i:${i}`}>
              <div class="ed-toc-line">
                <span class="ed-toc-title">{item.title}</span>
                <span class="ed-toc-dots" aria-hidden="true"></span>
                <time class="ed-toc-time">{item.time}</time>
              </div>
              {item.text && <p class="ed-toc-text">{item.text}</p>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {inv.dressCode && (
    <section id="ed-style" class="ed-sec" aria-labelledby="ed-style-h">
      <div class="ed-wrap">
        <SectionHead num={folio('ed-style')} label="Стиль" running={couple} />
        <StyleNotes text={inv.dressCode.text} colors={inv.dressCode.colors} headingId="ed-style-h" />
      </div>
    </section>
  )}

  {inv.wishes && inv.wishes.length > 0 && (
    <section id="ed-wishes" class="ed-sec" aria-labelledby="ed-wishes-h">
      <div class="ed-wrap">
        <SectionHead num={folio('ed-wishes')} label="Просьбы" running={couple} />
        <h2 id="ed-wishes-h" class="ed-h2 fade-up">Несколько <i>просьб</i></h2>
        <ol class="ed-quotes">
          {inv.wishes.map((wish, i) => (
            <li class="ed-quote fade-up">
              <span class="ed-quote-num">№ {String(i + 1).padStart(2, '0')}</span>
              <span class="ed-quote-mark" aria-hidden="true">“</span>
              <p>{wish}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {hasInfo && (
    <section id="ed-info" class="ed-sec" aria-labelledby="ed-info-h">
      <div class="ed-wrap">
        <SectionHead num={folio('ed-info')} label="Полезное" running={couple} />
        <h2 id="ed-info-h" class="ed-h2 fade-up">На <i>полях</i></h2>
        <div class="ed-boxes">
          {inv.transfer && (
            <article class="ed-box fade-up">
              <h3>Трансфер</h3>
              <p>{inv.transfer}</p>
            </article>
          )}
          {inv.telegramChat && (
            <article class="ed-box fade-up" style="--i:1">
              <h3>Чат гостей</h3>
              <p>{inv.telegramChat.text}</p>
              <a class="ed-link" href={inv.telegramChat.url} target="_blank" rel="noopener">
                Открыть в Telegram
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d={arrow} /></svg>
              </a>
            </article>
          )}
          {inv.organizer && (
            <article class="ed-box fade-up" style="--i:2">
              <h3>Организатор</h3>
              <p>По всем вопросам дня — к нашему координатору.</p>
              <p class="ed-box-name">{inv.organizer.name}</p>
              <a class="ed-link" href={`tel:${inv.organizer.phone.replace(/[^\d+]/g, '')}`}>{inv.organizer.phone}</a>
            </article>
          )}
        </div>
      </div>
    </section>
  )}

  {inv.rsvp && (
    <section id="ed-reply" class="ed-sec ed-sec--last" aria-labelledby="ed-reply-h">
      <div class="ed-wrap">
        <SectionHead num={folio('ed-reply')} label="Ответ" running={couple} />
        <div class="ed-reply">
          <div class="ed-reply-intro">
            <h2 id="ed-reply-h" class="ed-h2 fade-up">Будете <i>с нами?</i></h2>
            <p class="ed-standfirst fade-up" style="--i:1">
              Заполните купон и отправьте его нам — это займёт минуту. Просим ответить до <strong>{inv.rsvp.deadline}</strong>.
            </p>
          </div>
          {/* купон с линией отреза, как в журнальной подписке */}
          <div class="ed-coupon fade-up" style="--i:1">
            <svg class="ed-coupon-cut" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true">
              <circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M20 4 8.1 15.9M14.5 14.5 20 20M8.1 8.1 12 12" />
            </svg>
            <div class="ed-coupon-head">
              <span>Ответный купон</span>
              <span>до {inv.rsvp.deadline}</span>
            </div>
            <RsvpFields />
          </div>
        </div>
      </div>
    </section>
  )}
</main>

<script>
  // обратный отсчёт с согласованием слов: «1 день», «3 дня», «11 дней»
  document.querySelectorAll<HTMLElement>('.ed .ed-count').forEach((root) => {
    const target = new Date(root.dataset.target ?? '').getTime();
    if (Number.isNaN(target)) return;
    const rules = new Intl.PluralRules('ru-RU');
    const forms: Record<string, [string, string, string]> = {
      days: ['день', 'дня', 'дней'],
      hours: ['час', 'часа', 'часов'],
      minutes: ['минута', 'минуты', 'минут'],
      seconds: ['секунда', 'секунды', 'секунд'],
    };
    const word = (n: number, [one, few, many]: [string, string, string]) => {
      const rule = rules.select(n);
      return rule === 'one' ? one : rule === 'few' ? few : many;
    };
    const set = (unit: string, n: number) => {
      const num = root.querySelector(`[data-unit="${unit}"]`);
      const label = root.querySelector(`[data-word="${unit}"]`);
      if (num) num.textContent = String(n);
      if (label) label.textContent = word(n, forms[unit]);
    };
    const tick = () => {
      const diff = Math.max(0, target - Date.now());
      set('days', Math.floor(diff / 864e5));
      set('hours', Math.floor(diff / 36e5) % 24);
      set('minutes', Math.floor(diff / 6e4) % 60);
      set('seconds', Math.floor(diff / 1e3) % 60);
    };
    tick();
    setInterval(tick, 1000);
  });
</script>

<style>
  .ed {
    --ed-gutter: clamp(24px, 6vw, 88px);
    --ed-paper-hi: color-mix(in srgb, #fff 45%, var(--bg));
    --ed-rule: 1px solid var(--line-strong);
    display: block;
    padding-bottom: clamp(24px, 4vw, 48px);
  }
  .ed-wrap {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--ed-gutter);
  }

  /* ── выходные данные ── */
  .ed-mast {
    border-top: 1px solid var(--text);
    border-bottom: var(--ed-rule);
    /* двойная линейка сверху, как у газетной шапки */
    box-shadow: inset 0 3px 0 var(--bg), inset 0 4px 0 var(--line-strong);
  }
  .ed-mast-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
    padding-bottom: 12px;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .ed-mast-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--text);
    display: none;
  }

  /* ── оглавление номера ── */
  .ed-contents {
    display: grid;
    gap: 20px;
    padding-top: clamp(40px, 7vw, 72px);
    padding-bottom: clamp(24px, 4vw, 40px);
  }
  .ed-contents-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.6rem;
    line-height: 1;
  }
  .ed-contents-title i { color: var(--accent); }
  .ed-contents-list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 20px;
  }
  .ed-contents-list a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }
  .ed-contents-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .ed-contents-label {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .ed-contents-list a:hover { color: var(--accent); }

  /* ── общие элементы полосы ── */
  .ed-sec {
    padding: clamp(72px, 13vw, 150px) 0 0;
    scroll-margin-top: 24px;
  }
  .ed-sec--last { padding-bottom: clamp(72px, 12vw, 140px); }

  .ed-kicker {
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .ed-h2 {
    font-weight: 300;
    font-size: clamp(2.7rem, 11vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .ed-h2 i { font-style: italic; color: var(--accent); }
  .ed-standfirst {
    margin-top: 20px;
    max-width: 34ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 3.8vw, 1.4rem);
    line-height: 1.45;
    color: var(--text-2);
  }
  .ed-standfirst strong { font-style: normal; font-weight: 500; color: var(--text); }

  .ed-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0;
    font-family: var(--font-label);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text);
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
    transition: background-size 0.5s var(--ease), color 0.3s var(--ease);
  }
  .ed-link svg { width: 16px; height: 16px; transition: transform 0.5s var(--ease); }
  .ed-link:hover { color: var(--accent); }
  .ed-link:hover svg { transform: translateX(4px); }

  /* текст слева, основная колонка справа — асимметрия журнальной полосы */
  .ed-split { display: grid; gap: 36px; }

  /* ── письмо ── */
  .ed-letter {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 4.4vw, 1.6rem);
    line-height: 1.55;
    color: var(--text);
    max-width: 36ch;
  }
  /* буквица */
  .ed-letter::first-letter {
    float: left;
    font-weight: 300;
    font-size: 4.6em;
    line-height: 0.8;
    padding: 0.05em 0.1em 0 0;
    color: var(--accent);
  }
  .ed-pull {
    display: none;
    margin: 32px 0 0;
    padding: 20px 0 0;
    border-top: var(--ed-rule);
    max-width: 22ch;
  }
  .ed-pull p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.45rem, 5vw, 1.9rem);
    line-height: 1.25;
    color: var(--text-2);
  }
  .ed-pull p::before { content: '«'; }
  .ed-pull p::after { content: '»'; }
  .ed-sign {
    display: grid;
    gap: 4px;
    margin-top: 32px;
  }
  .ed-sign > span:first-child {
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ed-sign-names {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.6rem, 5.4vw, 2.1rem);
    line-height: 1.2;
  }
  .ed-sign-names i { color: var(--accent); }

  /* ── обратный отсчёт: единственная тёмная полоса номера ── */
  .ed-count {
