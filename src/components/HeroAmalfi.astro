---
import ScrollHint from './ScrollHint.astro';
interface Props {
  groom: string;
  bride: string;
  date: string;
  heroPhoto?: string;
  countdown?: string;
}
const { groom, bride, date, heroPhoto, countdown } = Astro.props;

// луна с реальной фазой на ночь свадьбы: считается на билде по ISO-дате countdown
let moonPath: string | null = null;
if (countdown) {
  const synodic = 29.530588853;
  const epoch = Date.UTC(2000, 0, 6, 18, 14); // известное новолуние
  const days = (new Date(countdown).getTime() - epoch) / 86400000;
  const p = (((days % synodic) + synodic) % synodic) / synodic;
  const c = 30, r = 26;
  const t = Math.cos(2 * Math.PI * p);
  const rx = (Math.abs(t) * r).toFixed(2);
  // освещённая область: внешний полукруг + дуга-терминатор
  moonPath = `M ${c} ${c - r} A ${r} ${r} 0 0 ${p < 0.5 ? 1 : 0} ${c} ${c + r} A ${rx} ${r} 0 0 ${t > 0 ? 0 : 1} ${c} ${c - r}`;
}
// детерминированный псевдорандом (SSR-стабильный): 42 звезды вместо россыпи nth-child
const rand = (seed: number) => {
  const x = Math.sin(seed * 127.1) * 43758.5453;
  return x - Math.floor(x);
};
const stars = Array.from({ length: 42 }, (_, i) => ({
  left: (rand(i * 3 + 1) * 94 + 3).toFixed(1),
  top: (rand(i * 3 + 2) * 88 + 4).toFixed(1),
  d: (2.2 + rand(i * 3 + 3) * 1.8).toFixed(1),
  delay: (rand(i * 7 + 4) * 2.2).toFixed(1),
  big: i % 3 === 0,
}));
---

<header class="hero-am">
  <div class="stars" aria-hidden="true">
    {stars.map((s) => (
      <i class:list={[{ big: s.big }]} style={`left:${s.left}%;top:${s.top}%;--d:${s.d}s;animation-delay:${s.delay}s`} />
    ))}
  </div>
  {moonPath && (
    <svg class="moon" viewBox="0 0 60 60" role="img" aria-label="Луна в ночь свадьбы">
      <title>Такой будет луна в ночь свадьбы</title>
      <circle cx="30" cy="30" r="26" fill="#17293d" stroke="rgba(232,201,135,0.25)" stroke-width="1" />
      <path d={moonPath} fill="#f0e6cd" />
    </svg>
  )}
  <b class="shooting" aria-hidden="true"></b>
  <div class="hero-am-glow" aria-hidden="true"></div>

  <div class="hero-am-text">
    <p class="hero-am-date">{date}</p>
    <h1>
      <span class="hero-am-name">{groom}</span>
      <span class="hero-am-amp">&</span>
      <span class="hero-am-name">{bride}</span>
    </h1>
    <p class="hero-am-label"><span>приглашают вас</span><span>на свадьбу у моря</span></p>
  </div>

  {heroPhoto && (
    <figure class="hero-am-figure">
      <div class="hero-am-frame">
        <img src={heroPhoto} alt="" fetchpriority="high" />
      </div>
    </figure>
  )}

  <div class="hero-am-hint"><ScrollHint /></div>
</header>

<style>
  .hero-am {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-content: center;
    justify-items: center;
    padding: 72px 24px 32px;
    overflow: hidden;
    isolation: isolate;
  }
  /* свечение горизонта */
  .hero-am-glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* линейная подсветка горизонта: никаких дуг и пятен на широких экранах */
    background:
      linear-gradient(to top, rgba(210, 165, 82, 0.10), transparent 42%),
      linear-gradient(to top, rgba(80, 130, 180, 0.08), transparent 30%);
  }

  .hero-am-text { display: grid; justify-items: center; text-align: center; gap: 20px; }
  .hero-am-date {
    font-family: var(--font-label);
    letter-spacing: 0.42em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--accent);
  }
  .hero-am h1 { display: grid; justify-items: center; }
  .hero-am-name {
    font-size: clamp(2.8rem, 13vw, 6rem);
    line-height: 1.05;
    letter-spacing: 0.02em;
    background: linear-gradient(180deg, #f3ecdf 0%, #ece5d8 55%, #c9bfae 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-am-amp {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: clamp(2rem, 8vw, 3.4rem);
    line-height: 1;
    margin: 0.1em 0;
    background: linear-gradient(180deg, var(--accent-2), var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-am-label {
    display: grid;
    gap: 4px;
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 0.66rem;
    color: var(--text-2);
  }

  /* портретная арка в двойной золотой рамке */
  .hero-am-figure { margin: 36px 0 0; width: min(300px, 74vw); }
  .hero-am-frame {
    position: relative;
    padding: 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: 999px 999px 26px 26px;
    background: linear-gradient(180deg, rgba(210, 165, 82, 0.08), transparent);
  }
  .hero-am-frame::before {
    content: '';
    position: absolute;
    inset: 4px;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 999px 999px 22px 22px;
    pointer-events: none;
  }
  .hero-am-frame img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 999px 999px 16px 16px;
    box-shadow: var(--shadow), 0 0 0 1px rgba(255, 255, 255, 0.05);
    filter: saturate(0.9) contrast(1.04);
    animation: am-zoom 24s var(--ease-out) infinite alternate;
  }
  @keyframes am-zoom { from { transform: scale(1); } to { transform: scale(1.05); } }

  .hero-am-hint { margin-top: 32px; color: var(--accent); }

  .stars { position: absolute; inset: 0; pointer-events: none; z-index: -1; }
  .stars i {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px 1px rgba(255, 255, 255, 0.5);
    animation: twinkle var(--d, 3s) ease-in-out infinite;
    opacity: 0;
  }
  .stars i.big { background: var(--accent-2); box-shadow: 0 0 8px 2px rgba(232, 201, 135, 0.5); width: 3px; height: 3px; }
  @keyframes twinkle {
    0%, 100% { opacity: 0; transform: scale(0.6); }
    50% { opacity: 0.9; transform: scale(1); }
  }

  /* луна с фазой дня свадьбы */
  .moon {
    position: absolute;
    top: 9%;
    right: 10%;
    z-index: -1;
    width: clamp(44px, 9vw, 64px);
    filter: drop-shadow(0 0 16px rgba(240, 230, 205, 0.35));
  }

  /* редкая падающая звезда */
  .shooting {
    position: absolute;
    top: 20%;
    left: 80%;
    z-index: -1;
    width: 130px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.9), transparent);
    transform: rotate(148deg);
    opacity: 0;
    animation: shoot 11s linear infinite;
  }
  @keyframes shoot {
    0% { opacity: 0; transform: rotate(148deg) translateX(0); }
    1.5% { opacity: 1; }
    8%, 100% { opacity: 0; transform: rotate(148deg) translateX(360px); }
  }

  .hero-am > :not(.stars):not(.hero-am-glow) { animation: am-rise 1.1s var(--ease-out) both; }
  .hero-am-figure { animation-delay: 0.35s !important; }
  .hero-am-hint { animation-delay: 0.7s !important; }
  @keyframes am-rise {
    from { opacity: 0; transform: translateY(24px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  @media (min-width: 900px) {
    .hero-am {
      /* колонки-распорки по краям вместо max-width на header: иначе свечение-фон обрезается по бокам */
      grid-template-columns: 1fr minmax(0, 560px) minmax(0, 560px) 1fr;
      grid-template-areas: '. text figure .' '. hint hint .';
      align-items: center;
      column-gap: 64px;
      padding: 80px clamp(48px, 8vw, 140px) 40px;
    }
    .hero-am-text { grid-area: text; justify-items: start; text-align: left; }
    .hero-am h1 { justify-items: start; }
    .hero-am-name { font-size: clamp(4rem, 7vw, 7rem); }
    .hero-am-label { text-align: left; }
    .hero-am-figure { grid-area: figure; width: min(400px, 100%); justify-self: end; margin: 0; }
    .hero-am-hint { grid-area: hint; justify-self: center; margin-top: 48px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stars, .shooting { display: none; }
    .hero-am > *, .hero-am-frame img { animation: none !important; }
  }
</style>
