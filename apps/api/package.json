{
  "name": "@saywed/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts",
    "db:generate": "drizzle-kit generate",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@saywed/shared": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
