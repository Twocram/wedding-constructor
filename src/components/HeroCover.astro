---
import Monogram from './Monogram.astro';
import ScrollHint from './ScrollHint.astro';
interface Props {
  groom: string;
  bride: string;
  date: string;
  heroPhoto?: string;
}
const { groom, bride, date, heroPhoto } = Astro.props;
---

<header class="hero">
  {heroPhoto && <img src={heroPhoto} alt="" class="hero-photo" fetchpriority="high" />}
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="fireflies" aria-hidden="true">
    {Array.from({ length: 14 }).map(() => <i />)}
  </div>

  <div class="hero-frame" aria-hidden="true"></div>
  <div class="hero-monogram"><Monogram groom={groom} bride={bride} size={64} /></div>
  <p class="hero-side hero-side--l" aria-hidden="true">приглашение на свадьбу</p>
  <p class="hero-side hero-side--r" aria-hidden="true">{date}</p>

  <div class="hero-content">
    <p class="hero-label">Приглашение на свадьбу</p>
    <h1>
      <span class="hero-name">{groom}</span>
      <span class="hero-amp">&</span>
      <span class="hero-name">{bride}</span>
    </h1>
    <p class="hero-date"><span>{date}</span></p>
    <ScrollHint />
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #fbf8f2;
    isolation: isolate;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -3;
    animation: kenburns 28s var(--ease-out) infinite alternate;
  }
  @keyframes kenburns {
    from { transform: scale(1) translateY(0); }
    to { transform: scale(1.1) translateY(-1.5%); }
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(120% 70% at 50% 110%, rgba(10, 14, 8, 0.85), transparent 60%),
      linear-gradient(to bottom, rgba(10, 14, 8, 0.35), transparent 30%, transparent 55%, rgba(10, 14, 8, 0.7));
  }
  /* внутренняя волосяная рамка — как паспарту */
  .hero-frame {
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(251, 248, 242, 0.22);
    pointer-events: none;
    z-index: 0;
    mask: linear-gradient(to bottom, #000 0, #000 68%, transparent 92%);
  }
  .hero-monogram {
    position: absolute;
    top: 40px;
    left: 50%;
    translate: -50% 0;
    color: #fbf8f2;
    z-index: 1;
    opacity: 0.9;
    animation: rise 1.2s var(--ease-out) both;
  }
  .hero-side {
    position: absolute;
    top: 50%;
    writing-mode: vertical-rl;
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    opacity: 0.6;
    z-index: 1;
    display: none;
  }
  .hero-side--l { left: 34px; transform: translateY(-50%) rotate(180deg); }
  .hero-side--r { right: 34px; transform: translateY(-50%); }

  .fireflies { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .fireflies i {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #ffe9a8;
    box-shadow: 0 0 10px 3px rgba(255, 233, 168, 0.6);
    animation: blink var(--d, 3s) ease-in-out infinite, drift var(--t, 9s) ease-in-out infinite alternate;
    opacity: 0;
  }
  .fireflies i:nth-child(1)  { left: 12%; top: 30%; --d: 2.6s; --t: 8s; }
  .fireflies i:nth-child(2)  { left: 25%; top: 62%; --d: 3.4s; --t: 10s; animation-delay: 0.5s; }
  .fireflies i:nth-child(3)  { left: 38%; top: 22%; --d: 2.9s; --t: 9s; animation-delay: 1.2s; }
  .fireflies i:nth-child(4)  { left: 47%; top: 70%; --d: 3.8s; --t: 11s; animation-delay: 0.8s; }
  .fireflies i:nth-child(5)  { left: 58%; top: 35%; --d: 2.4s; --t: 8.5s; animation-delay: 1.6s; }
  .fireflies i:nth-child(6)  { left: 68%; top: 58%; --d: 3.1s; --t: 9.5s; animation-delay: 0.3s; }
  .fireflies i:nth-child(7)  { left: 78%; top: 26%; --d: 2.7s; --t: 10.5s; animation-delay: 1.9s; }
  .fireflies i:nth-child(8)  { left: 86%; top: 66%; --d: 3.5s; --t: 9s; animation-delay: 0.7s; }
  .fireflies i:nth-child(9)  { left: 18%; top: 48%; --d: 3s; --t: 11s; animation-delay: 1.4s; }
  .fireflies i:nth-child(10) { left: 33%; top: 82%; --d: 2.8s; --t: 8.8s; animation-delay: 0.2s; }
  .fireflies i:nth-child(11) { left: 62%; top: 15%; --d: 3.3s; --t: 10.2s; animation-delay: 1s; }
  .fireflies i:nth-child(12) { left: 88%; top: 45%; --d: 2.5s; --t: 9.3s; animation-delay: 1.7s; }
  .fireflies i:nth-child(13) { left: 8%;  top: 78%; --d: 3.6s; --t: 9.8s; animation-delay: 2.1s; }
  .fireflies i:nth-child(14) { left: 72%; top: 84%; --d: 2.9s; --t: 8.2s; animation-delay: 0.9s; }
  @keyframes blink { 0%, 100% { opacity: 0; } 50% { opacity: 1; } }
  @keyframes drift { from { transform: translate(0, 0); } to { transform: translate(24px, -30px); } }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 16px;
    padding: 0 24px clamp(40px, 7vh, 72px);
  }
  .hero-content > * { animation: rise 1.1s var(--ease-out) both; }
  .hero-content > :nth-child(1) { animation-delay: 0.15s; }
  .hero-content > :nth-child(2) { animation-delay: 0.3s; }
  .hero-content > :nth-child(3) { animation-delay: 0.5s; }
  .hero-content > :nth-child(4) { animation-delay: 0.75s; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(24px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  .hero-label {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 0.66rem;
    opacity: 0.85;
  }
  h1 {
    display: grid;
    justify-items: center;
    line-height: 0.95;
    font-size: clamp(3.2rem, 15vw, 8rem);
    text-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  }
  .hero-name { display: block; letter-spacing: -0.01em; }
  .hero-amp {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 0.42em;
    line-height: 1;
    color: #d8e2b3;
    margin: 0.12em 0;
  }
  .hero-date span {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: 0.06em;
    padding: 10px 26px;
    border: 1px solid rgba(251, 248, 242, 0.35);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    background: rgba(251, 248, 242, 0.06);
  }

  @media (min-width: 900px) {
    .hero-side { display: block; }
    .hero-label { display: none; }
    .hero-frame { inset: 28px; }
    h1 { grid-template-columns: auto auto auto; align-items: baseline; column-gap: 0.18em; line-height: 1.05; }
    .hero-amp { margin: 0; align-self: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo, .hero-content > *, .hero-monogram { animation: none; }
    .fireflies { display: none; }
  }
</style>
