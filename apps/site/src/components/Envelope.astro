---
interface Props {
  groom: string
  bride: string
  photo?: string
}
const { groom, bride, photo } = Astro.props
const initials = `${groom[0]}${bride[0]}`;
---

<div id="envelope" class:list={['envelope', { 'envelope-photo': photo }]}>
  {photo && <img src={photo} alt="" fetchpriority="high" />}
  <div class="envelope-veil" aria-hidden="true"></div>
  <div class="envelope-frame" aria-hidden="true"></div>

  <div class="envelope-content">
    <p class="envelope-label" data-guest="{g}, приглашение для вас">Приглашение на свадьбу</p>
    <p class="envelope-names">{groom} <i>&</i> {bride}</p>

    <button type="button" class="envelope-seal" aria-label="Открыть приглашение">
      <span class="seal-ring" aria-hidden="true"></span>
      <span class="seal-body" aria-hidden="true">
        <span class="seal-text">{initials[0]}<i>&</i>{initials[1]}</span>
      </span>
    </button>
    <p class="envelope-hint">нажмите на печать, чтобы открыть</p>
  </div>
</div>

<script>
const envelope = document.getElementById('envelope')
const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
const out = 'cubic-bezier(0.16, 1, 0.3, 1)'

function spark(layer: HTMLElement, x: number, y: number) {
  const s = document.createElement('i')
  s.className = 'env-spark'
  s.style.left = `${x}px`
  s.style.top = `${y}px`
  layer.append(s)
  const angle = Math.random() * Math.PI * 2
  const dist = 140 + Math.random() * 260
  s.animate([
    { transform: 'translate(-50%, -50%) scale(1)', opacity: 1 },
    { transform: `translate(calc(-50% + ${Math.cos(angle) * dist}px), calc(-50% + ${Math.sin(angle) * dist}px)) scale(0)`, opacity: 0 },
  ], { duration: 900 + Math.random() * 600, easing: out, fill: 'forwards' })
}

// печать трескается, из неё вспышка и искры, конверт расходится на две створки по линии печати
function open(el: HTMLElement) {
  const seal = el.querySelector<HTMLElement>('.envelope-seal')!
  const body = seal.querySelector<HTMLElement>('.seal-body')!
  const r = body.getBoundingClientRect()
  const cx = r.left + r.width / 2
  const cy = r.top + r.height / 2
  const h = innerHeight

  // створки — копии фона конверта, разрезанные по высоте печати; оригинал остаётся только с текстом
  const doors = (['top', 'bottom'] as const).map((side) => {
    const d = document.createElement('div')
    d.className = 'env-door'
    el.querySelectorAll(':scope > img, :scope > .envelope-veil, :scope > .envelope-frame').forEach(n => d.append(n.cloneNode(true)))
    d.style.clipPath = side === 'top' ? `inset(0 0 ${h - cy}px 0)` : `inset(${cy}px 0 0 0)`
    el.append(d)
    return { d, side }
  })
  el.classList.add('opening')

  const fx = document.createElement('div')
  fx.className = 'env-fx'
  el.append(fx)

  body.animate([{ transform: 'scale(1)' }, { transform: 'scale(0.88)' }, { transform: 'scale(0.94)' }], { duration: 160, easing: 'ease-out', fill: 'forwards' })
  setTimeout(() => {
    body.style.visibility = 'hidden'
    seal.querySelector<HTMLElement>('.seal-ring')?.remove()
    // две половинки сургуча по неровной трещине
    const halves = [
      ['polygon(0 0, 56% 0, 44% 32%, 60% 58%, 42% 100%, 0 100%)', -1],
      ['polygon(56% 0, 100% 0, 100% 100%, 42% 100%, 60% 58%, 44% 32%)', 1],
    ] as const
    halves.forEach(([clip, dir]) => {
      const half = body.cloneNode(true) as HTMLElement
      half.classList.add('seal-half')
      half.style.visibility = 'visible'
      half.style.clipPath = clip
      half.style.left = `${r.left}px`
      half.style.top = `${r.top}px`
      fx.append(half)
      half.animate([
        { transform: 'translate(0, 0) rotate(0)', opacity: 1 },
        { transform: `translate(${dir * 70}px, ${90 + Math.random() * 40}px) rotate(${dir * 38}deg)`, opacity: 0 },
      ], { duration: 750, easing: 'cubic-bezier(0.3, 0, 0.6, 1)', fill: 'forwards' })
    })

    const glow = document.createElement('i')
    glow.className = 'env-glow'
    glow.style.left = `${cx}px`
    glow.style.top = `${cy}px`
    fx.append(glow)
    glow.animate([
      { transform: 'translate(-50%, -50%) scale(0.2)', opacity: 1 },
      { transform: 'translate(-50%, -50%) scale(5)', opacity: 0 },
    ], { duration: 900, easing: out, fill: 'forwards' })
    for (let i = 0; i < 30; i++) spark(fx, cx, cy)

    const seam = document.createElement('i')
    seam.className = 'env-seam'
    seam.style.top = `${cy}px`
    fx.append(seam)
    seam.animate([
      { transform: 'translateY(-50%) scaleX(0)', opacity: 1 },
      { transform: 'translateY(-50%) scaleX(1)', opacity: 1, offset: 0.35 },
      { transform: 'translateY(-50%) scaleX(1)', opacity: 0 },
    ], { duration: 900, easing: 'ease-out', fill: 'forwards' })

    el.querySelectorAll<HTMLElement>('.envelope-label, .envelope-names, .envelope-hint').forEach((n, i) => {
      n.animate([
        { transform: 'translateY(0)', opacity: 1, filter: 'blur(0)' },
        { transform: 'translateY(-24px)', opacity: 0, filter: 'blur(6px)' },
      ], { duration: 420, delay: i * 40, easing: out, fill: 'forwards' })
    })
  }, 150)

  setTimeout(() => {
    doors.forEach(({ d, side }) => {
      d.animate([
        { transform: 'translateY(0)' },
        { transform: `translateY(${side === 'top' ? -cy - 40 : h - cy + 40}px)` },
      ], { duration: 1100, easing: 'cubic-bezier(0.7, 0, 0.2, 1)', fill: 'forwards' })
    })
  }, 380)

  setTimeout(() => el.remove(), 1550)
}

if (envelope) {
  document.body.style.overflow = 'hidden'
  envelope.querySelector('button')?.addEventListener('click', () => {
    document.body.style.overflow = ''
    envelope.style.pointerEvents = 'none'
    // тап = жест пользователя, можно включать музыку
    const audio = document.getElementById('music') as HTMLAudioElement | null
    audio?.play().catch(() => {})
    const btn = document.getElementById('music-btn')
    if (btn && audio && !audio.paused)
      btn.classList.add('playing')
    navigator.vibrate?.(25)
    if (reduceMotion) {
      envelope.classList.add('opened')
      envelope.addEventListener('transitionend', () => envelope.remove(), { once: true })
    }
    else {
      open(envelope)
    }
  }, { once: true })
}
</script>

<style>
  .envelope {
    position: fixed;
    inset: 0;
    z-index: var(--z-envelope);
    display: grid;
    place-items: end center;
    background: var(--bg);
    color: var(--text);
    isolation: isolate;
  }
  .envelope-photo { color: #fbf8f2; }
  .envelope img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* открытие: фон уходит в створки, в самом конверте остаются текст и эффекты */
  .envelope.opening { background: transparent; }
  .envelope.opening > img,
  .envelope.opening > .envelope-veil,
  .envelope.opening > .envelope-frame { visibility: hidden; }
  /* створки и эффекты создаются из скрипта, у них нет scoped-атрибута — отсюда :global */
  .envelope :global(.env-door) {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg);
    isolation: isolate;
    will-change: transform;
  }
  .envelope :global(.env-fx) { position: fixed; inset: 0; z-index: 2; pointer-events: none; }
  .envelope :global(.env-fx .seal-half) { position: fixed; margin: 0; will-change: transform, opacity; }
  .envelope :global(.env-glow) {
    position: fixed;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 244, 214, 0.95), rgba(255, 220, 150, 0.45) 35%, transparent 70%);
    mix-blend-mode: screen;
  }
  .envelope :global(.env-spark) {
    position: fixed;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff4d6;
    box-shadow: 0 0 14px 4px rgba(255, 220, 150, 0.8);
  }
  .envelope :global(.env-seam) {
    position: fixed;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ffe7b0 20%, #fff8e6 50%, #ffe7b0 80%, transparent);
    box-shadow: 0 0 18px 4px rgba(255, 220, 150, 0.6);
  }
  .envelope-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgba(10, 14, 8, 0.25), transparent 35%, rgba(10, 14, 8, 0.75));
  }
  .envelope:not(.envelope-photo) .envelope-veil { display: none; }
  .envelope-frame {
    position: absolute;
    inset: 18px;
    border: 1px solid currentColor;
    opacity: 0.25;
    pointer-events: none;
  }

  .envelope-content {
    position: relative;
    text-align: center;
    padding: 0 24px 12svh;
    display: grid;
    gap: 18px;
    justify-items: center;
  }
  .envelope-content > * { animation: env-rise 1s var(--ease-out) both; }
  .envelope-content > :nth-child(2) { animation-delay: 0.15s; }
  .envelope-content > :nth-child(3) { animation-delay: 0.35s; }
  .envelope-content > :nth-child(4) { animation-delay: 0.55s; }
  @keyframes env-rise {
    from { opacity: 0; transform: translateY(20px); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }

  .envelope-label {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 0.66rem;
    opacity: 0.85;
  }
  .envelope-names {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 9vw, 3.2rem);
    line-height: 1.1;
    text-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }
  .envelope-names i {
    font-family: var(--font-accent);
    font-style: italic;
    opacity: 0.85;
  }

  /* сургучная печать */
  .envelope-seal {
    position: relative;
    width: 96px;
    height: 96px;
    margin-top: 10px;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 0.6s var(--ease);
  }
  .envelope-seal:hover { transform: scale(1.04); }
  .envelope-seal:active { transform: scale(0.96); }
  .seal-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid currentColor;
    opacity: 0.5;
    animation: seal-pulse 2.6s var(--ease-out) infinite;
  }
  @keyframes seal-pulse {
    0% { transform: scale(0.9); opacity: 0.6; }
    100% { transform: scale(1.45); opacity: 0; }
  }
  .seal-body {
    width: 78px;
    height: 78px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--accent) 70%, white 30%), var(--accent) 45%, color-mix(in srgb, var(--accent) 75%, black 25%));
    box-shadow:
      inset 0 2px 4px rgba(255, 255, 255, 0.35),
      inset 0 -4px 8px rgba(0, 0, 0, 0.25),
      0 14px 30px -10px rgba(0, 0, 0, 0.5);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.04em;
  }
  .seal-body::before {
    content: '';
    position: absolute;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent-ink) 40%, transparent);
  }
  .seal-text { position: relative; display: inline-flex; align-items: baseline; }
  .seal-text i { font-family: var(--font-accent); font-style: italic; font-size: 0.7em; margin: 0 0.06em; }
  .envelope-hint {
    font-family: var(--font-label);
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: reduce) {
    .seal-ring, .envelope-content > * { animation: none; }
    .envelope { transition: opacity 0.5s; }
    .envelope.opened { opacity: 0; }
  }
</style>
