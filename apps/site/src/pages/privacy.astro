---
import Base from '../layouts/Base.astro'
import { leadFormEnabled, legal, orderTelegram } from '../site'

if (!leadFormEnabled)
return Astro.redirect('/')

const sections = [
  {
    title: 'Кто обрабатывает данные',
    body: [
      `Оператор персональных данных — ${legal.operator}, ИНН ${legal.inn}, плательщик налога на профессиональный доход (далее — «мы»). Политика относится к сайту saywed.ru и описывает, какие данные мы получаем через форму заявки и как с ними обращаемся.`,
    ],
  },
  {
    title: 'Какие данные мы получаем',
    body: [
      'Из формы заявки: имя, способ связи и контакт (ник в Telegram или номер телефона), а также то, что вы сами укажете о празднике: тип события, дату, выбранный дизайн, число гостей с именными ссылками и комментарий.',
      'Технические данные: адрес страницы, с которой отправлена заявка, рекламные метки (UTM), источник перехода, тип браузера и обезличенный хеш IP-адреса — для защиты формы от спама.',
    ],
  },
  {
    title: 'Зачем',
    body: [
      'Чтобы связаться с вами по заявке, обсудить и выполнить заказ, а также чтобы понимать, какие разделы сайта и рекламные каналы приводят заказчиков. Рассылок без вашего отдельного согласия мы не делаем.',
    ],
  },
  {
    title: 'Основание',
    body: [
      'Ваше согласие, которое вы даёте, отмечая галочку перед отправкой формы (ст. 6 и 9 Федерального закона № 152-ФЗ «О персональных данных»). Согласие можно отозвать в любой момент — напишите нам, и мы удалим данные.',
    ],
  },
  {
    title: 'Где и сколько хранятся',
    body: [
      'Данные хранятся на сервере, расположенном в Российской Федерации. Доступ к ним есть только у нас.',
      'Заявки, по которым заказ не состоялся, удаляются не позднее чем через 12 месяцев. Данные выполненных заказов хранятся, пока это нужно для исполнения обязательств и требований закона, затем удаляются.',
    ],
  },
  {
    title: 'Передача третьим лицам',
    body: [
      'Мы не продаём и не передаём ваши данные третьим лицам, кроме случаев, прямо предусмотренных законом.',
    ],
  },
  {
    title: 'Ваши права',
    body: [
      `Вы можете узнать, какие данные о вас у нас есть, попросить их уточнить или удалить, а также отозвать согласие. Пишите на ${legal.email} или в Telegram @${orderTelegram} — ответим в течение 10 рабочих дней.`,
    ],
  },
];
---

<Base title="Политика конфиденциальности — saywed" description="Как saywed.ru обрабатывает персональные данные из формы заявки." noindex>
  <main class="section">
    <article class="wrap wrap--narrow privacy">
      <header class="section-head">
        <p class="eyebrow">Документы</p>
        <h1>Политика обработки персональных данных</h1>
        <p class="privacy-updated">Редакция от {legal.updated}</p>
      </header>
      {sections.map(s => (
        <section>
          <h2>{s.title}</h2>
          {s.body.map(p => <p>{p}</p>)}
        </section>
      ))}
      <p class="privacy-back"><a href="/">← На главную</a></p>
    </article>
  </main>
</Base>

<style>
  .privacy { display: grid; gap: 28px; text-align: left; }
  .privacy .section-head { justify-items: start; margin-bottom: 8px; }
  .privacy h1 { font-family: var(--font-display); font-weight: 400; font-size: clamp(2rem, 7vw, 2.8rem); line-height: 1.1; margin: 0; }
  .privacy-updated { margin: 0; color: var(--muted); font-size: 0.85rem; }
  .privacy h2 { font-size: 1.35rem; margin: 0 0 10px; }
  .privacy section p { margin: 0 0 10px; color: var(--text-2); line-height: 1.7; }
  .privacy-back a { color: var(--accent); text-underline-offset: 3px; }
</style>
