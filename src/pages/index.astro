---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { themes, orderUrl } from '../site';

const order = Object.keys(themes);
const invitations = (await getCollection('invitations')).sort(
  (a, b) => order.indexOf(a.data.theme) - order.indexOf(b.data.theme),
);

const features = [
  { title: 'Личное обращение', text: 'У каждого гостя своя ссылка — он увидит в приглашении своё имя', icon: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0' },
  { title: 'Анкета гостя', text: 'Ответы «приду / не приду» сразу прилетают вам в Telegram', icon: 'M4 5h16v11H8l-4 4zM8 10h8M8 13h5' },
  { title: 'Карта и маршрут', text: 'Яндекс.Карта площадки и кнопка «Построить маршрут»', icon: 'M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z' },
  { title: 'Таймер и календарь', text: 'Обратный отсчёт и «Добавить в календарь» с напоминанием за день', icon: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4' },
  { title: 'Программа и дресс-код', text: 'Тайминг дня и палитра оттенков, чтобы гости выглядели как на одной фотографии', icon: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z' },
  { title: 'Музыка и фото', text: 'Ваша песня по кнопке и галерея истории пары', icon: 'M9 18V5l11-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM20 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z' },
];

const steps = [
  { title: 'Выберите дизайн', text: 'Откройте демо с телефона — так его увидят гости.' },
  { title: 'Пришлите данные', text: 'Имена, дату, площадку, программу и пару фотографий.' },
  { title: 'Получите ссылку', text: 'Готовое приглашение за 1–2 дня. Рассылаете гостям в мессенджерах.' },
];
---

<Base title="Wedding Constructor — онлайн-приглашения на свадьбу" description="Онлайн-приглашения на свадьбу: семь дизайнов, анкета гостя с ответами в Telegram, карта, программа дня и дресс-код. Готово за 1–2 дня.">
  <main class="shop">
    <header class="shop-hero">
      <div class="wrap">
        <p class="eyebrow fade-up">Wedding Constructor</p>
        <h1 class="fade-up" style="--i:1">Приглашение на свадьбу, которое <em>хочется открыть</em></h1>
        <p class="shop-sub fade-up" style="--i:2">Одна ссылка вместо бумажных открыток: дата, место, программа, дресс-код и анкета гостя. Красиво на любом телефоне.</p>
        <div class="shop-ctas fade-up" style="--i:3">
          <a class="btn" href="#themes">Выбрать дизайн <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M8 3v10M4 9l4 4 4-4" /></svg></span></a>
          <a class="btn btn--ghost" href={orderUrl()} target="_blank" rel="noopener">Написать нам <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 12 12 4M6 4h6v6" /></svg></span></a>
        </div>
        <ul class="shop-proof fade-up" style="--i:4">
          <li>Готово за 1–2 дня</li>
          <li>Ответы гостей в Telegram</li>
          <li>Без приложений и регистрации</li>
        </ul>
      </div>
    </header>

    <section class="shop-block" id="themes" aria-labelledby="themes-title">
      <div class="shop-wide">
        <div class="shop-head">
          <p class="eyebrow">Каталог</p>
          <h2 id="themes-title">Семь дизайнов</h2>
          <p>Нажмите на карточку — откроется живое демо с примером пары.</p>
        </div>
        <ul class="themes">
          {invitations.map((inv, i) => {
            const t = themes[inv.data.theme];
            return (
              <li class="theme fade-up" style={`--i:${i % 3}`}>
                <a class="theme-phone" href={`/${inv.id}`} aria-label={`Демо ${t.name}: ${inv.data.groom} и ${inv.data.bride}`}>
                  <img src={`/previews/${inv.id}.webp`} alt="" width="600" height="1298" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
                </a>
                <div class="theme-info">
                  <div class="theme-tags">{t.tags.map((tag) => <span>{tag}</span>)}</div>
                  <h3>{t.name}</h3>
                  <p>{t.tagline}</p>
                  <div class="theme-actions">
                    <a class="theme-link" href={`/${inv.id}`}>Смотреть демо</a>
                    <a class="theme-link theme-link--accent" href={orderUrl(t.name)} target="_blank" rel="noopener">Заказать →</a>
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section class="shop-block shop-block--surface" aria-labelledby="features-title">
      <div class="shop-wide">
        <div class="shop-head">
          <p class="eyebrow">Во всех дизайнах</p>
          <h2 id="features-title">Всё, что нужно гостям</h2>
        </div>
        <ul class="features">
          {features.map((f, i) => (
            <li class="fade-up" style={`--i:${i % 3}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={f.icon} /></svg>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="shop-block" aria-labelledby="steps-title">
      <div class="shop-wide">
        <div class="shop-head">
          <p class="eyebrow">Как заказать</p>
          <h2 id="steps-title">Три шага</h2>
        </div>
        <ol class="steps">
          {steps.map((s, i) => (
            <li class="fade-up" style={`--i:${i}`}>
              <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="shop-final">
      <div class="wrap">
        <h2 class="fade-up">Выбрали дизайн?</h2>
        <p class="fade-up" style="--i:1">Напишите нам — ответим на вопросы и соберём приглашение под вашу пару.</p>
        <a class="btn fade-up" style="--i:2" href={orderUrl()} target="_blank" rel="noopener">Заказать приглашение <span class="btn-icon" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 12 12 4M6 4h6v6" /></svg></span></a>
      </div>
    </section>
  </main>
</Base>

<style>
  /* main в Base — grid: без minmax(0) карусель растягивает колонку до своей ширины */
  .shop { overflow-x: clip; grid-template-columns: minmax(0, 1fr); }
  .shop-wide { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  .shop h1, .shop h2, .shop h3 { font-family: var(--font-display); font-weight: 400; color: var(--text); margin: 0; }
  .shop em { font-style: italic; color: var(--accent); }

  /* ── hero ── */
  .shop-hero { padding: clamp(72px, 14vh, 140px) 0 clamp(48px, 8vh, 80px); text-align: center; }
  .shop-hero .wrap { display: grid; justify-items: center; gap: 22px; }
  .shop-hero h1 { font-size: clamp(2.3rem, 8vw, 4.2rem); line-height: 1.08; max-width: 14ch; text-wrap: balance; }
  .shop-sub { max-width: 44ch; font-size: 1.05rem; line-height: 1.65; color: var(--text-2); margin: 0; text-wrap: pretty; }
  .shop-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px; }
  .shop-proof { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; font-size: 0.8rem; letter-spacing: 0.06em; color: var(--muted); }
  .shop-proof li::before { content: '✦'; color: var(--accent); margin-right: 8px; font-size: 0.7em; vertical-align: 0.15em; }

  /* ── блоки ── */
  .shop-block { padding: clamp(64px, 10vh, 110px) 0; }
  .shop-block--surface { background: var(--surface); }
  .shop-head { display: grid; justify-items: center; gap: 12px; text-align: center; margin-bottom: clamp(36px, 6vh, 60px); }
  .shop-head h2 { font-size: clamp(2rem, 6vw, 3rem); line-height: 1.1; }
  .shop-head p:not(.eyebrow) { margin: 0; color: var(--muted); max-width: 40ch; }

  /* ── каталог ── */
  .themes { list-style: none; padding: 0; margin: 0; display: grid; gap: 56px 32px; grid-template-columns: 1fr; }
  /* телефон: карусель со свайпом, иначе шесть макетов — это ~4000px ленты */
  @media (max-width: 639px) {
    .themes {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: 74%;
      gap: 20px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin: 0 -20px;
      padding: 8px 13% 24px;
      scroll-padding: 0 13%;
    }
    .themes::-webkit-scrollbar { display: none; }
    .theme { scroll-snap-align: center; }
    .theme.fade-up { opacity: 1; transform: none; } /* IO по вертикали не видит карточки за краем карусели */
  }
  @media (min-width: 640px) {
    .themes { grid-template-columns: repeat(2, 1fr); }
    /* нечётная последняя карточка — по центру, а не у левого края */
    .theme:last-child:nth-child(2n + 1) { grid-column: 1 / -1; }
  }
  @media (min-width: 1000px) {
    .themes { grid-template-columns: repeat(3, 1fr); }
    .theme:last-child:nth-child(2n + 1) { grid-column: auto; }
    .theme:last-child:nth-child(3n + 1) { grid-column: 2; }
  }
  .theme { display: grid; gap: 22px; justify-items: center; text-align: center; }
  .theme-phone {
    display: block;
    width: min(100%, 290px);
    aspect-ratio: 390 / 844;
    border-radius: 38px;
    padding: 9px;
    background: #1d1b18;
    box-shadow: 0 1px 0 1px #3a3631 inset, 0 30px 60px -28px rgb(40 30 20 / 0.55), 0 10px 20px -12px rgb(40 30 20 / 0.3);
    transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease);
  }
  .theme-phone img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; border-radius: 30px; background: var(--surface); }
  .theme-phone:hover { transform: translateY(-6px) rotate(-0.6deg); box-shadow: 0 1px 0 1px #3a3631 inset, 0 44px 70px -30px rgb(40 30 20 / 0.6), 0 14px 24px -14px rgb(40 30 20 / 0.3); }
  .theme-info { display: grid; gap: 8px; justify-items: center; max-width: 300px; }
  .theme-tags { display: flex; gap: 6px; }
  .theme-tags span { font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--line-strong); border-radius: 99px; padding: 4px 10px; }
  .theme h3 { font-size: 1.9rem; margin-top: 4px; }
  .theme-info p { margin: 0; color: var(--text-2); line-height: 1.5; min-height: 3em; text-wrap: balance; }
  .theme-actions { display: flex; gap: 20px; margin-top: 6px; }
  .theme-link { font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text); text-decoration: none; padding: 10px 0; border-bottom: 1px solid var(--line-strong); transition: border-color 0.3s, color 0.3s; }
  .theme-link:hover { border-color: currentColor; }
  .theme-link--accent { color: var(--accent); }

  /* ── фичи ── */
  .features { list-style: none; padding: 0; margin: 0; display: grid; gap: 1px; grid-template-columns: 1fr; background: var(--line); border: 1px solid var(--line); }
  @media (min-width: 640px) { .features { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .features { grid-template-columns: repeat(3, 1fr); } }
  .features li { background: var(--surface); padding: 32px 28px; display: grid; gap: 10px; align-content: start; }
  .features svg { width: 28px; height: 28px; color: var(--accent); margin-bottom: 6px; }
  .features h3 { font-size: 1.35rem; }
  .features p { margin: 0; color: var(--text-2); line-height: 1.55; }

  /* ── шаги ── */
  .steps { list-style: none; padding: 0; margin: 0 auto; display: grid; gap: 36px; max-width: 980px; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(3, 1fr); gap: 40px; } }
  .steps li { display: grid; gap: 10px; text-align: center; justify-items: center; }
  .step-n { font-family: var(--font-display); font-style: italic; font-size: 2.6rem; line-height: 1; color: var(--accent); }
  .steps h3 { font-size: 1.4rem; }
  .steps p { margin: 0; color: var(--text-2); max-width: 30ch; line-height: 1.55; }

  /* ── финал ── */
  .shop-final { padding: clamp(72px, 12vh, 130px) 0; text-align: center; background: var(--text); color: var(--bg); }
  .shop-final .wrap { display: grid; justify-items: center; gap: 18px; }
  .shop-final h2 { color: var(--bg); font-size: clamp(2.1rem, 7vw, 3.4rem); }
  .shop-final p { margin: 0 0 8px; opacity: 0.75; max-width: 40ch; }
</style>
