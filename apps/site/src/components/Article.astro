---
import Base from '../layouts/Base.astro'
import { articles } from '../lib/articles'
import { orderUrl } from '../site'

interface Props {
  title: string
  description: string
  heading: string
  lead: string
}
const { title, description, heading, lead } = Astro.props
const site = Astro.site ?? new URL('https://saywed.ru')
const url = new URL(Astro.url.pathname, site).href
const others = articles.filter(a => a.path !== Astro.url.pathname)
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', 'headline': heading, 'description': description, 'inLanguage': 'ru', 'mainEntityOfPage': url, 'publisher': { '@type': 'Organization', 'name': 'saywed', 'url': site.href } },
    {
      '@type': 'BreadcrumbList',
      'itemListElement': [
        { '@type': 'ListItem', 'position': 1, 'name': 'saywed', 'item': site.href },
        { '@type': 'ListItem', 'position': 2, 'name': heading, 'item': url },
      ],
    },
  ],
}
---

<Base title={title} description={description} image="/og.jpg" brand>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <main class="ar">
    <nav class="ar-crumbs" aria-label="Навигация"><a href="/">saywed</a> <span aria-hidden="true">/</span> <span>{heading}</span></nav>
    <article>
      <h1>{heading}</h1>
      <p class="ar-lead">{lead}</p>
      <slot />
    </article>

    <aside class="ar-cta">
      <h2>Соберём приглашение за 1–2 дня</h2>
      <p>Выберите дизайн в каталоге и посмотрите живое демо, а дальше мы всё сделаем сами.</p>
      <div>
        <a class="btn" href="/#themes">Смотреть дизайны</a>
        <a class="ar-order" href={orderUrl()} target="_blank" rel="noopener">Написать нам</a>
      </div>
    </aside>

    <nav class="ar-more" aria-label="Другие материалы">
      <h2>Ещё по теме</h2>
      <ul>
        {others.map(a => <li><a href={a.path}>{a.title}</a><span>{a.short}</span></li>)}
      </ul>
    </nav>
  </main>
</Base>

<style>
  .ar { width: min(100%, 720px); margin: 0 auto; padding: clamp(32px, 7vw, 64px) 20px clamp(48px, 9vw, 88px); }
  .ar-crumbs { margin-bottom: 28px; font-size: 0.86rem; color: var(--muted); }
  .ar-crumbs a { color: inherit; }
  h1 { font-size: clamp(2.1rem, 7vw, 3.1rem); line-height: 1.12; text-wrap: balance; }
  .ar-lead { margin-top: 18px; font-size: 1.16rem; line-height: 1.6; color: var(--text-2); }
  article :global(h2) { margin-top: 44px; font-size: clamp(1.5rem, 5vw, 1.95rem); line-height: 1.2; }
  article :global(p),
  article :global(ul),
  article :global(ol) { margin-top: 14px; font-size: 1.05rem; line-height: 1.7; }
  article :global(ul),
  article :global(ol) { padding-left: 1.2em; }
  article :global(li + li) { margin-top: 6px; }
  article :global(a) { color: var(--accent); text-underline-offset: 3px; }
  article :global(blockquote) {
    margin: 16px 0 0;
    padding: 16px 20px;
    border-left: 3px solid var(--accent);
    border-radius: 0 var(--r-md) var(--r-md) 0;
    background: var(--surface);
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .ar-cta { margin-top: 56px; padding: clamp(24px, 6vw, 36px); border-radius: var(--r-lg); background: var(--surface); }
  .ar-cta h2 { font-size: clamp(1.5rem, 5vw, 1.9rem); line-height: 1.2; }
  .ar-cta p { margin-top: 10px; color: var(--text-2); line-height: 1.6; }
  .ar-cta div { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin-top: 20px; }
  .ar-cta .btn { padding-inline: 28px; } /* кнопка без значка-стрелки */
  .ar-order { color: var(--accent); text-underline-offset: 3px; }
  .ar-more { margin-top: 48px; }
  .ar-more h2 { font-size: 1.3rem; }
  .ar-more ul { display: grid; gap: 14px; margin-top: 14px; padding: 0; list-style: none; }
  .ar-more li { display: grid; gap: 2px; }
  .ar-more a { color: var(--text); text-underline-offset: 3px; }
  .ar-more span { font-size: 0.92rem; color: var(--muted); }
</style>
