---
import type { CollectionEntry } from 'astro:content';
import RsvpFields from './RsvpFields.astro';

interface Props {
  inv: CollectionEntry<'invitations'>['data'];
  slug: string;
  google?: string; // «Добавить в Google Календарь»; нет — нет и кнопки «Напомнить»
}
const { inv, slug, google } = Astro.props;

// приглашение как сторис: тап справа/слева — вперёд/назад, удержание — пауза, полоски сверху — прогресс
type Story = { key: string; dur: number; photo?: string; grad?: number; n?: number };
const moments = (inv.gallery ?? []).slice(0, 3);
// фото для текстовых историй: сначала те, что не попали в «моменты», затем остальные
const pool = [...(inv.gallery ?? []).slice(3), ...[...moments].reverse(), ...(inv.heroPhoto ? [inv.heroPhoto] : [])];
let poolIdx = 0;
let gradIdx = 0;
let textIdx = 0;
// текстовые истории чередуют фото и градиентный фон, как это делают в настоящих сторис
const bg = () =>
  textIdx++ % 2 === 0 && pool.length ? { photo: pool[poolIdx++ % pool.length] } : { grad: gradIdx++ % 3 };

const stories: Story[] = [{ key: 'cover', dur: 7, photo: inv.heroPhoto ?? pool[0] }];
if (inv.welcome) stories.push({ key: 'welcome', dur: 8, ...bg() });
moments.forEach((photo, i) => stories.push({ key: 'moment', dur: 5, photo, n: i + 1 }));
if (inv.countdown) stories.push({ key: 'countdown', dur: 8, grad: gradIdx++ % 3 });
if (inv.venue) stories.push({ key: 'venue', dur: 8, ...bg() });
if (inv.timeline) stories.push({ key: 'timeline', dur: 10, ...bg() });
if (inv.dressCode) stories.push({ key: 'dress', dur: 9, ...bg() });
if (inv.wishes || inv.transfer) stories.push({ key: 'notes', dur: 12, ...bg() });
if (inv.telegramChat) stories.push({ key: 'chat', dur: 7, ...bg() });
if (inv.rsvp) stories.push({ key: 'rsvp', dur: 12, ...bg() });
stories.push({ key: 'finale', dur: 8, photo: inv.heroPhoto ?? pool[0] });

const initials = `${inv.groom[0]}${inv.bride[0]}`;
const time = inv.countdown?.slice(11, 16);
const shortDate = inv.date.replace(/\s+\d{4}$/, '');
const routeUrl = inv.venue && `https://yandex.ru/maps/?text=${encodeURIComponent(`${inv.venue.name}, ${inv.venue.address}`)}`;
const notes = [...(inv.wishes ?? []), ...(inv.transfer ? [`Трансфер: ${inv.transfer}`] : [])];
const pin = 'M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21zM12 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z';
const link = 'M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1';
---

<div class="st">
  <img class="st-backdrop" src={stories[0].photo} alt="" aria-hidden="true" />

  <button class="st-arrow st-arrow--prev" type="button" aria-label="Предыдущая история" data-prev>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
  </button>

  <div class="st-phone">
    <div class="st-stories">
      {stories.map((s, i) => (
        <section
          class:list={['story', `story--${s.key}`, { 'is-active': i === 0 }]}
          data-dur={s.dur}
          data-photo={s.photo}
          inert={i !== 0}
          aria-hidden={i !== 0 ? 'true' : undefined}
        >
          <div class:list={['story-bg', s.grad !== undefined && `story-bg--g${s.grad}`, { 'story-bg--photo': s.photo }]}>
            {s.photo && <img src={s.photo} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" draggable="false" />}
          </div>

          <div class="story-body">
            {s.key === 'cover' && (
              <div class="cover">
                <p class="hand pop" style="--d:0;--r:-5deg" data-guest="{g}, мы женимся!">Мы женимся!</p>
                <h1 class="names pop" style="--d:1">
                  <span>{inv.groom}</span>
                  <span class="amp">&amp;</span>
                  <span>{inv.bride}</span>
                </h1>
                <p class="pop" style="--d:2"><span class="hl">{inv.date}</span></p>
                {inv.city && <p class="pop" style="--d:3"><span class="hl hl--glass">{inv.city}</span></p>}
              </div>
            )}

            {s.key === 'welcome' && (
              <div class="center">
                <p class="hand hand--xl pop" style="--d:0;--r:-3deg" data-guest="{g}, ждём вас!">Дорогие гости!</p>
                <p class="pop hl-block" style="--d:1"><span class="hl">{inv.welcome}</span></p>
              </div>
            )}

            {s.key === 'moment' && (
              <p class="moment-cap pop" style="--d:0;--r:-4deg">наша история · {s.n}/{moments.length}</p>
            )}

            {s.key === 'countdown' && (
              <div class="center">
                <div class="sticker cd pop" style="--d:0;--r:-2deg" data-target={inv.countdown}>
                  <p class="cd-title">До свадьбы</p>
                  <div class="cd-digits">
                    <div><b data-u="d">–</b><small>дней</small></div>
                    <div><b data-u="h">–</b><small>часов</small></div>
                    <div><b data-u="m">–</b><small>минут</small></div>
                  </div>
                  <p class="cd-date">{inv.date}{time && `, ${time}`}</p>
                  {google && (
                    <a class="cd-remind" href={`/ics/${slug}.ics`}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15zM10 20a2 2 0 0 0 4 0" /></svg>
                      Напомнить мне
                    </a>
                  )}
                </div>
                {google && <a class="small-link pop" style="--d:2" href={google} target="_blank" rel="noopener">или добавить в Google Календарь</a>}
              </div>
            )}

            {s.key === 'venue' && inv.venue && (
              <div class="center">
                <p class="hand hand--xl pop" style="--d:0;--r:-4deg">Где?</p>
                <a class="loc pop" style="--d:1;--r:2deg" href={routeUrl} target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d={pin} /></svg>
                  <span>{inv.venue.name}</span>
                </a>
                <p class="pop" style="--d:2"><span class="hl hl--glass">{inv.venue.address}</span></p>
                <a class="link-sticker pop" style="--d:3;--r:-2deg" href={routeUrl} target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={link} /></svg>
                  Построить маршрут
                </a>
              </div>
            )}

            {s.key === 'timeline' && inv.timeline && (
              <div class="center">
                <div class="sticker card pop" style="--d:0;--r:-1.5deg">
                  <p class="card-head">Программа дня</p>
                  <ol class="tl">
                    {inv.timeline.map((t) => (
                      <li><b>{t.time}</b><span>{t.title}{t.text && <small>{t.text}</small>}</span></li>
                    ))}
                  </ol>
                </div>
              </div>
            )}

            {s.key === 'dress' && inv.dressCode && (
              <div class="center">
                <p class="hand hand--xl pop" style="--d:0;--r:-3deg">Дресс-код</p>
                {inv.dressCode.colors && (
                  <div class="swatches pop" style="--d:1">
                    {inv.dressCode.colors.map((c) => <span style={`background:${c}`}></span>)}
                  </div>
                )}
                <p class="glass-note pop" style="--d:2">{inv.dressCode.text}</p>
              </div>
            )}

            {s.key === 'notes' && (
              <div class="center">
                <div class="sticker card pop" style="--d:0;--r:1.5deg">
                  <p class="card-head card-head--grad">Пара просила передать</p>
                  <ul class="notes">{notes.map((n) => <li>{n}</li>)}</ul>
                </div>
              </div>
            )}

            {s.key === 'chat' && inv.telegramChat && (
              <div class="center">
                <p class="hand hand--xl pop" style="--d:0;--r:-3deg">Наш чат</p>
                <p class="glass-note pop" style="--d:1">{inv.telegramChat.text}</p>
                <a class="link-sticker pop" style="--d:2;--r:2deg" href={inv.telegramChat.url} target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={link} /></svg>
                  Вступить в чат
                </a>
              </div>
            )}

            {s.key === 'rsvp' && inv.rsvp && (
              <div class="center">
                <div class="sticker poll pop" style="--d:0;--r:-1.5deg">
                  <p class="poll-q">Придёте на нашу свадьбу?</p>
                  <button type="button" class="poll-opt" data-poll="Приду">Да, буду! 🥂</button>
                  <button type="button" class="poll-opt" data-poll="Не смогу">К сожалению, нет</button>
                </div>
                <p class="pop" style="--d:2"><span class="hl hl--glass">ответьте, пожалуйста, до {inv.rsvp.deadline}</span></p>
              </div>
            )}

            {s.key === 'finale' && (
              <div class="cover">
                <p class="hand hand--xl pop" style="--d:0;--r:-4deg">До встречи!</p>
                <p class="pop" style="--d:1"><span class="hl">{inv.groom} &amp; {inv.bride}</span></p>
                {inv.organizer && (
                  <a class="link-sticker pop" style="--d:2;--r:-2deg" href={`tel:${inv.organizer.phone.replace(/[^\d+]/g, '')}`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg>
                    Вопросы — {inv.organizer.name}
                  </a>
                )}
                <button type="button" class="replay pop" style="--d:3" data-replay>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.7M4 4v4h4" /></svg>
                  Смотреть сначала
                </button>
              </div>
            )}
          </div>
        </section>
      ))}

      <p class="tap-hint" aria-hidden="true">
        <span class="tap-dot"></span>
        листать
      </p>
    </div>

    <header class="st-head">
      <div class="st-bars" aria-hidden="true">
        {stories.map((s) => <span style={`--dur:${s.dur}s`}><i></i></span>)}
      </div>
      <div class="st-meta">
        <span class="st-avatar" aria-hidden="true"><span>{initials[0]}&amp;{initials[1]}</span></span>
        <span class="st-who"><b>{inv.groom} &amp; {inv.bride}</b><small>{shortDate}</small></span>
        {inv.music && (
          <button class="st-icon" type="button" data-sound aria-label="Включить звук" aria-pressed="false">
            <svg class="i-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4zM17 9l4 6M21 9l-4 6" /></svg>
            <svg class="i-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4zM16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></svg>
          </button>
        )}
        <button class="st-icon" type="button" data-pause aria-label="Пауза" aria-pressed="false">
          <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" /></svg>
          <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l12.5-7.5z" /></svg>
        </button>
        <a class="st-icon" href="/" aria-label="Все темы">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </a>
      </div>
    </header>

    <footer class="st-foot">
      {inv.rsvp && <button type="button" class="st-reply" data-reply>Отправить сообщение…</button>}
      <button type="button" class="st-like" data-like aria-label="Нравится" aria-pressed="false">
        <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20s-7.5-4.6-9.3-9.2C1.4 7.4 3.6 4 7 4c2 0 3.6 1.1 5 3 1.4-1.9 3-3 5-3 3.4 0 5.6 3.4 4.3 6.8C19.5 15.4 12 20 12 20z" /></svg>
      </button>
    </footer>
    <div class="st-hearts" aria-hidden="true"></div>
  </div>

  <button class="st-arrow st-arrow--next" type="button" aria-label="Следующая история" data-next>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
  </button>

  {inv.rsvp && (
    <dialog class="st-sheet" aria-label="Анкета гостя">
      <button class="sheet-close" type="button" aria-label="Закрыть" data-close-rsvp>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
      </button>
      <p class="sheet-title">Анкета гостя</p>
      <RsvpFields />
    </dialog>
  )}
</div>

<script>
  const root = document.querySelector<HTMLElement>('.st');
  if (root) {
    const stories = [...root.querySelectorAll<HTMLElement>('.story')];
    const bars = [...root.querySelectorAll<HTMLElement>('.st-bars > span')];
    const area = root.querySelector<HTMLElement>('.st-stories')!;
    const backdrop = root.querySelector<HTMLImageElement>('.st-backdrop')!;
    const pauseBtn = root.querySelector<HTMLElement>('[data-pause]')!;
    const sheet = root.querySelector<HTMLDialogElement>('.st-sheet');
    let current = 0;
    // причины паузы складываются: удержание пальцем, кнопка, открытая анкета, скрытая вкладка
    const holds = new Set<string>();

    const syncPause = () => {
      root.classList.toggle('paused', holds.size > 0);
      const manual = holds.has('button');
      pauseBtn.setAttribute('aria-pressed', String(manual));
      pauseBtn.setAttribute('aria-label', manual ? 'Продолжить' : 'Пауза');
    };
    const hold = (why: string, on: boolean) => {
      on ? holds.add(why) : holds.delete(why);
      syncPause();
    };

    const show = (next: number) => {
      next = Math.max(0, Math.min(stories.length - 1, next));
      const prev = stories[current];
      prev.classList.remove('is-active');
      prev.inert = true;
      prev.setAttribute('aria-hidden', 'true');
      const el = stories[next];
      el.classList.add('is-active');
      el.inert = false;
      el.removeAttribute('aria-hidden');
      current = next;

      bars.forEach((b, i) => {
        b.classList.toggle('done', i < next);
        b.classList.remove('active');
      });
      void bars[next].offsetWidth; // перезапуск CSS-анимации полоски
      bars[next].classList.add('active');

      if (el.dataset.photo) backdrop.src = el.dataset.photo;
      // соседние фото грузим заранее — иначе lazy-картинка мигает при тапе
      [next + 1, next + 2].forEach((i) => stories[i]?.querySelector('img')?.setAttribute('loading', 'eager'));
    };

    // полоска дошла до конца → следующая история; на последней просто стоим
    bars.forEach((b, i) =>
      b.addEventListener('animationend', () => {
        if (i !== current) return;
        if (current < stories.length - 1) show(current + 1);
        else b.classList.add('done');
      })
    );
    show(0);

    // звук: первый тап — жест пользователя, заодно включаем музыку, если её не выключали вручную
    const audio = document.getElementById('music') as HTMLAudioElement | null;
    const soundBtn = root.querySelector<HTMLElement>('[data-sound]');
    let soundWanted = true;
    const syncSound = () => {
      const on = !!audio && !audio.paused;
      root.classList.toggle('sound-on', on);
      soundBtn?.setAttribute('aria-pressed', String(on));
      soundBtn?.setAttribute('aria-label', on ? 'Выключить звук' : 'Включить звук');
    };
    audio?.addEventListener('play', syncSound);
    audio?.addEventListener('pause', syncSound);
    soundBtn?.addEventListener('click', () => {
      if (!audio) return;
      soundWanted = audio.paused;
      audio.paused ? audio.play().catch(() => {}) : audio.pause();
    });
    const firstGesture = () => {
      root.classList.add('touched');
      if (audio && soundWanted && audio.paused) audio.play().catch(() => {});
    };

    // тап: левая треть — назад, остальное — вперёд; удержание — пауза, как в Instagram
    let downAt = 0;
    let downX = 0;
    let holdTimer = 0;
    area.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      downAt = performance.now();
      downX = e.clientX;
      holdTimer = window.setTimeout(() => {
        hold('finger', true);
        root.classList.add('holding');
      }, 180);
    });
    const release = (e: PointerEvent) => {
      if (!downAt) return;
      clearTimeout(holdTimer);
      const quick = performance.now() - downAt < 250 && Math.abs(e.clientX - downX) < 12;
      downAt = 0;
      hold('finger', false);
      root.classList.remove('holding');
      if (!quick || e.type === 'pointercancel') return;
      firstGesture();
      const r = area.getBoundingClientRect();
      show(e.clientX - r.left < r.width / 3 ? current - 1 : current + 1);
    };
    area.addEventListener('pointerup', release);
    area.addEventListener('pointercancel', release);
    area.addEventListener('contextmenu', (e) => e.preventDefault()); // long-press на iOS/Android

    root.querySelector('[data-prev]')?.addEventListener('click', () => { firstGesture(); show(current - 1); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { firstGesture(); show(current + 1); });
    root.querySelector('[data-replay]')?.addEventListener('click', () => show(0));
    pauseBtn.addEventListener('click', () => hold('button', !holds.has('button')));

    addEventListener('keydown', (e) => {
      if (sheet?.open) return;
      if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === ' ') {
        e.preventDefault();
        hold('button', !holds.has('button'));
      }
    });
    document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));

    // обратный отсчёт в стикере
    const cd = root.querySelector<HTMLElement>('.cd');
    const target = cd ? new Date(cd.dataset.target ?? '').getTime() : NaN;
    if (cd && !Number.isNaN(target)) {
      const u = (k: string) => cd.querySelector(`[data-u="${k}"]`)!;
      const pad = (n: number) => String(n).padStart(2, '0');
      const update = () => {
        const diff = Math.max(0, target - Date.now());
        u('d').textContent = String(Math.floor(diff / 864e5));
        u('h').textContent = pad(Math.floor(diff / 36e5) % 24);
        u('m').textContent = pad(Math.floor(diff / 6e4) % 60);
      };
      update();
      setInterval(update, 10000);
    }

    // анкета: опрос и «Отправить сообщение…» открывают лист, ответ из опроса уже выбран
    const openSheet = (answer?: string, focusNotes = false) => {
      if (!sheet) return;
      if (answer) {
        const radio = sheet.querySelector<HTMLInputElement>(`input[name="attending"][value="${answer}"]`);
        if (radio) radio.checked = true;
      }
      sheet.showModal();
      hold('sheet', true);
      if (focusNotes) sheet.querySelector<HTMLTextAreaElement>('textarea[name="notes"]')?.focus();
    };
    root.querySelectorAll<HTMLElement>('[data-poll]').forEach((b) =>
      b.addEventListener('click', () => {
        b.classList.add('picked');
        openSheet(b.dataset.poll);
      })
    );
    root.querySelector('[data-reply]')?.addEventListener('click', () => openSheet(undefined, true));
    root.querySelector('[data-close-rsvp]')?.addEventListener('click', () => sheet?.close());
    sheet?.addEventListener('click', (e) => { if (e.target === sheet) sheet.close(); });
    sheet?.addEventListener('close', () => hold('sheet', false));

    // лайк: сердечки всплывают над кнопкой
    const likeBtn = root.querySelector<HTMLElement>('[data-like]')!;
    const hearts = root.querySelector<HTMLElement>('.st-hearts')!;
    likeBtn.addEventListener('click', () => {
      const liked = likeBtn.getAttribute('aria-pressed') !== 'true';
      likeBtn.setAttribute('aria-pressed', String(liked));
      if (!liked || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      for (let i = 0; i < 7; i++) {
        const h = document.createElement('i');
        h.style.setProperty('--x', `${(Math.random() - 0.5) * 90}px`);
        h.style.setProperty('--s', String(0.6 + Math.random() * 0.8));
        h.style.animationDelay = `${i * 70}ms`;
        h.addEventListener('animationend', () => h.remove());
        hearts.append(h);
      }
    });
  }
</script>

<style>
  :global(html:has(.st)) { overflow: hidden; overscroll-behavior: none; }
  /* свои кнопки звука и закрытия в шапке сторис */
  :global(body:has(.st) .back-home),
  :global(body:has(.st) #music-btn),
  :global(body:has(.st) .grain) { display: none; }

  .st {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    background: #0d0c0e;
    overflow: hidden;
  }
  /* на десктопе телефон «висит» над размытым текущим фото */
  .st-backdrop {
    position: absolute;
    inset: -40px;
    width: calc(100% + 80px);
    height: calc(100% + 80px);
    object-fit: cover;
    filter: blur(40px) brightness(0.45) saturate(1.2);
    display: none;
  }

  .st-phone {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: #000;
    color: #fff;
    isolation: isolate;
  }
  @media (min-width: 600px) {
    .st-backdrop { display: block; }
    .st-phone {
      --h: min(92svh, 880px);
