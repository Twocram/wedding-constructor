---
import type { CollectionEntry } from 'astro:content';
import RsvpFields from './RsvpFields.astro';

interface Props {
  inv: CollectionEntry<'invitations'>['data'];
}
const { inv } = Astro.props;

// один экран: сцены лежат стопкой, скролл по невидимой ленте шагов переключает активную
type Scene = { key: string; label: string; photo?: string; frame?: number };
const frames = inv.gallery ?? [];
// текстовые сцены чередуются: приглушённое фото / чёрный интертитр, как в немом кино.
// кадры в пуле задом наперёд — чтобы пролог не повторял фото «Кадра 01» сразу за ним
const pool = [...frames].reverse().concat(inv.heroPhoto ?? []);
let poolIdx = 0;
let textIdx = 0;
const nextPhoto = () => (textIdx++ % 2 === 0 && pool.length ? pool[poolIdx++ % pool.length] : undefined);

const scenes: Scene[] = [{ key: 'title', label: 'Титры', photo: inv.heroPhoto ?? pool[0] }];
if (inv.welcome) scenes.push({ key: 'welcome', label: 'Пролог', photo: nextPhoto() });
frames.forEach((photo, i) => scenes.push({ key: 'frame', label: `Кадр ${String(i + 1).padStart(2, '0')}`, photo, frame: i + 1 }));
scenes.push({ key: 'date', label: 'Премьера', photo: nextPhoto() });
if (inv.venue) scenes.push({ key: 'venue', label: 'Локация', photo: nextPhoto() });
if (inv.timeline) scenes.push({ key: 'timeline', label: 'Сценарий', photo: nextPhoto() });
if (inv.dressCode) scenes.push({ key: 'dress', label: 'Костюмы', photo: nextPhoto() });
if (inv.wishes || inv.transfer) scenes.push({ key: 'notes', label: 'Заметки', photo: nextPhoto() });
if (inv.rsvp) scenes.push({ key: 'rsvp', label: 'Кастинг', photo: nextPhoto() });
scenes.push({ key: 'credits', label: 'Финал', photo: nextPhoto() });

const total = String(scenes.length).padStart(2, '0');
const time = inv.countdown?.slice(11, 16);
const routeUrl = inv.venue && `https://yandex.ru/maps/?text=${encodeURIComponent(`${inv.venue.name}, ${inv.venue.address}`)}`;
---

<div class="cine" data-dir="fwd">
  <div class="cine-stage">
    {scenes.map((s, i) => (
      <section
        class:list={['scene', `scene--${s.key}`, { 'is-active': i === 0 }]}
        data-label={s.label}
        inert={i !== 0}
        aria-hidden={i !== 0 ? 'true' : undefined}
      >
        <div class:list={['scene-photo', { 'scene-photo--card': !s.photo }]}>
          {s.photo && <img src={s.photo} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />}
        </div>

        <div class="scene-body">
          {s.key === 'title' && (
            <>
              <p class="kicker rv" style="--d:0">{[inv.city, inv.date].filter(Boolean).join(' · ')}</p>
              <h1 class="names">
                <span class="ln"><span>{inv.groom}</span></span>
                <span class="ln amp"><span>&amp;</span></span>
                <span class="ln"><span>{inv.bride}</span></span>
              </h1>
              <p class="subtitle rv" style="--d:4">приглашают вас на премьеру своей истории</p>
              <button class="cine-hint rv" style="--d:6" type="button" data-go="1">
                листайте, чтобы начать
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" /></svg>
              </button>
            </>
          )}

          {s.key === 'welcome' && (
            <div class="subs">
              <p class="kicker rv" style="--d:0">Дорогие гости</p>
              <p class="subs-line rv" style="--d:1">— {inv.welcome}</p>
            </div>
          )}

          {s.key === 'frame' && (
            <p class="frame-cap rv" style="--d:1">
              <span>Кадр {String(s.frame).padStart(2, '0')}</span>
              <span class="frame-rule" aria-hidden="true"></span>
              <span>{String(frames.length).padStart(2, '0')}</span>
            </p>
          )}

          {s.key === 'date' && (
            <div class="center">
              <p class="kicker rv" style="--d:0">Дата премьеры</p>
              <h2 class="big"><span class="ln"><span>{inv.date}</span></span></h2>
              {time && <p class="subtitle rv" style="--d:3">начало в {time}</p>}
              {inv.countdown && (
                <div class="cd rv" style="--d:4" data-target={inv.countdown}>
                  <div><b data-u="d">–</b><small>дней</small></div>
                  <div><b data-u="h">–</b><small>часов</small></div>
                  <div><b data-u="m">–</b><small>минут</small></div>
                  <div><b data-u="s">–</b><small>секунд</small></div>
                </div>
              )}
            </div>
          )}

          {s.key === 'venue' && inv.venue && (
            <div class="center">
              <p class="kicker rv" style="--d:0">Место съёмок</p>
              <h2 class="big"><span class="ln"><span>{inv.venue.name}</span></span></h2>
              <p class="subtitle rv" style="--d:3">{inv.venue.address}</p>
              <a class="cine-btn rv" style="--d:4" href={routeUrl} target="_blank" rel="noopener">
                Построить маршрут
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6" /></svg>
              </a>
            </div>
          )}

          {s.key === 'timeline' && inv.timeline && (
            <div class="sheet">
              <p class="kicker rv" style="--d:0">Сценарий дня</p>
              <ol class="script">
                {inv.timeline.map((t, j) => (
                  <li class="rv" style={`--d:${j + 1}`}>
                    <time>{t.time}</time>
                    <div>
                      <strong>{t.title}</strong>
                      {t.text && <span>{t.text}</span>}
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {s.key === 'dress' && inv.dressCode && (
            <div class="center">
              <p class="kicker rv" style="--d:0">Костюмы</p>
              <p class="subs-line rv" style="--d:1">{inv.dressCode.text}</p>
              {inv.dressCode.colors && (
                <ul class="swatches">
                  {inv.dressCode.colors.map((c, j) => <li class="rv" style={`--d:${j + 2}; background:${c}`}></li>)}
                </ul>
              )}
            </div>
          )}

          {s.key === 'notes' && (
            <div class="sheet">
              <p class="kicker rv" style="--d:0">Заметки режиссёра</p>
              <ul class="notes">
                {inv.wishes?.map((w, j) => <li class="rv" style={`--d:${j + 1}`}>{w}</li>)}
                {inv.transfer && <li class="rv" style={`--d:${(inv.wishes?.length ?? 0) + 1}`}>{inv.transfer}</li>}
              </ul>
            </div>
          )}

          {s.key === 'rsvp' && inv.rsvp && (
            <div class="center">
              <p class="kicker rv" style="--d:0">Кастинг гостей</p>
              <h2 class="big"><span class="ln"><span>Будете с нами?</span></span></h2>
              <p class="subtitle rv" style="--d:3">ответьте, пожалуйста, до {inv.rsvp.deadline}</p>
              <button class="cine-btn cine-btn--solid rv" style="--d:4" type="button" data-open-rsvp>
                Ответить
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
              </button>
            </div>
          )}

          {s.key === 'credits' && (
            <div class="credits">
              <p class="rv" style="--d:0"><small>В главных ролях</small>{inv.groom}<br />{inv.bride}</p>
              {inv.organizer && (
                <p class="rv" style="--d:1">
                  <small>Продюсер</small>{inv.organizer.name}<br />
                  <a href={`tel:${inv.organizer.phone.replace(/[^\d+]/g, '')}`}>{inv.organizer.phone}</a>
                </p>
              )}
              {inv.telegramChat && (
                <p class="rv" style="--d:2"><small>Чат гостей</small><a href={inv.telegramChat.url} target="_blank" rel="noopener">{inv.telegramChat.text}</a></p>
              )}
              <h2 class="big fin"><span class="ln"><span>Продолжение следует</span></span></h2>
            </div>
          )}
        </div>
      </section>
    ))}

    <div class="bar bar--top" aria-hidden="true">
      <span class="hud-scene">Сцена <b data-hud-num>01</b> / {total}</span>
    </div>
    <div class="bar bar--bottom" aria-hidden="true">
      <span class="hud-label" data-hud-label>{scenes[0].label}</span>
      <span class="hud-tc"><i class="rec"></i><span data-tc>00:00:00:00</span></span>
      <span class="hud-progress"><span data-progress></span></span>
    </div>
  </div>

  {/* невидимая лента: по шагу на сцену — даёт нативный скролл, снап и клавиатуру */}
  <div class="cine-track" aria-hidden="true">
    {scenes.map(() => <div class="cine-step"></div>)}
  </div>

  {inv.rsvp && (
    <dialog class="cine-sheet" aria-label="Анкета гостя">
      <button class="sheet-close" type="button" aria-label="Закрыть" data-close-rsvp>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" /></svg>
      </button>
      <p class="kicker">Анкета гостя</p>
      <RsvpFields />
    </dialog>
  )}
</div>

<script>
  const root = document.querySelector<HTMLElement>('.cine');
  if (root) {
    const scenes = [...root.querySelectorAll<HTMLElement>('.scene')];
    const steps = [...root.querySelectorAll<HTMLElement>('.cine-step')];
    const hudNum = root.querySelector('[data-hud-num]')!;
    const hudLabel = root.querySelector('[data-hud-label]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    let current = 0;
    const leaveTimers = new Map<HTMLElement, number>();

    const show = (next: number) => {
      if (next === current) return;
      root.dataset.dir = next > current ? 'fwd' : 'back';
      const prev = scenes[current];
      // уходящая сцена остаётся под новой, пока та не «вытрет» её шторкой
      scenes.forEach((s) => {
        if (s !== prev) s.classList.remove('is-leaving');
      });
      prev.classList.remove('is-active');
      prev.classList.add('is-leaving');
      prev.inert = true;
      prev.setAttribute('aria-hidden', 'true');
      clearTimeout(leaveTimers.get(prev));
      leaveTimers.set(prev, window.setTimeout(() => prev.classList.remove('is-leaving'), 1100));

      const el = scenes[next];
      el.classList.remove('is-leaving');
      el.classList.add('is-active');
      el.inert = false;
      el.removeAttribute('aria-hidden');
      current = next;
      hudNum.textContent = String(next + 1).padStart(2, '0');
      hudLabel.textContent = el.dataset.label ?? '';
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const h = steps[0].offsetHeight;
        const max = document.documentElement.scrollHeight - innerHeight;
        progress.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
        show(Math.max(0, Math.min(scenes.length - 1, Math.round(scrollY / h))));
      });
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();

    root.querySelectorAll<HTMLElement>('[data-go]').forEach((b) =>
      b.addEventListener('click', () => steps[Number(b.dataset.go)]?.scrollIntoView({ behavior: 'smooth' }))
    );

    // таймкод 24 fps с момента открытия — «идёт запись»
    const tc = root.querySelector('[data-tc]')!;
    const t0 = performance.now();
    const pad = (n: number) => String(n).padStart(2, '0');
    let lastFrame = -1;
    const tick = (now: number) => {
      const f = Math.floor(((now - t0) / 1000) * 24);
      if (f !== lastFrame) {
        lastFrame = f;
        const s = Math.floor(f / 24);
        tc.textContent = `${pad(Math.floor(s / 3600))}:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}:${pad(f % 24)}`;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    // обратный отсчёт в сцене «Премьера»
    const cd = root.querySelector<HTMLElement>('.cd');
    const target = cd ? new Date(cd.dataset.target ?? '').getTime() : NaN;
    if (cd && !Number.isNaN(target)) {
      const u = (k: string) => cd.querySelector(`[data-u="${k}"]`)!;
      const cells = { d: u('d'), h: u('h'), m: u('m'), s: u('s') };
      const update = () => {
        const diff = Math.max(0, target - Date.now());
        cells.d.textContent = String(Math.floor(diff / 864e5));
        cells.h.textContent = pad(Math.floor(diff / 36e5) % 24);
        cells.m.textContent = pad(Math.floor(diff / 6e4) % 60);
        cells.s.textContent = pad(Math.floor(diff / 1e3) % 60);
      };
      update();
      setInterval(update, 1000);
    }

    // анкета — в модальном листе: форма не влезает в сцену на телефоне
    const sheet = root.querySelector<HTMLDialogElement>('.cine-sheet');
    root.querySelector('[data-open-rsvp]')?.addEventListener('click', () => sheet?.showModal());
    root.querySelector('[data-close-rsvp]')?.addEventListener('click', () => sheet?.close());
    sheet?.addEventListener('click', (e) => {
      if (e.target === sheet) sheet.close();
    });
  }
</script>

<style>
  /* снап по шагам: один свайп — одна сцена */
  :global(html:has(.cine)) {
    scroll-snap-type: y mandatory;
    scroll-behavior: auto;
  }
  :global(html:has(.cine-sheet[open])) { overflow: hidden; }

  .cine-step {
    height: 100svh;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* высоты полос — на body, чтобы по ним же выравнивались fixed-кнопки «все темы» и музыки */
  :global(body:has(.cine)) {
    --bar-h: 56px;
    --bar-bh: 76px;
    --bar: calc(var(--bar-h) + env(safe-area-inset-top));
    --bar-b: calc(var(--bar-bh) + env(safe-area-inset-bottom));
    --music: 52px;
  }
  :global(body:has(.cine) .back-home) {
    /* +12px компенсирует margin:-12px тап-зоны */
    top: calc(env(safe-area-inset-top) + var(--bar-h) / 2 + 12px);
    transform: translateY(-50%);
    font-family: var(--font-label);
    font-size: 0.62rem;
    line-height: 1;
    letter-spacing: 0.24em;
  }
  :global(body:has(.cine) #music-btn) {
    left: 20px;
    bottom: calc(env(safe-area-inset-bottom) + (var(--bar-bh) - var(--music)) / 2);
  }

  .cine-stage {
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--bg);
  }

  /* ── сцена ── */
  .scene {
    position: absolute;
    inset: 0;
    visibility: hidden;
    z-index: 0;
  }
  .scene.is-active { visibility: visible; z-index: 2; }
  .scene.is-leaving { visibility: visible; z-index: 1; }

  .scene-photo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(100% 0 0 0);
  }
  .cine[data-dir='back'] .scene-photo { clip-path: inset(0 0 100% 0); }
  .scene.is-active .scene-photo {
    clip-path: inset(0);
    transition: clip-path 1s cubic-bezier(0.7, 0, 0.2, 1);
  }
  .scene.is-leaving .scene-photo { clip-path: inset(0); }
  .scene-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.18);
  }
  /* медленный наезд камеры, пока сцена на экране */
  .scene.is-active .scene-photo img {
    transform: scale(1.02);
    transition: transform 7s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .scene.is-leaving .scene-photo img { transform: scale(1.02); }
  /* затемнение: у текстовых сцен сильное, у кадров — только снизу под подпись */
  .scene-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(11, 10, 9, 0.55), transparent 30%, transparent 55%, rgba(11, 10, 9, 0.85)),
      rgba(11, 10, 9, 0.6);
    transition: background-color 1s;
  }
  .scene--title .scene-photo::after {
    background: linear-gradient(to bottom, rgba(11, 10, 9, 0.5), rgba(11, 10, 9, 0.15) 35%, rgba(11, 10, 9, 0.85));
  }
  .scene--frame .scene-photo::after {
    background: linear-gradient(to bottom, rgba(11, 10, 9, 0.35), transparent 25%, transparent 70%, rgba(11, 10, 9, 0.7));
  }
  .scene.is-leaving .scene-photo::after { background-color: rgba(11, 10, 9, 0.8); }
  /* интертитр: чёрная карточка с виньеткой и тонкой двойной рамкой */
  .scene-photo--card { background: radial-gradient(ellipse at center, #1a1714, var(--bg) 70%); }
  .scene-photo--card::after {
    inset: calc(var(--bar) + 18px) 18px calc(var(--bar-b) + 18px);
    background: none;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    outline: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    outline-offset: 5px;
  }
  .scene.is-leaving .scene-photo--card::after { background-color: transparent; }

  .scene-body {
    position: absolute;
    inset: var(--bar) 0 var(--bar-b);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 18px;
    padding: 24px max(24px, env(safe-area-inset-left));
    text-align: center;
    color: var(--text);
  }
  .scene.is-leaving .scene-body { opacity: 0; transition: opacity 0.3s; }

  /* ── появление текста ── */
  .rv {
    opacity: 0;
    transform: translateY(18px);
  }
  .scene.is-active .rv {
    opacity: 1;
    transform: none;
    transition: opacity 0.8s var(--ease-out), transform 0.8s var(--ease-out);
    transition-delay: calc(0.45s + var(--d, 0) * 0.09s);
  }
  /* заголовки выезжают из-под маски построчно */
  .ln { display: block; overflow: hidden; padding-bottom: 0.06em; }
  .ln > span { display: block; transform: translateY(110%); }
  .scene.is-active .ln > span {
    transform: none;
    transition: transform 1s cubic-bezier(0.2, 0.8, 0.2, 1);
    transition-delay: 0.5s;
  }
  .scene.is-active .ln:nth-child(2) > span { transition-delay: 0.62s; }
  .scene.is-active .ln:nth-child(3) > span { transition-delay: 0.74s; }

  /* ── типографика ── */
  .kicker {
    font-family: var(--font-label);
    font-size: 0.68rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .names {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.4rem, 17vw, 7.5rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .names .amp {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 300;
    text-transform: none;
    font-size: 0.6em;
    line-height: 1.1;
    color: var(--accent-2);
  }
  .big {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.3rem, 11vw, 4.6rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    max-width: 14ch;
  }
  .subtitle {
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.25rem, 5vw, 1.6rem);
    line-height: 1.3;
    color: var(--text-2);
    max-width: 28ch;
  }
  .scene--title .scene-body { align-content: end; padding-bottom: 20px; }

  /* субтитры: жёлтоватые, как в кино, снизу кадра */
  .subs { align-self: end; display: grid; gap: 14px; justify-items: center; }
  .scene--welcome .scene-body { align-content: end; }
  .subs-line {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: clamp(1.35rem, 5.4vw, 1.9rem);
    line-height: 1.35;
    max-width: 30ch;
    color: #f6e7c2;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.6);
  }

  .cine-hint {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: none;
    border: 0;
    color: var(--muted);
    font: 400 0.66rem/1 var(--font-label);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cine-hint svg { width: 14px; height: 14px; animation: nudge 2s var(--ease-out) infinite; }
  @keyframes nudge { 0%, 100% { transform: none; } 50% { transform: translateY(4px); } }

  .frame-cap {
    align-self: end;
    justify-self: stretch;
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .frame-rule { flex: 1; height: 1px; background: var(--line-strong); }
  .scene--frame .scene-body { align-content: end; }

  .center { display: grid; gap: 18px; justify-items: center; }

  .cd {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: clamp(16px, 5vw, 36px);
    margin-top: 10px;
    font-family: var(--font-label);
  }
  .cd div { display: grid; gap: 4px; }
  .cd b {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.8rem, 8vw, 2.6rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .cd small { font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }

  .cine-btn {
    margin-top: 8px;
