[Unit]
Description=saywed API (заявки, админка)
After=network.target

[Service]
Type=simple
User=saywed
Group=saywed
WorkingDirectory=/opt/saywed-api
EnvironmentFile=/etc/saywed/api.env
# собранный bun build --compile: рантайм внутри файла
ExecStart=/opt/saywed-api/saywed-api
Restart=on-failure
RestartSec=3

# процесс видит только свою базу и код
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/saywed

[Install]
WantedBy=multi-user.target
