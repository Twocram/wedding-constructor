---
import Section from './Section.astro';
interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<Section eyebrow="Детали" title="Несколько пожеланий" narrow>
  <ol class="wishes">
    {items.map((w, i) => (
      <li class="fade-up" style={`--i:${i + 1}`}>
        <span class="wish-num">{String(i + 1).padStart(2, '0')}</span>
        <p>{w}</p>
      </li>
    ))}
  </ol>
</Section>

<style>
  .wishes { list-style: none; padding: 0; text-align: left; display: grid; }
  .wishes li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 16px;
    align-items: start;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }
  .wishes li:last-child { border-bottom: 1px solid var(--line); }
  .wish-num {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    color: var(--accent);
    letter-spacing: 0.02em;
    padding-top: 4px;
  }
  .wishes p { font-size: 1rem; }
  :global(body[data-theme='editorial']) .wish-num { font-style: italic; font-weight: 300; font-size: 2.4rem; }
  :global(body[data-theme='amalfi']) .wish-num { font-size: 1.5rem; font-family: var(--font-label); padding-top: 8px; }
</style>
